# Copy to .env.prod.local on the server (never committed) and fill in.
# Domain pointing to the server; the HTTPS certificate is requested for it.
SERVER_NAME=mnemo.example.com
# openssl rand -hex 32
APP_SECRET=
# openssl rand -hex 24
POSTGRES_PASSWORD=
# docker compose -f docker/compose.prod.yaml run --rm --no-deps php bin/console security:hash-password
# Double every "$" of the hash ("$$") so that Compose does not read it as a variable.
APP_ADMIN_PASSWORD_HASH=
OPENROUTER_API_KEY=
# Tokens the connectors may read, and their values
MCP_CONNECTORS_ENV=GITHUB_TOKEN,GITLAB_TOKEN
GITHUB_TOKEN=
GITLAB_TOKEN=
# Emails that become super admin at their first OAuth sign-in (comma-separated); the others wait for approval.
APP_ADMIN_EMAILS=
# Sign-in providers. Callback URL to declare at each one: https://<SERVER_NAME>/oauth/<github|gitlab|google>/check
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITLAB_CLIENT_ID=
OAUTH_GITLAB_CLIENT_SECRET=
OAUTH_GITLAB_URL=https://gitlab.com
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
