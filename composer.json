{
    "type": "project",
    "license": "MIT",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.4.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.8",
        "league/commonmark": "*",
        "nyholm/psr7": "^1.8",
        "quentinrogeret34/ai-observability-bundle": "dev-main",
        "quentinrogeret34/ai-steering-bundle": "dev-main",
        "symfony/ai-agent": "^1.0",
        "symfony/ai-bundle": "^1.0",
        "symfony/ai-open-router-platform": "^1.0",
        "symfony/ai-postgres-store": "^1.0",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/finder": "8.1.*",
        "symfony/flex": "^2",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/mcp-bundle": "^1.0",
        "symfony/messenger": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/process": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/scheduler": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/security-csrf": "8.1.*",
        "symfony/stimulus-bundle": "^3.8",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-dropzone": ">=3.8",
        "symfony/ux-icons": "^3.8.1",
        "symfony/ux-live-component": "^3.8.1",
        "symfony/ux-translator": "^3.8",
        "symfony/ux-twig-component": "^3.8",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": ">=3.31",
        "twig/intl-extra": "^3.31",
        "twig/markdown-extra": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3.7",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4.8",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/maker-bundle": "^1.68"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "repositories": [{
        "name": "ai-steering-bundle",
        "type": "vcs",
        "url": "https://github.com/quentinRogeret34/ai-steering-bundle"
    },{
        "name": "ai-observability-bundle",
        "type": "vcs",
        "url": "https://github.com/quentinRogeret34/ai-observability-bundle"
    }]
}
