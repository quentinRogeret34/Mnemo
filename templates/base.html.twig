<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        {{ include('_head_common.html.twig') }}
        <title>{% block title %}{{ 'nav.projects'|trans }}{% endblock %} · {{ 'app.name'|trans }}</title>
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.debug ? app.request.server.get('FRANKENPHP_HOT_RELOAD') : null %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body data-controller="search-hotkey busy" data-search-hotkey-url-value="{{ (project ?? null) ? path('project_code', {slug: project.slug}) : '' }}" data-action="keydown@window->search-hotkey#handle submit@window->busy#mark pageshow@window->busy#reset">
        <a class="visually-hidden skip-link" href="#main-content">{{ 'layout.skip_to_content'|trans }}</a>
        <div class="app" data-controller="sidebar" data-sidebar-collapse-label-value="{{ 'nav.collapse'|trans }}" data-sidebar-expand-label-value="{{ 'nav.expand'|trans }}" data-action="keydown.esc@window->sidebar#close">
            <twig:Sidebar :project="project ?? null" />
            <div class="sidebar-backdrop" data-sidebar-target="backdrop" data-action="click->sidebar#close" hidden></div>
            <div class="main">
                <header class="header">
                    <button class="button button--ghost header__menu" type="button" aria-controls="app-sidebar" aria-expanded="false" aria-label="{{ 'nav.expand'|trans }}" data-sidebar-target="opener" data-action="sidebar#open">
                        <twig:ux:icon name="lucide:panel-left-open" />
                    </button>
                    <nav class="crumbs" aria-label="{{ 'layout.breadcrumbs'|trans }}">{% block crumbs %}{% endblock %}</nav>
                    <div class="header__actions">
                        {% block header_actions %}{% endblock %}
                        {% set help = {
                            dashboard: 'tableau-de-bord', project_index: 'projets', project_show: 'documents', document_index: 'documents', document_show: 'documents',
                            rule_index: 'regles', rule_show: 'regles', question_index: 'regles', project_questions: 'regles', alignment_index: 'regles', project_alignment: 'regles', memory_index: 'memoires', memory_show: 'memoires', memory_graph: 'graphe-memoires',
                            proposal_index: 'a-valider', garden_show: 'jardinage', project_code: 'code', file_show: 'code',
                            chat: 'assistant', project_chat: 'assistant', project_briefing: 'activite', agent_asset_index: 'fichiers-agents', agent_asset_new: 'fichiers-agents', agent_asset_edit: 'fichiers-agents',
                            connector_index: 'connexions', connector_show: 'connexions', connector_new: 'connexions', connector_edit: 'connexions',
                            api_key_index: 'cles-api', llm_settings: 'modeles-ia', appearance: 'apparence', admin_users: 'utilisateurs', activity: 'activite', activity_feed: 'activite',
                        }[app.request.attributes.get('_route')] ?? null %}
                        <button class="button button--ghost palette-trigger" type="button" data-action="search-hotkey#palette" aria-keyshortcuts="Meta+K Control+K"><twig:ux:icon name="lucide:search" /><span class="header__label">{{ 'layout.search'|trans }}</span> <kbd class="kbd" aria-hidden="true">⌘K</kbd></button>
                        {% if help %}<a class="button button--ghost header__help" href="{{ path('wiki') }}#{{ help }}" title="{{ 'layout.help_title'|trans }}"><twig:ux:icon name="lucide:book-open" class="icon header__help-icon" /><span class="header__label">{{ 'layout.help'|trans }}</span></a>{% endif %}
                        <button class="button button--ghost theme-toggle" type="button" data-controller="theme" data-action="theme#toggle">
                            <span class="theme-toggle__option theme-toggle__option--dark"><twig:ux:icon name="lucide:moon" /><span class="visually-hidden">{{ 'layout.theme_dark'|trans }}</span></span>
                            <span class="theme-toggle__option theme-toggle__option--light"><twig:ux:icon name="lucide:sun" /><span class="visually-hidden">{{ 'layout.theme_light'|trans }}</span></span>
                        </button>
                    </div>
                </header>
                <main class="content" id="main-content" tabindex="-1">
                    {% block body %}{% endblock %}
                </main>
            </div>
        </div>
        {{ include('_toasts.html.twig') }}
        {{ include('_dialogs.html.twig') }}
        <twig:ProjectDialog :form="project_form ?? null" />
        <twig:Palette :project="project ?? null" />
    </body>
</html>
