{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.dashboard'|trans }}{{ project ? ' · ' ~ project.name }}{% endblock %}

{% block crumbs %}
    {% if project %}
        <a href="{{ path('project_show', {slug: project.slug}) }}">{{ project.name }}</a>
        <span class="crumbs__sep" aria-hidden="true">/</span>
    {% endif %}
    <span class="crumbs__current">{{ 'nav.dashboard'|trans }}</span>
{% endblock %}

{% block body %}
    {% set scope = project ? {project: project.slug} : {} %}
    {% set period_labels = {'24h': 'period.24h', '7d': 'period.7d', '30d': 'period.30d', '90d': 'period.90d', 'all': 'period.all'} %}
    {% set period_text = ('dashboard.period.' ~ period)|trans %}
    {% set type_labels = {decision: 'enum.memory_type.decision', convention: 'enum.memory_type.convention', task_learning: 'enum.memory_type.task_learning', preference: 'enum.memory_type.preference', fact: 'enum.memory_type.fact'} %}
    {% set search_labels = {memory: 'nav.memories', document: 'nav.documents', business_rule: 'nav.rules', code_file: 'nav.code'} %}
    {% set pref_query = scope|merge({period: period}) %}
    {% set prefs_token = csrf_token('dashboard-prefs') %}
    {% set is_business_role = role.value == 'business' %}

    <div class="view-head">
        <h1><twig:ux:icon name="lucide:layout-dashboard" />{{ 'nav.dashboard'|trans }}</h1>
        <span class="view-head__meta">{{ project ? project.name : 'nav.all_projects'|trans }}</span>
        <div class="dash-role-bar" role="group" aria-label="{{ 'dashboard.role.label'|trans }}">
            <form class="dash-role-form" method="post" action="{{ path('dashboard_preferences', pref_query) }}">
                <input type="hidden" name="_token" value="{{ prefs_token }}">
                <input type="hidden" name="mode" value="role">
                {% for item in roles %}
                    <button
                        type="submit"
                        name="role"
                        value="{{ item.value }}"
                        class="dash-role-btn{{ role == item ? ' is-active' }}"
                        aria-pressed="{{ role == item ? 'true' : 'false' }}"
                    >{{ item|trans }}</button>
                {% endfor %}
            </form>
            <button class="button button--ghost dash-customize-btn" type="button" commandfor="dashboard-customize" command="show-modal">
                <twig:ux:icon name="lucide:sliders-horizontal" />
                <span>{{ 'dashboard.customize'|trans }}</span>
                {% if custom_widgets %}<span class="dash-customize-dot" aria-hidden="true"></span>{% endif %}
            </button>
        </div>
    </div>

    <div class="filter-bar">
        <nav class="tabs" aria-label="{{ 'period.label'|trans }}">
            {% for item in periods %}
                <a href="{{ path('dashboard', scope|merge({period: item})) }}" {% if item == period %}aria-current="page"{% endif %}>{{ period_labels[item]|trans }}</a>
            {% endfor %}
        </nav>
        <a class="button" href="{{ path('dashboard', scope|merge({period: period})) }}"><twig:ux:icon name="lucide:refresh-cw" />{{ 'dashboard.refresh'|trans }}</a>
    </div>

    {% set delta_label = previous ? 'dashboard.vs_previous'|trans : period_text %}
    {% set stored_base = summary.memories - summary.memories_added %}
    {% set kinds_order = ['learning', 'rule_draft', 'skill_update', 'duplicate', 'contradiction', 'refuted'] %}
    {% set pending_total = pending_kinds|reduce((sum, row) => sum + row.value, 0) %}
    {% set attention_count = summary.pending + failing_connectors|length + (refuted > 0 ? 1 : 0) %}
    {% set has_aside = 'attention' in widgets or 'ai_quality' in widgets or 'timeline' in widgets %}

    <div class="dash{{ not has_aside ? ' dash--full' }}">
        <div class="dash__main">
            <section class="kpis" aria-label="{{ 'dashboard.key_figures'|trans }}">
                {% if is_business_role %}
                    <div class="kpi">
                        <span class="kpi__label">{{ ux_icon('lucide:scale') }}{{ 'dashboard.business.rules'|trans }}</span>
                        <span class="kpi__value">{{ business.rules_total|format_number }}</span>
                        <div class="kpi__foot">
                            <span class="kpi__delta"><span>{{ 'dashboard.business.rules_sub'|trans({validated: business.rules_validated, to_review: business.rules_to_review}) }}</span></span>
                        </div>
                    </div>
                    <div class="kpi">
                        <span class="kpi__label">{{ ux_icon('lucide:triangle-alert') }}{{ 'dashboard.business.shadow_open'|trans }}</span>
                        <span class="kpi__value">{{ business.shadow_open|format_number }}</span>
                        <div class="kpi__foot">
                            <span class="kpi__delta"><span>{{ 'dashboard.business.shadow_blockers'|trans({count: business.shadow_blockers}) }}</span></span>
                        </div>
                    </div>
                    <div class="kpi">
                        <span class="kpi__label">{{ ux_icon('lucide:file-text') }}{{ 'nav.documents'|trans }}</span>
                        <span class="kpi__value">{{ business.documents_total|format_number }}</span>
                        <div class="kpi__foot">
                            <span class="kpi__delta"><span>+{{ business.documents_added }} {{ period_text }}</span></span>
                        </div>
                    </div>
                {% else %}
                    {% for kpi in [
                        {label: 'dashboard.stored'|trans, icon: 'lucide:brain', value: summary.memories, current: summary.memories_added, base: stored_base, series: memories, sub: '+' ~ summary.memories_added ~ ' ' ~ period_text, title: null},
                        {label: 'dashboard.recalled'|trans, icon: 'lucide:rotate-ccw', value: summary.recalled, current: summary.recalled, base: previous ? previous.recalled : null, series: recalls, sub: 'dashboard.lookups'|trans({count: summary.lookups}), title: 'dashboard.recalled_title'|trans},
                        {label: 'dashboard.requests'|trans, icon: 'lucide:activity', value: summary.requests, current: summary.requests, base: previous ? previous.requests : null, series: requests, sub: 'dashboard.failed'|trans({count: summary.failed}), title: null},
                    ] %}
                        {% set spark = kpi.series|slice(-14) %}
                        {% set spark_top = spark|reduce((max, point) => max(max, point.value), 0) %}
                        <div class="kpi">
                            <span class="kpi__label" {% if kpi.title %}title="{{ kpi.title }}"{% endif %}>{{ ux_icon(kpi.icon) }}{{ kpi.label }}</span>
                            <span class="kpi__value">{{ kpi.value|format_number }}</span>
                            <div class="kpi__foot">
                                <span class="kpi__delta">
                                    {% if kpi.base is not null and kpi.base > 0 %}
                                        {% set change = loop.first ? kpi.current / kpi.base * 100 : (kpi.current - kpi.base) / kpi.base * 100 %}
                                        <span class="delta delta--{{ change >= 0 ? 'up' : 'down' }}">{{ change >= 0 ? '+' }}{{ change|format_number({fraction_digit: 1}) }} %</span>
                                        <span>{{ loop.first ? period_text : delta_label }}</span>
                                    {% else %}
                                        <span>{{ kpi.sub }}</span>
                                    {% endif %}
                                </span>
                                <span class="spark" aria-hidden="true">
                                    {% for point in spark %}
                                        <span class="spark__bar{{ loop.last ? ' spark__bar--last' }}" style="height: {{ spark_top > 0 ? max(8, (point.value / spark_top * 100)|round) : 8 }}%"></span>
                                    {% endfor %}
                                </span>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
                <a class="kpi kpi--link" href="{{ path('proposal_index', scope) }}">
                    <span class="kpi__label">{{ ux_icon('lucide:inbox') }}{{ 'nav.to_review'|trans }}</span>
                    <span class="kpi__value">{{ summary.pending|format_number }}</span>
                    <div class="kpi__foot kpi__foot--stack">
                        <span class="segments" aria-hidden="true">
                            {% for kind in kinds_order %}
                                {% set row = pending_kinds|filter(row => row.label == kind)|first %}
                                {% if row %}<span class="segments__part segments__part--{{ kind }}" style="flex-grow: {{ row.value }}"></span>{% endif %}
                            {% endfor %}
                            {% if pending_total == 0 %}<span class="segments__part" style="flex-grow: 1"></span>{% endif %}
                        </span>
                        <span class="kpi__delta"><span>{{ 'dashboard.pending'|trans({count: summary.pending}) }}</span></span>
                    </div>
                </a>
            </section>

            <div class="panels panels--dash">
                {% if 'business_overview' in widgets %}
                    <section class="panel panel--span" aria-labelledby="panel-business-overview">
                        <div class="panel__head">
                            <div>
                                <h2 id="panel-business-overview">{{ 'dashboard.widget.business_overview'|trans }}</h2>
                                <span class="row__sub">{{ 'dashboard.widget.business_overview_desc'|trans }}</span>
                            </div>
                            {% if business.alignment_score is not null %}
                                <span class="alignment-score num">{{ business.alignment_score }} %</span>
                            {% endif %}
                        </div>
                        {% if business.rules_total == 0 %}
                            <p class="block__empty">{{ 'dashboard.business.no_rules'|trans }}</p>
                        {% else %}
                            {% set linked_rules = business.rules_total - business.rules_without_code %}
                            <ul class="bars">
                                <li class="bars__row">
                                    <span class="bars__label">{{ 'dashboard.business.validated_rules'|trans }}</span>
                                    <span class="bars__value num">{{ business.rules_validated }} / {{ business.rules_total }}</span>
                                    <span class="bars__track"><span class="bars__fill bars__fill--top" style="width: {{ (business.rules_validated / business.rules_total * 100)|round(1) }}%"></span></span>
                                </li>
                                <li class="bars__row">
                                    <span class="bars__label">{{ 'dashboard.business.linked_code'|trans }}</span>
                                    <span class="bars__value num">{{ linked_rules }} / {{ business.rules_total }}</span>
                                    <span class="bars__track"><span class="bars__fill" style="width: {{ (linked_rules / business.rules_total * 100)|round(1) }}%"></span></span>
                                </li>
                            </ul>
                            {% if project %}
                                <div class="panel__foot">
                                    <a class="link" href="{{ path('rule_index', {slug: project.slug}) }}">{{ 'dashboard.business.see_rules'|trans }}</a>
                                </div>
                            {% endif %}
                        {% endif %}
                    </section>
                {% endif %}

                {% if 'shadow_questions' in widgets %}
                    <section class="panel panel--span" aria-labelledby="panel-shadow-questions">
                        <div class="panel__head">
                            <div>
                                <h2 id="panel-shadow-questions">{{ 'dashboard.widget.shadow_questions'|trans }}</h2>
                                <span class="row__sub">{{ 'dashboard.widget.shadow_questions_desc'|trans }}</span>
                            </div>
                            <span class="block__count num">{{ business.shadow_open }}</span>
                        </div>
                        {% if shadow_questions is empty %}
                            <p class="block__empty">{{ 'dashboard.business.no_shadow'|trans }}</p>
                        {% else %}
                            <ul class="shadow-list">
                                {% for item in shadow_questions %}
                                    <li class="shadow-list__item">
                                        <span class="pill pill--{{ item.severity == 'blocker' ? 'danger' : (item.severity == 'major' ? 'warning' : 'neutral') }}">{{ item.severity }}</span>
                                        <div class="shadow-list__body">
                                            <a class="shadow-list__question" href="{{ path('rule_show', {slug: item.project_slug, code: item.rule_code}) }}#shadow-title">
                                                {{ item.question ?: item.gap }}
                                            </a>
                                            <span class="row__sub">
                                                <span class="mono">{{ item.rule_code }}</span> · {{ item.rule_title }}{% if not project %} · {{ item.project_name }}{% endif %}
                                            </span>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                        <div class="panel__foot">
                            <a class="link" href="{{ project ? path('project_questions', {slug: project.slug}) : path('question_index') }}">{{ 'dashboard.business.see_questions'|trans }}</a>
                        </div>
                    </section>
                {% endif %}

                {% if 'recent_documents' in widgets %}
                    <section class="panel panel--wide" aria-labelledby="panel-recent-documents">
                        <div class="panel__head">
                            <div>
                                <h2 id="panel-recent-documents">{{ 'dashboard.widget.recent_documents'|trans }}</h2>
                                <span class="row__sub">{{ 'dashboard.widget.recent_documents_desc'|trans }}</span>
                            </div>
                            {% if project %}
                                <a class="button" href="{{ path('project_show', {slug: project.slug}) }}">{{ 'dashboard.business.see_documents'|trans }}</a>
                            {% endif %}
                        </div>
                        {% if recent_documents is empty %}
                            <p class="block__empty">{{ 'dashboard.business.no_documents'|trans }}</p>
                        {% else %}
                            <ul class="list">
                                {% for doc in recent_documents %}
                                    <li>
                                        <a class="row" href="{{ path('document_show', {id: doc.id}) }}">
                                            <span class="format format--{{ doc.format }}">{{ doc.format }}</span>
                                            <span class="row__title"><span>{{ doc.label }}</span></span>
                                            <span class="row__meta">
                                                <span class="row__sub num">{{ 'dashboard.business.doc_rules'|trans({count: doc.rules_count}) }}</span>
                                                <span class="row__sub num">{{ doc.created_at|format_datetime('short', 'short') }}</span>
                                            </span>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </section>
                {% endif %}

                {% for chart in [
                    {key: 'activity_chart', id: 'activity', title: 'dashboard.activity_chart'|trans, total: summary.requests, series: [{label: 'dashboard.requests'|trans, points: requests}, {label: 'dashboard.recalled'|trans, points: recalls}], link: null, wide: true},
                    {key: 'memories_chart', id: 'memories', title: 'dashboard.created'|trans, total: summary.memories_added, series: [{label: 'dashboard.created'|trans, points: memories}], link: path('memory_index', scope), wide: true},
                ] %}
                    {% if chart.key in widgets %}
                        <section class="panel{{ chart.wide ? ' panel--span' }}" aria-labelledby="chart-{{ chart.id }}">
                            <div class="panel__head">
                                <div>
                                    <h2 id="chart-{{ chart.id }}">{{ chart.title }}</h2>
                                    <p class="panel__figure">{{ chart.total|format_number }}</p>
                                </div>
                                {% if chart.series|length > 1 %}
                                    <ul class="legend">
                                        {% for series in chart.series %}<li><span class="chart__swatch chart__swatch--{{ loop.index0 }}"></span>{{ series.label }}</li>{% endfor %}
                                    </ul>
                                {% endif %}
                                {% if chart.link %}<a class="button" href="{{ chart.link }}">{{ 'dashboard.see_memories'|trans }}</a>{% endif %}
                            </div>
                            <div class="chart" data-controller="chart" data-chart-series-value="{{ chart.series|json_encode }}" data-chart-hourly-value="{{ hourly ? 'true' : 'false' }}"
                                 data-action="pointerdown->chart#move pointermove->chart#move pointerleave->chart#leave" aria-label="{{ (hourly ? 'dashboard.chart_hourly' : 'dashboard.chart_daily')|trans({title: chart.title}) }}, {{ period_text }}">
                                <div class="chart__plot" data-chart-target="plot"></div>
                                <div class="chart__tooltip" data-chart-target="tooltip" hidden></div>
                            </div>
                            <details class="chart-data">
                                <summary>{{ 'dashboard.values'|trans }}</summary>
                                <div class="table-wrap">
                                    <table class="data-table">
                                        <thead><tr><th>{{ (hourly ? 'dashboard.hour' : 'dashboard.day')|trans }}</th>{% for series in chart.series %}<th class="num">{{ series.label }}</th>{% endfor %}</tr></thead>
                                        <tbody>
                                            {% for index, point in chart.series[0].points|reverse(true) %}
                                                <tr><td class="num">{{ hourly ? point.at|format_datetime('short', 'short') : point.at|format_date('short') }}</td>{% for series in chart.series %}<td class="num">{{ series.points[index].value }}</td>{% endfor %}</tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </details>
                        </section>
                    {% endif %}
                {% endfor %}

                {% for breakdown in [
                    {key: 'memory_types', id: 'types', title: 'dashboard.types'|trans, note: 'dashboard.active'|trans({count: summary.memories}), rows: memory_types, labels: type_labels, empty: 'dashboard.types_empty'|trans},
                    {key: 'mcp_tools', id: 'tools', title: 'dashboard.tools'|trans, note: period_text, rows: tools, labels: {}, empty: 'dashboard.tools_empty'|trans},
                    {key: 'search_breakdown', id: 'search', title: 'dashboard.search_types'|trans, note: 'dashboard.search_types_note'|trans, rows: search_types, labels: search_labels, empty: 'dashboard.search_empty'|trans, span: true},
                    {key: 'search_breakdown', id: 'modes', title: 'dashboard.search_mode'|trans, note: 'dashboard.search_mode_note'|trans, rows: search_modes, labels: {keyword: 'dashboard.keyword', hybrid: 'dashboard.hybrid'}, empty: 'dashboard.search_empty'|trans},
                ] %}
                    {% if breakdown.key in widgets %}
                        {% set total = breakdown.rows|reduce((sum, row) => sum + row.value, 0) %}
                        {% set top = breakdown.rows|reduce((max, row) => max(max, row.value), 0) %}
                        <section class="panel{{ breakdown.span ?? false ? ' panel--span' }}" aria-labelledby="breakdown-{{ breakdown.id }}">
                            <div class="panel__head">
                                <div>
                                    <h2 id="breakdown-{{ breakdown.id }}">{{ breakdown.title }}</h2>
                                    <span class="row__sub">{{ breakdown.note }}</span>
                                </div>
                            </div>
                            {% if breakdown.rows is empty %}
                                <p class="block__empty">{{ breakdown.empty }}</p>
                            {% else %}
                                <ul class="bars">
                                    {% for row in breakdown.rows %}
                                        <li class="bars__row" title="{{ 'dashboard.out_of'|trans({value: row.value, total: total}) }}">
                                            <span class="bars__label{{ breakdown.labels is empty ? ' mono' }}">{{ breakdown.labels[row.label] is defined ? breakdown.labels[row.label]|trans : row.label }}</span>
                                            <span class="bars__value num">{{ row.value|format_number }} <span class="row__sub">{{ (row.value / total * 100)|format_number({fraction_digit: 1}) }} %</span></span>
                                            <span class="bars__track"><span class="bars__fill{{ loop.first ? ' bars__fill--top' }}" style="width: {{ (row.value / top * 100)|round(1) }}%"></span></span>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </section>
                    {% endif %}
                {% endfor %}

                {% if 'recent_calls' in widgets %}
                    <section class="panel panel--wide" aria-labelledby="recent-title">
                        <div class="panel__head">
                            <h2 id="recent-title">{{ 'dashboard.recent'|trans }}</h2>
                            <span class="row__sub">{{ 'dashboard.in_total'|trans({count: recent.total}) }}</span>
                        </div>
                        {% if recent.items is empty %}
                            <p class="block__empty">{{ 'dashboard.recent_empty'|trans({endpoint: '<span class="mono">/mcp</span>'})|raw }}</p>
                        {% else %}
                            <div class="table-wrap table-wrap--framed mcp-table">
                                <table class="data-table">
                                    <thead><tr><th scope="col">{{ 'activity.when'|trans }}</th><th scope="col">{{ 'dashboard.tool'|trans }}</th><th scope="col">{{ 'memory.index.project'|trans }}</th><th scope="col" class="num">{{ 'palette.results'|trans }}</th><th scope="col" class="num">{{ 'nav.memories'|trans }}</th><th scope="col" class="num">{{ 'dashboard.duration'|trans }}</th><th scope="col">{{ 'dashboard.status'|trans }}</th></tr></thead>
                                    <tbody>
                                        {% for call in recent.items %}
                                            <tr>
                                                <td class="data-table__nowrap" data-label="{{ 'activity.when'|trans }}"><span class="num" title="{{ call.created_at|format_datetime('medium', 'short') }}">{{ call.created_at|format_datetime(pattern: 'dd/MM HH:mm') }}</span>{% if call.client %}<div class="row__sub">{{ call.client }}</div>{% endif %}</td>
                                                <td class="data-table__fill" data-label="{{ 'dashboard.tool'|trans }}"><span class="code-chip">{{ call.tool }}</span>{% if call.query %}<div class="row__sub data-table__clip" title="{{ call.query }}">{{ call.query }}</div>{% endif %}</td>
                                                <td class="data-table__nowrap" data-label="{{ 'memory.index.project'|trans }}">{{ call.project ?? '-' }}</td>
                                                <td class="num" data-label="{{ 'palette.results'|trans }}">{{ call.results }}</td>
                                                <td class="num" data-label="{{ 'nav.memories'|trans }}">{{ call.memories }}</td>
                                                <td class="num" data-label="{{ 'dashboard.duration'|trans }}">{{ call.duration_ms }} ms</td>
                                                <td data-label="{{ 'dashboard.status'|trans }}">{% if call.failed %}<span class="pill pill--danger">{{ 'common.failed'|trans }}</span>{% else %}<span class="pill pill--success">{{ 'dashboard.ok'|trans }}</span>{% endif %}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                        {{ include('_pager.html.twig', {page: recent}) }}
                    </section>
                {% endif %}
            </div>
        </div>

        {% if has_aside %}
            <aside class="dash__aside" aria-label="{{ 'dashboard.attention'|trans }}">
                {% set scoped = app.user and not is_granted('ROLE_SUPER_ADMIN') %}
                {% if 'attention' in widgets %}
                    <section class="side-block" aria-labelledby="attention-title">
                        <h2 class="side-block__title" id="attention-title">{{ 'dashboard.attention'|trans }} <span class="block__count">{{ attention_count }}</span></h2>
                        {% if attention_count == 0 %}
                            <p class="block__empty">{{ 'dashboard.attention_empty'|trans }}</p>
                        {% else %}
                            <ul class="attention">
                                {% for proposal in latest_proposals %}
                                    <li class="attention__item">
                                        <span class="attention__icon attention__icon--{{ proposal.kind }}">{{ ux_icon('lucide:inbox') }}</span>
                                        <div class="attention__body">
                                            <strong>{{ ('enum.proposal_kind.' ~ proposal.kind)|trans }}</strong>
                                            {% if proposal.text %}<p class="attention__text">{{ proposal.text }}</p>{% endif %}
                                            <span class="row__sub num">{{ proposal.created_at|format_datetime('short', 'short') }}</span>
                                        </div>
                                        <a class="attention__link" href="{{ path('proposal_index', scope) ~ '#proposal-' ~ proposal.id }}">{{ 'dashboard.review'|trans }}{{ ux_icon('lucide:arrow-up-right') }}</a>
                                    </li>
                                {% endfor %}
                                {% if summary.pending > latest_proposals|length %}
                                    <li><a class="side-block__more" href="{{ path('proposal_index', scope) }}">{{ 'dashboard.more_proposals'|trans({count: summary.pending - latest_proposals|length}) }}</a></li>
                                {% endif %}
                                {% for connector in failing_connectors %}
                                    <li class="attention__item">
                                        <span class="attention__icon attention__icon--danger">{{ ux_icon('lucide:plug-zap') }}</span>
                                        <div class="attention__body">
                                            <strong>{{ connector.name }}</strong>
                                            <p class="attention__text" title="{{ connector.error }}">{{ connector.error }}</p>
                                            <span class="row__sub num">{{ 'dashboard.connector_failed'|trans }} · {{ connector.last_run_at|format_datetime('short', 'short') }}</span>
                                        </div>
                                        {% if not scoped %}
                                            <a class="attention__link" href="{{ path('connector_show', {id: connector.id}) }}">{{ 'dashboard.open'|trans }}{{ ux_icon('lucide:arrow-up-right') }}</a>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                                {% if refuted > 0 %}
                                    <li class="attention__item">
                                        <span class="attention__icon attention__icon--danger">{{ ux_icon('lucide:shield-alert') }}</span>
                                        <div class="attention__body">
                                            <strong>{{ 'dashboard.refuted'|trans({count: refuted}) }}</strong>
                                            <p class="attention__text">{{ 'dashboard.refuted_text'|trans }}</p>
                                        </div>
                                        <a class="attention__link" href="{{ path('memory_index', scope|merge({verdict: 'refuted'})) }}">{{ 'dashboard.see_memories'|trans }}{{ ux_icon('lucide:arrow-up-right') }}</a>
                                    </li>
                                {% endif %}
                            </ul>
                        {% endif %}
                    </section>
                {% endif %}

                {% if 'ai_quality' in widgets %}
                    <section class="side-block" aria-labelledby="quality-title">
                        <h2 class="side-block__title" id="quality-title">{{ 'dashboard.quality.title'|trans }}</h2>
                        <div class="quality">
                            <div class="quality__metric">
                                <div class="quality__head">
                                    <span class="quality__label">{{ 'dashboard.quality.proposals'|trans }}</span>
                                    <strong class="quality__value num">{{ ai_quality.acceptance_rate is not null ? ai_quality.acceptance_rate|format_number({fraction_digit: 0}) ~ ' %' : '—' }}</strong>
                                </div>
                                <span class="bars__track"><span class="bars__fill bars__fill--top" style="width: {{ ai_quality.acceptance_rate ?? 0 }}%"></span></span>
                                <span class="row__sub num">
                                    {{ 'dashboard.quality.proposals_detail'|trans({applied: ai_quality.applied, rejected: ai_quality.rejected, edited: ai_quality.edited}) }}
                                </span>
                            </div>
                            <div class="quality__metric">
                                <div class="quality__head">
                                    <span class="quality__label">{{ 'dashboard.quality.assistant'|trans }}</span>
                                    <strong class="quality__value num">{{ ai_quality.satisfaction_rate is not null ? ai_quality.satisfaction_rate|format_number({fraction_digit: 0}) ~ ' %' : '—' }}</strong>
                                </div>
                                <span class="bars__track"><span class="bars__fill bars__fill--top" style="width: {{ ai_quality.satisfaction_rate ?? 0 }}%"></span></span>
                                <span class="row__sub num">
                                    {{ 'dashboard.quality.assistant_detail'|trans({up: ai_quality.thumbs_up, down: ai_quality.thumbs_down}) }}
                                </span>
                            </div>
                        </div>
                    </section>
                {% endif %}

                {% if 'timeline' in widgets %}
                    <section class="side-block" aria-labelledby="timeline-title">
                        <h2 class="side-block__title" id="timeline-title">{{ 'dashboard.timeline'|trans }}</h2>
                        {% set entries = timeline.days|reduce((all, items) => all|merge(items), []) %}
                        {% if entries is empty %}
                            <p class="block__empty">{{ 'dashboard.timeline_empty'|trans }}</p>
                        {% else %}
                            {% set kinds = {commit: 'activity.kind.commit', document: 'activity.kind.document', memory: 'activity.kind.memory', business_rule: 'activity.kind.rule'} %}
                            <ol class="timeline">
                                {% for item in entries %}
                                    {% set href = item.type == 'memory' ? path('memory_show', {id: item.id})
                                        : (item.type == 'document' ? path('document_show', {id: item.id})
                                        : (item.type == 'business_rule' and item.project_slug ? path('rule_show', {slug: item.project_slug, code: item.ref}) : item.url)) %}
                                    <li class="timeline__item">
                                        <span class="timeline__mark timeline__mark--{{ item.type }}" aria-hidden="true"></span>
                                        <div class="timeline__body">
                                            {% if href %}<a class="timeline__title" href="{{ href }}" {% if item.type in ['commit', 'ticket'] %}rel="noopener noreferrer" target="_blank"{% endif %}>{{ item.label }}</a>{% else %}<span class="timeline__title">{{ item.label }}</span>{% endif %}
                                            <span class="row__sub">{{ item.type == 'ticket' ? item.ref : (item.type == 'commit' ? item.ref|slice(0, 7) : kinds[item.type]|trans) }}{% if item.author %} · {{ item.author }}{% endif %} · <span class="num">{{ item.created_at|format_datetime('short', 'short') }}</span></span>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ol>
                        {% endif %}
                        <a class="side-block__more" href="{{ path('activity_feed', scope) }}">{{ 'dashboard.see_feed'|trans }}{{ ux_icon('lucide:arrow-up-right') }}</a>
                    </section>
                {% endif %}
            </aside>
        {% endif %}
    </div>

    <dialog class="dialog dash-customize-dialog" id="dashboard-customize" closedby="any" aria-labelledby="dash-customize-title">
        <h2 class="dialog__title" id="dash-customize-title">{{ 'dashboard.customize_title'|trans }}</h2>
        <p class="dialog__text">{{ 'dashboard.customize_text'|trans }}</p>
        <form method="post" action="{{ path('dashboard_preferences', pref_query) }}" class="dash-customize-form">
            <input type="hidden" name="_token" value="{{ prefs_token }}">
            <input type="hidden" name="mode" value="custom">
            <input type="hidden" name="role" value="{{ role.value }}">

            {% for groupKey, groupTitle in {business: 'enum.dashboard_role.business', dev: 'enum.dashboard_role.dev', shared: 'dashboard.widget.group_shared'} %}
                <fieldset class="dash-customize-group">
                    <legend>{{ groupTitle|trans }}</legend>
                    {% for key, meta in widget_catalog %}
                        {% if meta.group == groupKey %}
                            <label class="dash-widget-opt">
                                <input type="checkbox" name="widgets[]" value="{{ key }}" {{ key in widgets ? 'checked' }}>
                                <span class="dash-widget-opt__body">
                                    <strong>{{ meta.label|trans }}</strong>
                                    <span class="row__sub">{{ meta.description|trans }}</span>
                                </span>
                            </label>
                        {% endif %}
                    {% endfor %}
                </fieldset>
            {% endfor %}

            <div class="dialog__actions">
                <button class="button button--ghost" type="submit" name="mode" value="role">{{ 'dashboard.customize_reset'|trans }}</button>
                <button class="button" type="button" commandfor="dashboard-customize" command="close">{{ 'common.cancel'|trans }}</button>
                <button class="button button--primary" type="submit">{{ 'common.save_settings'|trans }}</button>
            </div>
        </form>
    </dialog>
{% endblock %}
