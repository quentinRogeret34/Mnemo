{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.dashboard'|trans }}{{ project ? ' · ' ~ project.name }}{% endblock %}

{% block crumbs %}
    {% if project %}
        <a href="{{ path('project_show', {slug: project.slug}) }}">{{ project.name }}</a>
        <span class="crumbs__sep" aria-hidden="true">/</span>
    {% endif %}
    <span class="crumbs__current">{{ 'nav.dashboard'|trans }}</span>
{% endblock %}

{% block body %}
    {% set scope = project ? {project: project.slug} : {} %}
    {% set period_labels = {'24h': 'period.24h', '7d': 'period.7d', '30d': 'period.30d', '90d': 'period.90d', 'all': 'period.all'} %}
    {% set period_text = ('dashboard.period.' ~ period)|trans %}
    {% set type_labels = {decision: 'enum.memory_type.decision', convention: 'enum.memory_type.convention', task_learning: 'enum.memory_type.task_learning', preference: 'enum.memory_type.preference', fact: 'enum.memory_type.fact'} %}
    {% set search_labels = {memory: 'nav.memories', document: 'nav.documents', business_rule: 'nav.rules', code_file: 'nav.code'} %}

    <div class="view-head">
        <h1><twig:ux:icon name="lucide:layout-dashboard" />{{ 'nav.dashboard'|trans }}</h1>
        <span class="view-head__meta">{{ project ? project.name : 'nav.all_projects'|trans }}</span>
    </div>

    <div class="filter-bar">
        <nav class="tabs" aria-label="{{ 'period.label'|trans }}">
            {% for item in periods %}
                <a href="{{ path('dashboard', scope|merge({period: item})) }}" {% if item == period %}aria-current="page"{% endif %}>{{ period_labels[item]|trans }}</a>
            {% endfor %}
        </nav>
        <a class="button" href="{{ path('dashboard', scope|merge({period: period})) }}"><twig:ux:icon name="lucide:refresh-cw" />{{ 'dashboard.refresh'|trans }}</a>
    </div>

    <section class="tiles" aria-label="{{ 'dashboard.key_figures'|trans }}">
        <div class="tile">
            <span class="tile__label">{{ 'dashboard.stored'|trans }}</span>
            <span class="tile__value">{{ summary.memories|format_number }}</span>
            <span class="tile__sub">+{{ summary.memories_added }} {{ period_text }}</span>
        </div>
        <div class="tile">
            <span class="tile__label" title="{{ 'dashboard.recalled_title'|trans }}">{{ 'dashboard.recalled'|trans }}</span>
            <span class="tile__value">{{ summary.recalled|format_number }}</span>
            <span class="tile__sub">{{ 'dashboard.lookups'|trans({count: summary.lookups}) }}{% if summary.lookups > 0 %}, {{ 'dashboard.average'|trans({value: (summary.recalled / summary.lookups)|format_number({fraction_digit: 1})}) }}{% endif %}</span>
        </div>
        <div class="tile">
            <span class="tile__label">{{ 'dashboard.requests'|trans }}</span>
            <span class="tile__value">{{ summary.requests|format_number }}</span>
            <span class="tile__sub">{{ 'dashboard.failed'|trans({count: summary.failed}) }} {{ period_text }}</span>
        </div>
        <a class="tile tile--link" href="{{ path('proposal_index', scope) }}">
            <span class="tile__label">{{ 'nav.to_review'|trans }}</span>
            <span class="tile__value">{{ summary.pending|format_number }}</span>
            <span class="tile__sub">{{ 'dashboard.pending'|trans({count: summary.pending}) }}</span>
        </a>
    </section>

    <div class="panels">
        {% for chart in [
            {id: 'requests', title: 'dashboard.requests'|trans, total: summary.requests, points: requests, unit: 'dashboard.unit_requests'|trans, link: null},
            {id: 'memories', title: 'dashboard.created'|trans, total: summary.memories_added, points: memories, unit: 'dashboard.unit_memories'|trans, link: path('memory_index', scope)},
        ] %}
            <section class="panel" aria-labelledby="chart-{{ chart.id }}">
                <div class="panel__head">
                    <div>
                        <h2 id="chart-{{ chart.id }}">{{ chart.title }}</h2>
                        <p class="panel__figure">{{ chart.total|format_number }}</p>
                    </div>
                    {% if chart.link %}<a class="button" href="{{ chart.link }}">{{ 'dashboard.see_memories'|trans }}</a>{% endif %}
                </div>
                <div class="chart" data-controller="chart" data-chart-points-value="{{ chart.points|json_encode }}" data-chart-hourly-value="{{ hourly ? 'true' : 'false' }}" data-chart-unit-value="{{ chart.unit }}"
                     data-action="pointermove->chart#move pointerleave->chart#leave" aria-label="{{ (hourly ? 'dashboard.chart_hourly' : 'dashboard.chart_daily')|trans({title: chart.title}) }}, {{ period_text }}">
                    <div class="chart__plot" data-chart-target="plot"></div>
                    <div class="chart__tooltip" data-chart-target="tooltip" hidden></div>
                </div>
                <details class="chart-data">
                    <summary>{{ 'dashboard.values'|trans }}</summary>
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead><tr><th>{{ (hourly ? 'dashboard.hour' : 'dashboard.day')|trans }}</th><th class="num">{{ chart.title }}</th></tr></thead>
                            <tbody>
                                {% for point in chart.points|reverse %}
                                    <tr><td class="num">{{ hourly ? point.at|format_datetime('short', 'short') : point.at|format_date('short') }}</td><td class="num">{{ point.value }}</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </details>
            </section>
        {% endfor %}

        {% for breakdown in [
            {id: 'types', title: 'dashboard.types'|trans, note: 'dashboard.active'|trans({count: summary.memories}), rows: memory_types, labels: type_labels, empty: 'dashboard.types_empty'|trans},
            {id: 'tools', title: 'dashboard.tools'|trans, note: period_text, rows: tools, labels: {}, empty: 'dashboard.tools_empty'|trans},
            {id: 'search', title: 'dashboard.search_types'|trans, note: 'dashboard.search_types_note'|trans, rows: search_types, labels: search_labels, empty: 'dashboard.search_empty'|trans},
            {id: 'modes', title: 'dashboard.search_mode'|trans, note: 'dashboard.search_mode_note'|trans, rows: search_modes, labels: {keyword: 'dashboard.keyword', hybrid: 'dashboard.hybrid'}, empty: 'dashboard.search_empty'|trans},
        ] %}
            {% set total = breakdown.rows|reduce((sum, row) => sum + row.value, 0) %}
            {% set top = breakdown.rows|reduce((max, row) => max(max, row.value), 0) %}
            <section class="panel" aria-labelledby="breakdown-{{ breakdown.id }}">
                <div class="panel__head">
                    <h2 id="breakdown-{{ breakdown.id }}">{{ breakdown.title }}</h2>
                    <span class="row__sub">{{ breakdown.note }}</span>
                </div>
                {% if breakdown.rows is empty %}
                    <p class="block__empty">{{ breakdown.empty }}</p>
                {% else %}
                    <ul class="bars">
                        {% for row in breakdown.rows %}
                            <li class="bars__row" title="{{ 'dashboard.out_of'|trans({value: row.value, total: total}) }}">
                                <span class="bars__label{{ breakdown.labels is empty ? ' mono' }}">{{ breakdown.labels[row.label] is defined ? breakdown.labels[row.label]|trans : row.label }}</span>
                                <span class="bars__track"><span class="bars__fill" style="width: {{ (row.value / top * 100)|round(1) }}%"></span></span>
                                <span class="bars__value num">{{ row.value }} <span class="row__sub">{{ (row.value / total * 100)|format_number({fraction_digit: 1}) }} %</span></span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        {% endfor %}

        <section class="panel panel--wide" aria-labelledby="recent-title">
            <div class="panel__head">
                <h2 id="recent-title">{{ 'dashboard.recent'|trans }}</h2>
                <span class="row__sub">{{ 'dashboard.in_total'|trans({count: recent.total}) }}</span>
            </div>
            {% if recent.items is empty %}
                <p class="block__empty">{{ 'dashboard.recent_empty'|trans({endpoint: '<span class="mono">/mcp</span>'})|raw }}</p>
            {% else %}
                <div class="table-wrap">
                    <table class="data-table">
                        <thead><tr><th>{{ 'activity.when'|trans }}</th><th>{{ 'dashboard.tool'|trans }}</th><th>{{ 'memory.index.project'|trans }}</th><th>{{ 'dashboard.query'|trans }}</th><th class="num">{{ 'palette.results'|trans }}</th><th class="num">{{ 'nav.memories'|trans }}</th><th class="num">{{ 'dashboard.duration'|trans }}</th><th>{{ 'dashboard.client'|trans }}</th></tr></thead>
                        <tbody>
                            {% for call in recent.items %}
                                <tr>
                                    <td class="num">{{ call.created_at|format_datetime('short', 'short') }}</td>
                                    <td><span class="code-chip">{{ call.tool }}</span>{% if call.failed %} <span class="verdict verdict--refuted">{{ 'common.failed'|trans }}</span>{% endif %}</td>
                                    <td>{{ call.project ?? '-' }}</td>
                                    <td class="data-table__clip">{{ call.query ?? '-' }}</td>
                                    <td class="num">{{ call.results }}</td>
                                    <td class="num">{{ call.memories }}</td>
                                    <td class="num">{{ call.duration_ms }} ms</td>
                                    <td>{{ call.client ?? '-' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
            {{ include('_pager.html.twig', {page: recent}) }}
        </section>
    </div>
{% endblock %}
