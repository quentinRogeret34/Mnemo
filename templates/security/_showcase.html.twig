<aside class="auth-showcase" aria-hidden="true">
    <div class="auth-showcase__stage">
        <div class="auth-mock">
            <div class="auth-mock__bar">
                <span></span><span></span><span></span>
            </div>
            <div class="auth-mock__sources">
                <span class="auth-mock__source-badge" title="GitHub">
                    <twig:ux:icon name="simple-icons:github" class="icon" />
                </span>
                <span class="auth-mock__source-badge" title="GitLab">
                    <svg class="icon" viewBox="0 0 24 24"><path fill="#FC6D26" d="M22.65 14.39 12 22.13 1.35 14.39a.84.84 0 0 1-.3-.94l1.22-3.78 2.44-7.51A.42.42 0 0 1 4.82 2a.43.43 0 0 1 .58 0 .42.42 0 0 1 .11.18l2.44 7.49h8.1l2.44-7.51A.42.42 0 0 1 18.6 2a.43.43 0 0 1 .58 0 .42.42 0 0 1 .11.18l2.44 7.51L23 13.45a.84.84 0 0 1-.35.94Z"/></svg>
                </span>
                <span class="auth-mock__source-badge" title="MCP & Agents">
                    <twig:ux:icon name="lucide:network" class="icon" />
                </span>
            </div>
            <div class="auth-mock__grid">
                <div class="auth-mock__tile"></div>
                <div class="auth-mock__tile"></div>
                <div class="auth-mock__tile"></div>
                <div class="auth-mock__tile"></div>
                <div class="auth-mock__tile"></div>
                <div class="auth-mock__tile"></div>
            </div>
        </div>

        <div class="auth-float auth-float--pill">
            <span>{{ 'login.showcase.badge'|trans }}</span>
        </div>

        <div class="auth-float auth-float--left">
            <span class="auth-float__label">{{ 'login.showcase.alignment'|trans }}</span>
            <div class="auth-bars">
                <div class="auth-bars__row"><span class="auth-bars__fill" style="width: 94%"></span><strong>94%</strong></div>
                <div class="auth-bars__row"><span class="auth-bars__fill auth-bars__fill--mid" style="width: 82%"></span><strong>82%</strong></div>
                <div class="auth-bars__row"><span class="auth-bars__fill auth-bars__fill--soft" style="width: 68%"></span><strong>68%</strong></div>
            </div>
        </div>

        <div class="auth-float auth-float--right">
            <span class="auth-float__label">{{ 'login.showcase.memory'|trans }}</span>
            <svg class="auth-spark" viewBox="0 0 120 42" fill="none">
                <path d="M4 36 C 28 34, 48 28, 72 18 C 90 10, 104 6, 116 5" stroke="#1d4682" stroke-width="2.5" stroke-linecap="round"/>
                <path d="M4 36 C 28 34, 48 28, 72 18 C 90 10, 104 6, 116 5 L 116 40 L 4 40 Z" fill="url(#mnemoSpark)"/>
                <defs>
                    <linearGradient id="mnemoSpark" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#1d4682" stop-opacity="0.22"/>
                        <stop offset="100%" stop-color="#1d4682" stop-opacity="0"/>
                    </linearGradient>
                </defs>
            </svg>
            <div class="auth-float__foot">
                <strong>98 %</strong>
                <span class="auth-float__status">{{ 'login.showcase.verified'|trans }}</span>
            </div>
        </div>
    </div>

    <div class="auth-showcase__copy">
        <h2>{{ 'login.showcase.title'|trans }}</h2>
        <p>{{ 'login.showcase.text'|trans }}</p>
    </div>
</aside>
