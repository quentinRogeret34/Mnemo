<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        {{ include('_head_common.html.twig') }}
        <title>{{ 'pending.title'|trans }} · {{ 'app.name'|trans }}</title>
        {{ importmap('app') }}
    </head>
    <body>
        <main class="login">
            <div class="login__card">
                <span class="workspace"><span class="workspace__mark" aria-hidden="true">M</span>{{ 'app.name'|trans }}</span>
                <h1>{{ 'pending.title'|trans }}</h1>
                {% if app.user %}
                    <p>{{ 'pending.text'|trans({account: '<strong>' ~ app.user.userIdentifier|e ~ '</strong>'})|raw }}</p>
                    <a class="button" href="{{ logout_path() }}">{{ 'nav.logout'|trans }}</a>
                {% else %}
                    <a class="button button--primary" href="{{ path('login') }}">{{ 'login.submit'|trans }}</a>
                {% endif %}
            </div>
        </main>
    </body>
</html>
