{% if providers is not empty %}
    <div class="auth-providers">
        {% for key, label in providers %}
            <a class="button login__provider" href="{{ path('oauth_connect', {provider: key}) }}">
                {% if key == 'google' %}
                    <svg class="icon auth-brand-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.2-2.27H12v4.3h6.45a5.52 5.52 0 0 1-2.39 3.62v3h3.87c2.26-2.08 3.56-5.15 3.56-8.65Z"/>
                        <path fill="#34A853" d="M12 24c3.24 0 5.95-1.07 7.93-2.91l-3.87-3a7.17 7.17 0 0 1-10.67-3.77H1.4v3.09A12 12 0 0 0 12 24Z"/>
                        <path fill="#FBBC05" d="M5.39 14.32A7.2 7.2 0 0 1 5.01 12c0-.81.14-1.59.38-2.32V6.59H1.4A12 12 0 0 0 0 12c0 1.94.46 3.77 1.4 5.41l3.99-3.09Z"/>
                        <path fill="#EA4335" d="M12 4.75c1.76 0 3.34.61 4.59 1.8l3.44-3.44C17.95 1.19 15.24 0 12 0A12 12 0 0 0 1.4 6.59l3.99 3.09A7.15 7.15 0 0 1 12 4.75Z"/>
                    </svg>
                {% elseif key == 'gitlab' %}
                    <svg class="icon auth-brand-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="#E24329" d="m12 21.42 4.2-12.92H7.8L12 21.42Z"/>
                        <path fill="#FC6D26" d="M12 21.42 7.8 8.5H1.93L12 21.42Z"/>
                        <path fill="#FCA326" d="M1.93 8.5.65 12.42a.87.87 0 0 0 .32.98L12 21.42 1.93 8.5Z"/>
                        <path fill="#E24329" d="M1.93 8.5H7.8L5.28.74a.44.44 0 0 0-.84 0L1.93 8.5Z"/>
                        <path fill="#FC6D26" d="M12 21.42 16.2 8.5h5.87L12 21.42Z"/>
                        <path fill="#FCA326" d="m22.07 8.5 1.28 3.92a.87.87 0 0 1-.32.98L12 21.42 22.07 8.5Z"/>
                        <path fill="#E24329" d="M22.07 8.5H16.2l2.52-7.76a.44.44 0 0 1 .84 0L22.07 8.5Z"/>
                    </svg>
                {% elseif key == 'github' %}
                    <twig:ux:icon name="simple-icons:github" class="icon auth-brand-icon" />
                {% endif %}
                {{- 'login.continue_with'|trans({provider: label}) -}}
            </a>
        {% endfor %}
    </div>
{% endif %}
