<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        {{ include('_head_common.html.twig') }}
        <title>{{ 'login.title'|trans }} · {{ 'app.name'|trans }}</title>
        {{ importmap('app') }}
    </head>
    <body class="auth-body" data-controller="busy" data-action="submit@window->busy#mark pageshow@window->busy#reset">
        <main class="auth-split">
            <section class="auth-split__main">
                <header class="auth-split__brand">
                    <span class="workspace"><img class="workspace__mark" src="{{ asset('images/mnemo-mark.png') }}" alt="" width="22" height="22">{{ 'app.name'|trans }}</span>
                </header>

                <div class="login__card auth-form">
                    <div class="auth-form__head">
                        <h1>{{ 'login.heading'|trans }}</h1>
                        <p class="auth-form__sub">{{ 'login.subtitle'|trans }}</p>
                    </div>

                    {% if error %}<p class="flash flash--error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</p>{% endif %}

                    {{ include('security/_oauth_buttons.html.twig') }}

                    {% if providers is not empty %}
                        <div class="auth-divider" role="separator"><span>{{ 'login.or'|trans }}</span></div>
                    {% endif %}

                    <form class="auth-fields" method="post" action="{{ path('login') }}">
                        <div class="auth-field">
                            <label for="username">{{ 'login.email_or_username'|trans }}</label>
                            <input class="input auth-input" id="username" type="text" name="_username" value="{{ last_username }}" placeholder="{{ 'login.email_placeholder'|trans }}" autocomplete="username" required autofocus>
                        </div>

                        <div class="auth-field" data-controller="password-visibility">
                            <label for="password">{{ 'login.password'|trans }}</label>
                            <div class="auth-password-wrap">
                                <input class="input auth-input" id="password" type="password" name="_password" placeholder="••••••••••" autocomplete="current-password" required data-password-visibility-target="input">
                                <button class="auth-password-toggle" type="button" aria-label="{{ 'login.toggle_password'|trans }}" aria-pressed="false" data-password-visibility-target="button" data-action="password-visibility#toggle">
                                    <twig:ux:icon name="lucide:eye" class="icon" />
                                </button>
                            </div>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                        <button class="button button--primary auth-submit" type="submit">{{ 'login.submit'|trans }}</button>
                    </form>

                    <p class="auth-switch">
                        {{ 'login.no_account'|trans }}
                        <a class="link" href="{{ path('register') }}">{{ 'login.create_account'|trans }}</a>
                    </p>
                </div>

                <footer class="auth-split__foot">
                    <a href="https://github.com/quentinRogeret34/Mnemo" target="_blank" rel="noopener">{{ 'nav.source'|trans }}</a>
                    <span>© {{ 'now'|date('Y') }} {{ 'app.name'|trans }}</span>
                </footer>
            </section>

            {{ include('security/_showcase.html.twig') }}
        </main>
    </body>
</html>
