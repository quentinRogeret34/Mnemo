<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Connexion · Graphe projet</title>
        <script>
            try { document.documentElement.dataset.theme = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); } catch (error) { document.documentElement.dataset.theme = 'light'; }
        </script>
        {{ importmap('app') }}
    </head>
    <body>
        <main class="login">
            <div class="login__card">
                <span class="workspace"><span class="workspace__mark" aria-hidden="true">G</span>Graphe projet</span>
                <h1>Connexion</h1>
                {% if error %}<p class="flash flash--error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</p>{% endif %}
                {% for key, label in providers %}
                    <a class="button login__provider" href="{{ path('oauth_connect', {provider: key}) }}">Continuer avec {{ label }}</a>
                {% endfor %}
                {% if providers is empty %}<p class="row__sub">Aucun fournisseur de connexion n'est configuré (variables <span class="mono">OAUTH_*</span>).</p>{% endif %}
                <details class="login__password" {% if error and last_username %}open{% endif %}>
                    <summary class="row__sub">Compte de secours (mot de passe)</summary>
            <form method="post" action="{{ path('login') }}">
                <label for="username">Identifiant</label>
                <input class="input" id="username" type="text" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
                <label for="password">Mot de passe</label>
                <input class="input" id="password" type="password" name="_password" autocomplete="current-password" required>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button class="button button--primary" type="submit">Se connecter</button>
            </form>
                </details>
            </div>
        </main>
    </body>
</html>
