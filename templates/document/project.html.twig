{% extends 'base.html.twig' %}

{% block title %}Documents · {{ project.name }}{% endblock %}

{% block crumbs %}
    <a href="{{ path('project_show', {slug: project.slug}) }}">{{ project.name }}</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__current">Documents</span>
{% endblock %}

{% block header_actions %}
    <a class="button" href="{{ path('document_index') }}">Tous les dossiers</a>
{% endblock %}

{% block body %}
    <div class="view-head">
        <h1><twig:ux:icon name="lucide:file-text" />Documents</h1>
        <span class="view-head__meta">{{ documents|length }} rattachés à {{ project.name }}</span>
    </div>

    {{ include('document/_upload.html.twig', {upload: upload, hint: '.md, .pdf, .docx · 32 Mo max · rattachés à ' ~ project.name}) }}

    {% if documents is empty %}
        <twig:EmptyState title="Aucun document rattaché à ce projet" text="Déposer des fichiers ci-dessus, ou rattacher un document existant depuis sa page.">
            <twig:block name="icon"><twig:ux:icon name="lucide:file-text" /></twig:block>
            <details class="empty-state__more">
                <summary>Charger la démo</summary>
                <pre><code>bin/console app:demo {{ project.slug }}</code></pre>
            </details>
        </twig:EmptyState>
    {% else %}
        {{ include('document/_rows.html.twig', {documents: documents, show_folder: true, show_projects: false}) }}
    {% endif %}
{% endblock %}
