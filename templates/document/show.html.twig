{% extends 'base.html.twig' %}

{% set meta = document.metadata %}

{% block title %}{{ document.label }} · {{ 'nav.documents'|trans }}{% endblock %}

{% block crumbs %}
    {% set scoped = app.user and not is_granted('ROLE_SUPER_ADMIN') %}
    {% if scoped %}
        <span>{{ 'nav.documents'|trans }}</span>
        {% if document.folder %}
            <span class="crumbs__sep" aria-hidden="true">/</span>
            <span>{{ document.folder.name }}</span>
        {% endif %}
    {% else %}
        <a href="{{ path('document_index') }}">{{ 'nav.documents'|trans }}</a>
        {% if document.folder %}
            <span class="crumbs__sep" aria-hidden="true">/</span>
            <a href="{{ path('document_index', {folder: document.folder.id}) }}">{{ document.folder.name }}</a>
        {% endif %}
    {% endif %}
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__current" aria-current="page">{{ document.label }}</span>
{% endblock %}

{% block header_actions %}
    <a class="button" href="{{ path('document_file', {id: document.id}) }}">{{ (meta.format == 'pdf' ? 'document.open_pdf' : 'document.download')|trans }}</a>
{% endblock %}

{% block body %}
    <div class="doc-layout" data-controller="toc">
        <div class="explorer__tree" data-controller="disclosure">
            <button class="button explorer__tree-toggle" type="button" aria-expanded="false" aria-controls="doc-tree-panel" data-disclosure-target="button" data-action="disclosure#toggle">
                <twig:ux:icon name="lucide:folder-open" />
                <span>{{ 'document.folders'|trans }}</span>
                <twig:ux:icon name="lucide:chevron-down" class="icon explorer__tree-chevron" />
            </button>
            <div class="explorer__tree-panel" id="doc-tree-panel" data-disclosure-target="panel">
                {{ include('document/_tree.html.twig', {open: ancestors|map(folder => folder.id), current_folder: null, current_document: document.id}) }}
            </div>
        </div>

        <article class="doc">
            <header class="doc__head">
                <span class="format format--{{ meta.format }}">{{ meta.format }}</span>
                <h1 class="doc__title">{{ document.label }}</h1>
                <p class="doc__lede">
                    <span>{{ document.path }}</span>
                    <span>{{ 'document.props.kb'|trans({size: (meta.size / 1024)|round(meta.size < 10240 ? 1 : 0)}) }}</span>
                    <span>{{ document.createdAt|format_datetime('medium', 'short') }}</span>
                    {% if meta.demo ?? false %}<span class="tag tag--demo">{{ 'common.demo'|trans }}</span>{% endif %}
                </p>
            </header>

            {% if markdown is not null %}
                <div class="prose doc__body" data-toc-target="content">{{ markdown|markdown_to_html }}</div>
            {% elseif meta.format == 'pdf' %}
                <iframe class="pdf-frame" src="{{ path('document_file', {id: document.id}) }}" title="{{ document.label }}"></iframe>
            {% elseif extracted_text %}
                <div class="prose doc__body" data-toc-target="content">
                    <p class="row__sub doc__extracted-note">{{ 'document.extracted_preview'|trans }}</p>
                    {% for paragraph in extracted_text|split("\n\n") %}
                        <p>{{ paragraph|nl2br }}</p>
                    {% endfor %}
                </div>
            {% else %}
                <p class="block__empty">{{ 'document.no_preview'|trans }}</p>
            {% endif %}

            <section class="block" aria-labelledby="rules-title">
                <div class="block__head">
                    <h2 id="rules-title">{{ 'document.defined_rules'|trans }}</h2>
                    <span class="block__count">{{ rules|length }}</span>
                    {% if extractable_projects is not empty %}
                        <form class="doc-extract-form" method="post" action="{{ path('document_extract_rules', {id: document.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('document-extract-' ~ document.id) }}">
                            {% if extractable_projects|length == 1 %}
                                <input type="hidden" name="project" value="{{ extractable_projects[0].slug }}">
                            {% else %}
                                <label class="visually-hidden" for="extract-project">{{ 'memory.index.project'|trans }}</label>
                                <select class="select" id="extract-project" name="project">
                                    {% for proj in extractable_projects %}
                                        <option value="{{ proj.slug }}">{{ proj.name }}</option>
                                    {% endfor %}
                                </select>
                            {% endif %}
                            <button class="button button--primary" type="submit"><twig:ux:icon name="lucide:clipboard-check" />{{ 'document.extract_rules'|trans }}</button>
                        </form>
                    {% endif %}
                </div>
                {% if rules is empty %}
                    <p class="block__empty">{{ 'document.no_rule'|trans }}</p>
                {% else %}
                    <ul class="list">
                        {% for rule in rules %}
                            <li>
                                <a class="row" href="{{ path('rule_show', {slug: rule.project_slug, code: rule.code}) }}">
                                    <span class="code-chip">{{ rule.code }}</span>
                                    <span class="row__title"><span>{{ rule.title }}</span></span>
                                    <span class="row__meta">
                                        <span class="status status--{{ rule.status }}">{{ (rule.status == 'validated' ? 'rule.validated' : 'nav.to_review')|trans }}</span>
                                        <span class="conf conf--{{ rule.confidence|lower }}">{{ rule.confidence }}</span>
                                    </span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>

            {{ include('memory/_about.html.twig', {memories: memories}) }}
        </article>

        <aside class="doc-aside" aria-label="{{ 'document.properties'|trans }}">
            <nav class="doc-toc" aria-labelledby="toc-title" data-toc-target="nav" data-controller="disclosure" hidden>
                <button class="button doc-toc__toggle" type="button" aria-expanded="false" aria-controls="doc-toc-panel" data-disclosure-target="button" data-action="disclosure#toggle">
                    <span>{{ 'document.on_this_page'|trans }}</span>
                    <twig:ux:icon name="lucide:chevron-down" class="icon explorer__tree-chevron" />
                </button>
                <h2 class="doc-aside__title" id="toc-title">{{ 'document.on_this_page'|trans }}</h2>
                <div class="doc-toc__panel" id="doc-toc-panel" data-disclosure-target="panel">
                    <ol class="doc-toc__list" data-toc-target="list" data-action="click->disclosure#close"></ol>
                </div>
            </nav>
            <section class="doc-card" aria-labelledby="props-title">
                <h2 class="doc-aside__title" id="props-title">{{ 'document.properties'|trans }}</h2>
                <twig:DocumentProperties :document="document" />
            </section>
        </aside>
    </div>
{% endblock %}
