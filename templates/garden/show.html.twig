{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.garden'|trans }} · {{ project.name }}{% endblock %}

{% block crumbs %}
    <a href="{{ path('project_show', {slug: project.slug}) }}">{{ project.name }}</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__current">{{ 'nav.garden'|trans }}</span>
{% endblock %}

{% block body %}
    {% set groups = {
        memories: {label: 'nav.memories', clean: 'garden.clean.memories'},
        rules: {label: 'nav.rules', clean: 'garden.clean.rules'},
        documents: {label: 'nav.documents', clean: 'garden.clean.documents'},
        links: {label: 'garden.links', clean: 'garden.clean.links'},
    } %}
    {% set total = findings|reduce((sum, finding) => sum + finding.count, 0) %}
    <div class="view-head" data-tone="emerald">
        <h1><twig:ux:icon name="lucide:sprout" />{{ 'nav.garden'|trans }}</h1>
        <span class="view-head__meta">{{ 'garden.total'|trans({count: total}) }}</span>
    </div>

    <ol class="steps">
        <li class="steps__item"><span class="steps__title">{{ 'garden.step.spot'|trans }}</span><span class="row__sub">{{ 'garden.step.spot_text'|trans }}</span></li>
        <li class="steps__item">
            <span class="steps__title">{{ 'garden.step.compare'|trans }}</span>
            <span class="row__sub">{{ 'garden.step.compare_text'|trans }}</span>
            <form method="post" action="{{ path('garden_duplicates', {slug: project.slug}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('garden-' ~ project.slug) }}">
                <button class="button" type="submit">{{ 'garden.step.compare_button'|trans }}</button>
            </form>
        </li>
        <li class="steps__item">
            <span class="steps__title">{{ 'garden.step.fix'|trans }}</span>
            <span class="row__sub">{{ 'garden.step.fix_text'|trans }}</span>
            <a class="button" href="{{ path('proposal_index', {project: project.slug}) }}">{{ 'nav.to_review'|trans }}{% if pending > 0 %} ({{ 'proposal.pending'|trans({count: pending}) }}){% endif %}</a>
        </li>
    </ol>

    <section class="tiles" aria-label="{{ 'garden.state'|trans }}">
        {% for key, group in groups %}
            {% set count = findings|filter(finding => finding.group == key)|reduce((sum, finding) => sum + finding.count, 0) %}
            <a class="tile tile--link{{ count == 0 ? ' tile--clean' }}" href="#group-{{ key }}">
                <span class="tile__label">{{ group.label|trans }}</span>
                <span class="tile__value">{{ count }}</span>
                <span class="tile__sub">{{ (count == 0 ? 'garden.nothing' : 'garden.to_tend')|trans }}</span>
            </a>
        {% endfor %}
    </section>

    {% for key, group in groups %}
        {% set group_findings = findings|filter(finding => finding.group == key) %}
        <div class="garden-group" id="group-{{ key }}">
            <h2 class="garden-group__title">{{ group.label|trans }}</h2>
            {% if group_findings is empty %}
                <p class="block__empty">{{ group.clean|trans }}</p>
            {% endif %}
            {% for finding in group_findings %}
                <section class="finding" aria-labelledby="finding-{{ finding.key }}">
                    <details {% if finding.count <= 8 %}open{% endif %}>
                        <summary class="finding__head">
                            <h3 id="finding-{{ finding.key }}">{{ ('garden.finding.' ~ finding.key ~ '.title')|trans }}</h3>
                            <span class="block__count">{{ finding.count }}</span>
                            <span class="row__sub finding__hint">{{ ('garden.finding.' ~ finding.key ~ '.hint')|trans }}</span>
                        </summary>
                        <ul class="list">
                            {% for item in finding.items %}
                                <li>
                                    {% if item.type == 'memory' %}
                                        <a class="row row--memory" href="{{ path('memory_show', {id: item.id}) }}"><span class="row__title"><span class="memory-text">{{ item.label }}</span></span></a>
                                    {% elseif item.type == 'business_rule' %}
                                        <a class="row" href="{{ path('rule_show', {slug: project.slug, code: item.code}) }}"><span class="row__title"><span class="code-chip">{{ item.code }}</span> {{ item.label }}</span></a>
                                    {% elseif item.type == 'document' %}
                                        <a class="row" href="{{ path('document_show', {id: item.id}) }}"><span class="row__title">{{ item.label }}</span></a>
                                    {% else %}
                                        <span class="row"><span class="row__title mono">{{ item.label }}</span></span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                        {% if finding.count > finding.items|length %}<p class="row__sub">{{ 'garden.more'|trans({count: finding.count - finding.items|length}) }}</p>{% endif %}
                    </details>
                </section>
            {% endfor %}
        </div>
    {% endfor %}
{% endblock %}
