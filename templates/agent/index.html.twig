{% extends 'base.html.twig' %}

{% block title %}Skills des agents · {{ project.name }}{% endblock %}

{% block crumbs %}
    <a href="{{ path('project_show', {slug: project.slug}) }}">{{ project.name }}</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__current">Skills des agents</span>
{% endblock %}

{% block header_actions %}
    <a class="button button--primary" href="{{ path('agent_asset_new', {slug: project.slug}) }}"><twig:ux:icon name="lucide:plus" />Ajouter</a>
{% endblock %}

{% block body %}
    <div class="view-head">
        <h1><twig:ux:icon name="lucide:wand-sparkles" />Skills des agents</h1>
        <span class="view-head__meta">{{ assets|length }}</span>
    </div>
    <p class="page__lede">Skills, commandes et sous-agents du projet. Le plugin les écrit dans le dossier <span class="mono">.claude/</span> de chaque Claude Code connecté au projet, au début de ses sessions, et retire ceux qui sont supprimés ici. Un fichier local du même nom n'est jamais écrasé.</p>

    {% if assets is empty %}
        <twig:EmptyState title="Aucun skill" text="Écrire ici un skill, une commande ou un sous-agent : tous les postes connectés au projet le reçoivent, sans rien commiter dans le dépôt.">
            <twig:block name="icon"><twig:ux:icon name="lucide:wand-sparkles" /></twig:block>
            <twig:block name="actions"><a class="button button--primary" href="{{ path('agent_asset_new', {slug: project.slug}) }}"><twig:ux:icon name="lucide:plus" />Ajouter</a></twig:block>
        </twig:EmptyState>
    {% else %}
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Type</th><th>Nom</th><th>Description</th><th>Fichier</th><th class="num">Modifié</th><th></th></tr></thead>
                <tbody>
                    {% for asset in assets %}
                        <tr>
                            <td><span class="tag">{{ asset.kind.label }}</span></td>
                            <td><a href="{{ path('agent_asset_edit', {slug: project.slug, id: asset.id}) }}">{{ asset.name }}</a></td>
                            <td>{{ asset.description }}</td>
                            <td class="mono">{{ asset.path }}</td>
                            <td class="num">{{ asset.updatedAt|date('d/m/Y H:i') }}</td>
                            <td class="num">
                                <form method="post" action="{{ path('agent_asset_delete', {slug: project.slug, id: asset.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('agent-asset-' ~ asset.id) }}">
                                    <button class="button button--danger" type="submit" data-confirm="Supprimer {{ asset.name }} ?" data-confirm-label="Supprimer">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
