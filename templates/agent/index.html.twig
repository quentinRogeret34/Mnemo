{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.agent_assets'|trans }} · {{ project.name }}{% endblock %}

{% block crumbs %}
    <a href="{{ path('project_show', {slug: project.slug}) }}">{{ project.name }}</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__current">{{ 'nav.agent_assets'|trans }}</span>
{% endblock %}

{% block header_actions %}
    <form method="post" action="{{ path('agent_asset_propose', {slug: project.slug}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('agent-asset-propose-' ~ project.id) }}">
        <button class="button" type="submit"><twig:ux:icon name="lucide:refresh-cw" />{{ 'agent.propose'|trans }}</button>
    </form>
    <button class="button" type="button" commandfor="skill-draft" command="show-modal"><twig:ux:icon name="lucide:wand-sparkles" />{{ 'agent.draft'|trans }}</button>
    <a class="button button--primary" href="{{ path('agent_asset_new', {slug: project.slug}) }}"><twig:ux:icon name="lucide:plus" />{{ 'common.add'|trans }}</a>
{% endblock %}

{% block body %}
    <div class="view-head" data-tone="violet">
        <h1><twig:ux:icon name="lucide:graduation-cap" />{{ 'nav.agent_assets'|trans }}</h1>
        <span class="view-head__meta">{{ assets|length }}</span>
    </div>

    <dialog class="dialog dialog--form" id="skill-draft" closedby="any" aria-labelledby="skill-draft-title" data-controller="dialog" {{ draft.vars.submitted ? 'open' }}>
        <h2 class="dialog__title" id="skill-draft-title">{{ 'agent.draft'|trans }}</h2>
        <p class="row__sub">{{ 'agent.draft_text'|trans }}</p>
        {{ form_start(draft, {attr: {class: 'form-stack', novalidate: 'novalidate'}}) }}
            {{ form_row(draft.request, {attr: {class: 'input'}}) }}
            {{ form_row(draft.kind, {attr: {class: 'select'}}) }}
            <div class="dialog__actions">
                <button class="button" type="button" commandfor="skill-draft" command="close">{{ 'common.cancel'|trans }}</button>
                <button class="button button--primary" type="submit"><twig:ux:icon name="lucide:wand-sparkles" />{{ 'agent.draft_submit'|trans }}</button>
            </div>
        {{ form_end(draft) }}
    </dialog>

    {% if assets is empty %}
        <twig:EmptyState :title="'agent.empty'|trans" :text="'agent.empty_text'|trans">
            <twig:block name="icon"><twig:ux:icon name="lucide:graduation-cap" /></twig:block>
            <twig:block name="actions"><a class="button button--primary" href="{{ path('agent_asset_new', {slug: project.slug}) }}"><twig:ux:icon name="lucide:plus" />{{ 'common.add'|trans }}</a></twig:block>
        </twig:EmptyState>
    {% else %}
        <div class="table-wrap table-wrap--framed agent-table">
            <table class="data-table">
                <thead><tr><th scope="col">{{ 'form.agent_asset.kind'|trans }}</th><th scope="col">{{ 'form.agent_asset.name'|trans }}</th><th scope="col">{{ 'form.agent_asset.description'|trans }}</th><th scope="col">{{ 'document.props.file'|trans }}</th><th scope="col" class="num">{{ 'agent.updated'|trans }}</th><th scope="col"><span class="visually-hidden">{{ 'project.index.col.action'|trans }}</span></th></tr></thead>
                <tbody>
                    {% for asset in assets %}
                        <tr>
                            <td data-label="{{ 'form.agent_asset.kind'|trans }}"><span class="tag">{{ asset.kind|trans }}</span></td>
                            <td data-label="{{ 'form.agent_asset.name'|trans }}"><a href="{{ path('agent_asset_edit', {slug: project.slug, id: asset.id}) }}">{{ asset.name }}</a></td>
                            <td data-label="{{ 'form.agent_asset.description'|trans }}">{{ asset.description }}</td>
                            <td class="mono" data-label="{{ 'document.props.file'|trans }}">{{ asset.path }}</td>
                            <td class="num" data-label="{{ 'agent.updated'|trans }}">{{ asset.updatedAt|format_datetime('short', 'short') }}</td>
                            <td class="num">
                                <form method="post" action="{{ path('agent_asset_delete', {slug: project.slug, id: asset.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('agent-asset-' ~ asset.id) }}">
                                    <button class="button button--danger" type="submit" data-confirm="{{ 'agent.delete_confirm'|trans({name: asset.name}) }}" data-confirm-label="{{ 'common.delete'|trans }}">{{ 'common.delete'|trans }}</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
