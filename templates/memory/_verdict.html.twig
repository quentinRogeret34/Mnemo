{% set labels = {verified: 'verdict.verified', refuted: 'verdict.refuted', conflict: 'verdict.conflict', unverified: 'verdict.unverified'} %}
{% set icons = {verified: 'lucide:circle-check', refuted: 'lucide:circle-x', conflict: 'lucide:triangle-alert'} %}
{% if verdict %}<span class="verdict verdict--{{ verdict }}" title="{{ 'verdict.title'|trans }}">{{ ux_icon(icons[verdict] ?? 'lucide:circle-dashed') }}{{ (labels[verdict] ?? verdict)|trans }}</span>{% endif %}
