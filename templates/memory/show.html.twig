{% extends 'base.html.twig' %}

{% block title %}{{ 'form.memory.text'|trans }}{% endblock %}

{% block crumbs %}
    <a href="{{ path('memory_index') }}">{{ 'nav.memories'|trans }}</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__current">{{ memory.label }}</span>
{% endblock %}

{% block body %}
    {% set status = memory.metadata.status ?? 'active' %}
    <article class="page">
        {% if status != 'active' %}
            <p class="archived-banner" role="status">
                <strong>{{ (status == 'superseded' ? 'memory.show.superseded' : 'memory.show.retired')|trans }}</strong>
                {% for item in supersession.replaced_by %}{{ 'memory.show.by'|trans }} <a href="{{ path('memory_show', {id: item.id}) }}">{{ item.text }}</a>{{ not loop.last ? ', ' }}{% endfor %}
                <span class="row__sub">{{ 'memory.show.archived_text'|trans }}</span>
            </p>
        {% endif %}

        <twig:MemoryEditor :memory="memory" />

        {% if supersession.replaces is not empty %}
            <section class="block" aria-labelledby="replaces-title">
                <div class="block__head"><h2 id="replaces-title">{{ 'memory.show.replaces'|trans }}</h2><span class="block__count">{{ supersession.replaces|length }}</span></div>
                <ul class="list">
                    {% for item in supersession.replaces %}
                        <li><a class="row row--memory row--archived" href="{{ path('memory_show', {id: item.id}) }}"><span class="row__title"><span class="memory-text">{{ item.text }}</span></span></a></li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {% set visibility = memory.metadata.visibility ?? 'project' %}
        {% set current = visibility == 'group' ? 'group:' ~ (memory.metadata.group_id ?? '') : visibility %}
        <section class="block" aria-labelledby="visibility-title">
            <div class="block__head">
                <h2 id="visibility-title">{{ 'form.memory.visibility'|trans }}</h2>
                <span class="tag">{{ visibility == 'private' ? 'enum.memory_visibility.private'|trans : (visibility == 'group' ? 'memory.visibility.group'|trans({name: group ? group.name : 'memory.show.group_deleted'|trans}) : 'enum.memory_visibility.project'|trans) }}</span>
            </div>
            <form class="inline-form" method="post" action="{{ path('memory_visibility', {id: memory.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('visibility-memory-' ~ memory.id) }}">
                <label class="visually-hidden" for="visibility">{{ 'memory.show.who_sees'|trans }}</label>
                <select class="select" id="visibility" name="visibility">
                    {% for label, value in visibilities %}<option value="{{ value }}" {{ value == current ? 'selected' }}>{{ label }}</option>{% endfor %}
                </select>
                <button class="button" type="submit">{{ 'common.change'|trans }}</button>
                <span class="row__sub">{{ 'memory.show.visibility_help'|trans }}</span>
            </form>
        </section>

        {% set verification = memory.metadata.verification ?? null %}
        <section class="block" aria-labelledby="verification-title">
            <div class="block__head">
                <h2 id="verification-title">{{ 'memory.verification'|trans }}</h2>
                {% if verification %}{{ include('memory/_verdict.html.twig', {verdict: verification.verdict}) }}{% endif %}
            </div>
            {% if verification %}
                {% if verification.text != memory.label %}<p class="row__sub">{{ 'memory.show.text_changed'|trans }}</p>{% endif %}
                <p class="verification__reason">{{ verification.reason }}</p>
                {% if verification.sources is not empty %}
                    <p class="row__sub">{{ 'memory.show.sources'|trans }} {% for source in verification.sources %}{{ source.label }}{{ not loop.last ? ', ' }}{% endfor %}</p>
                {% endif %}
                <p class="row__sub">{{ ({graph: 'memory.show.tier_graph', knowledge: 'memory.show.tier_knowledge', none: 'memory.show.tier_none'}[verification.tier] ?? verification.tier)|trans }} · {{ verification.at|format_datetime('short', 'short') }}</p>
            {% else %}
                <p class="block__empty">{{ 'memory.show.never_verified'|trans }}</p>
            {% endif %}
            {% if status == 'active' %}
                <form class="inline-form" method="post" action="{{ path('memory_verify', {id: memory.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('verify-memory-' ~ memory.id) }}">
                    <button class="button" type="submit">{{ 'memory.show.verify'|trans }}</button>
                    <span class="row__sub">{{ 'memory.show.verify_help'|trans }}</span>
                </form>
            {% endif %}
        </section>

        <form class="danger-zone" method="post" action="{{ path('memory_delete', {id: memory.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-memory-' ~ memory.id) }}">
            <button class="button button--danger" type="submit" data-confirm="{{ 'memory.show.delete_confirm'|trans }}" data-confirm-label="{{ 'common.delete'|trans }}"><twig:ux:icon name="lucide:trash-2" />{{ 'memory.show.delete'|trans }}</button>
            <span class="row__sub">{{ 'memory.show.delete_help'|trans }}</span>
        </form>
    </article>
{% endblock %}
