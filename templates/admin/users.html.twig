{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.title'|trans }}{% endblock %}

{% block crumbs %}<span class="crumbs__current">{{ 'admin.title'|trans }}</span>{% endblock %}

{% block body %}
    {% set pending = users|filter(user => user.status.value == 'pending')|length %}
    <div class="view-head">
        <h1><twig:ux:icon name="lucide:users" />{{ 'nav.users'|trans }}</h1>
        <span class="view-head__meta">{{ users|length }}{% if pending > 0 %} · {{ 'proposal.pending'|trans({count: pending}) }}{% endif %}</span>
    </div>
    <p class="page__lede">{{ 'admin.lede'|trans }}</p>

    {% if users is empty %}
        <p class="block__empty">{{ 'admin.empty'|trans }}</p>
    {% else %}
        <ul class="admin-list">
            {% for user in users %}
                <li class="panel">
                    <form class="admin-row" method="post" action="{{ path('admin_user_update', {id: user.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin-user-' ~ user.id) }}">
                        <div class="admin-row__who">
                            <span class="row__title"><span>{{ user.name }}</span>{% if user.status.value == 'pending' %}<span class="tag tag--demo">{{ 'admin.pending'|trans }}</span>{% endif %}</span>
                            <span class="row__sub">{{ user.email }} · {{ user.provider }} · {{ user.lastLoginAt ? 'admin.seen'|trans({date: user.lastLoginAt|format_date('short')}) : 'admin.never'|trans }}</span>
                        </div>
                        <label class="visually-hidden" for="status-{{ user.id }}">{{ 'admin.status_of'|trans({name: user.name}) }}</label>
                        <select class="select" id="status-{{ user.id }}" name="status">
                            {% for status in enum_cases('App\\Enum\\UserStatus') %}<option value="{{ status.value }}" {{ user.status == status ? 'selected' }}>{{ status|trans }}</option>{% endfor %}
                        </select>
                        <label class="key-form__check"><input type="checkbox" name="super_admin" value="1" {{ user.superAdmin ? 'checked' }}> {{ 'admin.super_admin'|trans }}</label>
                        <fieldset class="key-form__projects">
                            <legend class="visually-hidden">{{ 'admin.groups_of'|trans({name: user.name}) }}</legend>
                            {% for group in groups %}
                                <label class="key-form__check"><input type="checkbox" name="groups[]" value="{{ group.id }}" {{ group.users.contains(user) ? 'checked' }}> {{ group.name }}</label>
                            {% else %}
                                <span class="row__sub">{{ 'admin.no_group'|trans }}</span>
                            {% endfor %}
                        </fieldset>
                        <button class="button {{ user.status.value == 'pending' ? 'button--primary' }}" type="submit">{{ 'common.save'|trans }}</button>
                    </form>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <section class="block" aria-labelledby="groups-title">
        <div class="block__head"><h2 id="groups-title">{{ 'admin.groups'|trans }}</h2><span class="block__count">{{ groups|length }}</span></div>
        <p class="row__sub">{{ 'admin.groups_help'|trans }}</p>
        <form class="inline-form admin-group-new" method="post" action="{{ path('admin_group_create') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('admin-group-create') }}">
            <label class="visually-hidden" for="group-name">{{ 'admin.group_name'|trans }}</label>
            <input class="input" id="group-name" type="text" name="name" maxlength="100" placeholder="{{ 'admin.group_placeholder'|trans }}" required>
            <button class="button" type="submit"><twig:ux:icon name="lucide:plus" />{{ 'admin.group_create'|trans }}</button>
        </form>
        <ul class="admin-list">
            {% for group in groups %}
                <li class="panel">
                    <form class="admin-row" method="post" action="{{ path('admin_group_update', {id: group.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin-group-' ~ group.id) }}">
                        <div class="admin-row__who">
                            <span class="row__title"><span>{{ group.name }}</span></span>
                            <span class="row__sub">{{ 'admin.members'|trans({count: group.users|length}) }}{% if group.users is not empty %} : {{ group.users|map(user => user.name)|join(', ') }}{% endif %}</span>
                        </div>
                        <fieldset class="key-form__projects">
                            <legend class="visually-hidden">{{ 'admin.group_projects'|trans({name: group.name}) }}</legend>
                            {% for project in projects %}
                                <label class="key-form__check"><input type="checkbox" name="projects[]" value="{{ project.slug }}" {{ group.projects.contains(project) ? 'checked' }}> {{ project.name }}</label>
                            {% else %}
                                <span class="row__sub">{{ 'nav.no_project'|trans }}</span>
                            {% endfor %}
                        </fieldset>
                        <button class="button" type="submit">{{ 'common.save'|trans }}</button>
                        <button class="button button--danger" type="submit" name="delete" value="1" data-confirm="{{ 'admin.group_delete_confirm'|trans({name: group.name}) }}" data-confirm-label="{{ 'common.delete'|trans }}"><twig:ux:icon name="lucide:trash-2" />{{ 'common.delete'|trans }}</button>
                    </form>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endblock %}
