{% extends 'base.html.twig' %}

{% block title %}{{ swarm.title }} — {{ 'factory.swarm.label'|trans }}{% endblock %}

{% block crumbs %}
    <a href="{{ path('project_show', {slug: project.slug}) }}">{{ project.name }}</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <a href="{{ path('project_factory', {slug: project.slug}) }}">{{ 'factory.title'|trans }}</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__current">{{ swarm.publicId }}</span>
{% endblock %}

{% block body %}
    <div class="view-head" data-tone="teal">
        <div>
            <h1>
                <twig:ux:icon name="lucide:network" />
                {{ swarm.title }}
            </h1>
            <p class="page__lede">
                <code>{{ swarm.publicId }}</code> ·
                <span class="factory-status factory-status--{{ swarm.status.value }}">{{ swarm.status|trans }}</span> ·
                <span class="tag">{{ swarm.strategy|trans }}</span> ·
                <span class="tag">{{ swarm.workerRunner|trans }}</span>
                {% if swarm.sourceRuleCode %}· <span class="tag tag--accent">{{ swarm.sourceRuleCode }}</span>{% endif %}
            </p>
        </div>
        <div class="view-head__actions">
            {% if swarm.status.value == 'awaiting_approval' %}
                <form method="post" action="{{ path('factory_swarm_approve', {publicId: swarm.publicId}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('factory_swarm_approve_' ~ swarm.publicId) }}">
                    <input type="hidden" name="run_sync" value="1">
                    <button class="button button--primary" type="submit">
                        <twig:ux:icon name="lucide:check" />
                        {{ 'factory.swarm.approve_and_run'|trans }}
                    </button>
                </form>
            {% elseif swarm.status.value in ['planning', 'running', 'reviewing'] %}
                <form method="post" action="{{ path('factory_swarm_control', {publicId: swarm.publicId}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('factory_swarm_control_' ~ swarm.publicId) }}">
                    <input type="hidden" name="action" value="run_now">
                    <button class="button button--primary" type="submit">
                        <twig:ux:icon name="lucide:refresh-cw" />
                        {{ 'factory.swarm.run_step_now'|trans }}
                    </button>
                </form>
            {% elseif swarm.status.value == 'paused' %}
                <form method="post" action="{{ path('factory_swarm_control', {publicId: swarm.publicId}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('factory_swarm_control_' ~ swarm.publicId) }}">
                    <input type="hidden" name="action" value="resume">
                    <button class="button button--primary" type="submit">{{ 'factory.swarm.resume'|trans }}</button>
                </form>
            {% endif %}

            {% if swarm.status.isActive %}
                {% if swarm.status.value != 'paused' %}
                    <form method="post" action="{{ path('factory_swarm_control', {publicId: swarm.publicId}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('factory_swarm_control_' ~ swarm.publicId) }}">
                        <input type="hidden" name="action" value="pause">
                        <button class="button" type="submit">{{ 'factory.swarm.pause'|trans }}</button>
                    </form>
                {% endif %}
                <form method="post" action="{{ path('factory_swarm_control', {publicId: swarm.publicId}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('factory_swarm_control_' ~ swarm.publicId) }}">
                    <input type="hidden" name="action" value="cancel">
                    <button class="button button--danger" type="submit">{{ 'common.cancel'|trans }}</button>
                </form>
            {% endif %}
        </div>
    </div>

    {% if not runner_available and swarm.status.isActive %}
        <div class="callout callout--warn">
            <strong>{{ 'factory.swarm.runner_unavailable_title'|trans }}</strong>
            <p>{{ 'factory.swarm.runner_unavailable_text'|trans({runner: swarm.workerRunner|trans}) }}</p>
        </div>
    {% endif %}

    <div class="factory-detail-grid">
        <div class="factory-detail-main">
            <section class="panel">
                <h2>{{ 'factory.show.goal'|trans }}</h2>
                <p class="factory-goal">{{ swarm.goal }}</p>
            </section>

            {% if swarm.reviewSummary %}
                <section class="callout callout--info">
                    <strong>{{ 'factory.swarm.review_title'|trans }}</strong>
                    <div class="prose">{{ swarm.reviewSummary|markdown_to_html }}</div>
                </section>
            {% endif %}

            <section class="panel">
                <h2>{{ 'factory.swarm.plan_title'|trans }} ({{ swarm.plan|length }})</h2>
                {% if swarm.plan is empty %}
                    <p class="help-text">{{ 'factory.swarm.plan_pending'|trans }}</p>
                {% else %}
                    <ol class="swarm-plan-list">
                        {% for task in swarm.plan %}
                            <li class="swarm-plan-item">
                                <div class="swarm-plan-item__head">
                                    <strong>{{ task.title }}</strong>
                                    <span class="tag">{{ task.role }}</span>
                                    <code class="code-chip">{{ task.slug }}</code>
                                </div>
                                <p class="factory-goal">{{ task.instructions }}</p>
                                {% if task.files_hint is not empty %}
                                    <div class="factory-context-chips">
                                        {% for file in task.files_hint %}
                                            <code class="code-chip">{{ file }}</code>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ol>
                {% endif %}
            </section>

            <section class="panel">
                <h2>{{ 'factory.swarm.workers_title'|trans }} ({{ workers|length }})</h2>
                {% if workers is empty %}
                    <p class="help-text">{{ 'factory.swarm.workers_pending'|trans }}</p>
                {% else %}
                    <ul class="list">
                        {% for worker in workers %}
                            <li>
                                <a class="row" href="{{ path('factory_session_show', {publicId: worker.publicId}) }}">
                                    <span class="row__title">
                                        {{ worker.title }}
                                        <span class="row__sub">
                                            {{ worker.role }}
                                            {% if worker.branch %}· <code>{{ worker.branch }}</code>{% endif %}
                                            · {{ worker.filesTouched|length }} {{ 'factory.col.files'|trans|lower }}
                                        </span>
                                    </span>
                                    <span class="factory-status factory-status--{{ worker.status.value }}">{{ worker.status|trans }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>

            <section class="panel">
                <h2>{{ 'factory.swarm.board_title'|trans }} ({{ messages|length }})</h2>
                <ol class="factory-timeline">
                    {% for msg in messages %}
                        <li class="factory-timeline__item swarm-msg--{{ msg.kind.value }}">
                            <div class="factory-timeline__head">
                                <span>
                                    <strong>{{ msg.author }}</strong>
                                    <span class="tag">{{ msg.kind|trans }}</span>
                                </span>
                                <time class="row__sub" datetime="{{ msg.createdAt|date('c') }}">{{ msg.createdAt|date('d/m/Y H:i:s') }}</time>
                            </div>
                            <p class="factory-timeline__msg">{{ msg.body }}</p>
                        </li>
                    {% endfor %}
                </ol>

                <form method="post" action="{{ path('factory_swarm_message', {publicId: swarm.publicId}) }}" class="form-stack swarm-reply-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('factory_swarm_message_' ~ swarm.publicId) }}">
                    <label>
                        {{ 'factory.swarm.board_reply_label'|trans }}
                        <textarea class="input" name="body" rows="2" required placeholder="{{ 'factory.swarm.board_reply_placeholder'|trans }}"></textarea>
                    </label>
                    <div>
                        <button class="button button--primary" type="submit">{{ 'factory.swarm.board_reply_submit'|trans }}</button>
                    </div>
                </form>
            </section>
        </div>

        <aside class="factory-detail-aside">
            <section class="panel">
                <h2>{{ 'factory.show.metadata'|trans }}</h2>
                <dl class="props">
                    <dt>{{ 'factory.col.project'|trans }}</dt>
                    <dd><a class="link" href="{{ path('project_show', {slug: project.slug}) }}">{{ project.name }}</a></dd>
                    <dt>{{ 'factory.col.status'|trans }}</dt>
                    <dd><span class="factory-status factory-status--{{ swarm.status.value }}">{{ swarm.status|trans }}</span></dd>
                    <dt>{{ 'factory.swarm.strategy'|trans }}</dt>
                    <dd>{{ swarm.strategy|trans }}</dd>
                    <dt>{{ 'factory.swarm.worker_runner'|trans }}</dt>
                    <dd>{{ swarm.workerRunner|trans }}</dd>
                    <dt>Git worktree</dt>
                    <dd>{{ is_git_repo ? 'factory.swarm.worktree_ready'|trans : 'factory.swarm.worktree_no_git'|trans }}</dd>
                    {% if swarm.baseBranch %}
                        <dt>{{ 'factory.swarm.base_branch'|trans }}</dt>
                        <dd><code class="code-chip">{{ swarm.baseBranch }}</code></dd>
                    {% endif %}
                    {% if swarm.coordinatorSession %}
                        <dt>{{ 'factory.swarm.coordinator_session'|trans }}</dt>
                        <dd><a class="link" href="{{ path('factory_session_show', {publicId: swarm.coordinatorSession.publicId}) }}">{{ swarm.coordinatorSession.publicId }}</a></dd>
                    {% endif %}
                    <dt>{{ 'factory.col.started'|trans }}</dt>
                    <dd>{{ swarm.createdAt|date('d/m/Y H:i:s') }}</dd>
                    {% if swarm.finishedAt %}
                        <dt>{{ 'factory.show.finished_at'|trans }}</dt>
                        <dd>{{ swarm.finishedAt|date('d/m/Y H:i:s') }}</dd>
                    {% endif %}
                </dl>
            </section>
        </aside>
    </div>
{% endblock %}
