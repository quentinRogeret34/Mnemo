{% extends 'base.html.twig' %}

{% set meta = rule.metadata %}
{% set origins = {human: 'document.props.human'|trans, llm: 'LLM', ast: 'AST', git: 'git', api: 'API'} %}

{% block title %}{{ rule.externalId }} · {{ project.name }}{% endblock %}

{% block crumbs %}
    <a href="{{ path('rule_index', {slug: project.slug}) }}">{{ 'nav.rules'|trans }}</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__current">{{ rule.externalId }}</span>
{% endblock %}

{% block body %}
    <article class="page">
        <div class="page__icon"><span class="code-chip">{{ rule.externalId }}</span></div>
        <h1 class="page__title">{{ rule.label }}</h1>

        <dl class="props">
            <dt>{{ 'memory.index.status'|trans }}</dt>
            <dd>
                <span class="status status--{{ meta.status ?? '' }}">{{ ((meta.status ?? '') == 'validated' ? 'rule.validated' : 'nav.to_review')|trans }}</span>
                <form method="post" action="{{ path('rule_status', {slug: project.slug, code: rule.externalId}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('rule-shadow-' ~ rule.id) }}">
                    <input type="hidden" name="status" value="{{ (meta.status ?? '') == 'validated' ? 'to_review' : 'validated' }}">
                    <button class="button" type="submit">{{ ((meta.status ?? '') == 'validated' ? 'rule.show.unvalidate' : 'rule.show.validate')|trans }}</button>
                </form>
            </dd>
            <dt>{{ 'rule.show.sources'|trans }}</dt>
            <dd>{% for source in sources %}<a class="tag" href="{{ path('document_show', {id: source.id}) }}"><span class="format format--{{ source.format }}">{{ source.format }}</span>{{ source.title }}</a>{% else %}<span class="row__sub">{{ 'document.props.none'|trans }}</span>{% endfor %}</dd>
            <dt>{{ 'document.props.linked_code'|trans }}</dt><dd>{{ 'project.index.files'|trans({count: implementations|length}) }}</dd>
            {% if meta.demo ?? false %}<dt>{{ 'document.props.origin'|trans }}</dt><dd><span class="tag tag--demo">{{ 'common.demo'|trans }}</span></dd>{% endif %}
        </dl>

        {% if meta.statement ?? null %}
            <blockquote class="callout"><span class="callout__mark" aria-hidden="true"></span><p>{{ meta.statement }}</p></blockquote>
        {% endif %}

        <section class="block" aria-labelledby="impl-title">
            <div class="block__head"><h2 id="impl-title">{{ 'rule.show.implemented_by'|trans }}</h2><span class="block__count">{{ implementations|length }}</span></div>
            {% if implementations is empty %}
                <p class="block__empty">{{ 'rule.show.no_file'|trans }}</p>
            {% else %}
                <ul class="list">
                    {% for impl in implementations %}
                        {% set parts = impl.path|split('/') %}
                        <li>
                            <a class="row" href="{{ path('file_show', {slug: project.slug, path: impl.path}) }}">
                                <twig:ux:icon name="lucide:code" class="icon nav-item__icon" />
                                <span class="row__title mono"><span>{{ parts|last }}</span><span class="row__sub">{{ parts|slice(0, -1)|join('/') }}</span></span>
                                <span class="row__meta">
                                    <span>{{ origins[impl.origin] ?? impl.origin }}</span>
                                    <span class="conf conf--{{ impl.confidence|lower }}">{{ impl.confidence }}</span>
                                </span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <section class="block" aria-labelledby="sources-title">
            <div class="block__head"><h2 id="sources-title">{{ 'rule.source_documents'|trans }}</h2><span class="block__count">{{ sources|length }}</span></div>
            {% if sources is empty %}
                <p class="block__empty">{{ 'rule.show.no_document'|trans }}</p>
            {% else %}
                <ul class="list">
                    {% for source in sources %}
                        <li>
                            <a class="row" href="{{ path('document_show', {id: source.id}) }}">
                                <span class="format format--{{ source.format }}">{{ source.format }}</span>
                                <span class="row__title"><span>{{ source.title }}</span></span>
                                <span class="row__meta">
                                    <span>{{ origins[source.origin] ?? source.origin }}</span>
                                    <span class="conf conf--{{ source.confidence|lower }}">{{ source.confidence }}</span>
                                </span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        {% if mentions is not empty %}
            <section class="block" aria-labelledby="mentions-title">
                <div class="block__head"><h2 id="mentions-title">{{ 'rule.show.mentions'|trans }}</h2><span class="block__count">{{ mentions|length }}</span></div>
                <ul class="list">
                    {% for mention in mentions %}
                        <li class="row row--commit">
                            <a class="code-chip" href="{{ mention.url }}" rel="noopener noreferrer" target="_blank">{{ mention.type == 'commit' ? mention.ref|slice(0, 7) : mention.ref }}</a>
                            <span class="row__title"><span>{{ mention.label }}</span>{% if mention.state %}<span class="tag">{{ mention.state }}</span>{% endif %}</span>
                            <span class="row__meta"><span>{{ mention.author }}</span><span class="num">{{ mention.date ? mention.date|format_date('short') }}</span></span>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {% set areas = meta.shadow_areas ?? [] %}
        <section class="block" aria-labelledby="shadow-title">
            <div class="block__head"><h2 id="shadow-title">{{ 'rule.show.shadow'|trans }}</h2><span class="block__count">{{ areas|length }}</span></div>
            {% if meta.shadow_checked_at is not defined %}
                <p class="block__empty">{{ 'rule.show.never_analysed'|trans }}</p>
            {% elseif areas is empty %}
                <p class="block__empty">{{ 'flash.rule.shadow_areas'|trans({count: 0}) }}</p>
            {% else %}
                <ul class="shadow-areas">
                    {% for area in areas %}
                        <li class="shadow-area shadow-area--{{ area.severity }}">
                            <div class="shadow-area__head">
                                <span class="code-chip">{{ (categories[area.category] ?? area.category)|trans }}</span>
                                <span class="shadow-area__severity">{{ ({blocker: 'rule.show.blocker', major: 'rule.show.major', minor: 'rule.show.minor'}[area.severity] ?? area.severity)|trans }}</span>
                            </div>
                            <p class="shadow-area__gap">{{ area.gap }}</p>
                            {% if area.question %}<p class="shadow-area__question">{{ area.question }}</p>{% endif %}
                            <form method="post" action="{{ path('rule_shadow_resolve', {slug: project.slug, code: rule.externalId, index: loop.index0}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('rule-shadow-' ~ rule.id) }}">
                                <button class="button" type="submit">{{ 'rule.show.resolved'|trans }}</button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
            <form class="inline-form" method="post" action="{{ path('rule_shadow', {slug: project.slug, code: rule.externalId}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('rule-shadow-' ~ rule.id) }}">
                <button class="button" type="submit">{{ (meta.shadow_checked_at is defined ? 'rule.show.reanalyse' : 'rule.show.analyse')|trans }}</button>
                {% if meta.shadow_checked_at is defined %}<span class="row__sub">{{ 'rule.show.last_analysis'|trans({date: meta.shadow_checked_at|format_datetime('short', 'short')}) }}</span>{% endif %}
            </form>
        </section>

        {{ include('memory/_about.html.twig', {memories: memories}) }}
    </article>
{% endblock %}
