{% extends 'base.html.twig' %}

{% set meta = rule.metadata %}
{% set origins = {human: 'humain', llm: 'LLM', ast: 'AST', git: 'git', api: 'API'} %}

{% block title %}{{ rule.externalId }} · {{ project.name }}{% endblock %}

{% block crumbs %}
    <a href="{{ path('rule_index', {slug: project.slug}) }}">Règles métier</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__current">{{ rule.externalId }}</span>
{% endblock %}

{% block body %}
    <article class="page">
        <div class="page__icon"><span class="code-chip">{{ rule.externalId }}</span></div>
        <h1 class="page__title">{{ rule.label }}</h1>

        <dl class="props">
            <dt>Statut</dt><dd><span class="status status--{{ meta.status ?? '' }}">{{ (meta.status ?? '') == 'validated' ? 'Validée' : 'À valider' }}</span></dd>
            <dt>Sources</dt>
            <dd>{% for source in sources %}<a class="tag" href="{{ path('document_show', {id: source.id}) }}"><span class="format format--{{ source.format }}">{{ source.format }}</span>{{ source.title }}</a>{% else %}<span class="row__sub">aucune</span>{% endfor %}</dd>
            <dt>Code lié</dt><dd>{{ implementations|length }} fichiers</dd>
            {% if meta.demo ?? false %}<dt>Origine</dt><dd><span class="tag tag--demo">Démo</span></dd>{% endif %}
        </dl>

        {% if meta.statement ?? null %}
            <blockquote class="callout"><span class="callout__mark" aria-hidden="true"></span><p>{{ meta.statement }}</p></blockquote>
        {% endif %}

        <section class="block" aria-labelledby="impl-title">
            <div class="block__head"><h2 id="impl-title">Implémentée par</h2><span class="block__count">{{ implementations|length }}</span></div>
            {% if implementations is empty %}
                <p class="block__empty">Aucun fichier de code relié à cette règle.</p>
            {% else %}
                <ul class="list">
                    {% for impl in implementations %}
                        {% set parts = impl.path|split('/') %}
                        <li>
                            <a class="row" href="{{ path('file_show', {slug: project.slug, path: impl.path}) }}">
                                <svg class="nav-item__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5.5 4.5L2 8l3.5 3.5M10.5 4.5L14 8l-3.5 3.5"/></svg>
                                <span class="row__title mono"><span>{{ parts|last }}</span><span class="row__sub">{{ parts|slice(0, -1)|join('/') }}</span></span>
                                <span class="row__meta">
                                    <span>{{ origins[impl.origin] ?? impl.origin }}</span>
                                    <span class="conf conf--{{ impl.confidence|lower }}">{{ impl.confidence }}</span>
                                </span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <section class="block" aria-labelledby="sources-title">
            <div class="block__head"><h2 id="sources-title">Documents sources</h2><span class="block__count">{{ sources|length }}</span></div>
            {% if sources is empty %}
                <p class="block__empty">Aucun document ne définit cette règle.</p>
            {% else %}
                <ul class="list">
                    {% for source in sources %}
                        <li>
                            <a class="row" href="{{ path('document_show', {id: source.id}) }}">
                                <span class="format format--{{ source.format }}">{{ source.format }}</span>
                                <span class="row__title"><span>{{ source.title }}</span></span>
                                <span class="row__meta">
                                    <span>{{ origins[source.origin] ?? source.origin }}</span>
                                    <span class="conf conf--{{ source.confidence|lower }}">{{ source.confidence }}</span>
                                </span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        {% if mentions is not empty %}
            <section class="block" aria-labelledby="mentions-title">
                <div class="block__head"><h2 id="mentions-title">Citée dans l'historique</h2><span class="block__count">{{ mentions|length }}</span></div>
                <ul class="list">
                    {% for mention in mentions %}
                        <li class="row row--commit">
                            <a class="code-chip" href="{{ mention.url }}" rel="noopener noreferrer" target="_blank">{{ mention.type == 'commit' ? mention.ref|slice(0, 7) : mention.ref }}</a>
                            <span class="row__title"><span>{{ mention.label }}</span>{% if mention.state %}<span class="tag">{{ mention.state }}</span>{% endif %}</span>
                            <span class="row__meta"><span>{{ mention.author }}</span><span class="num">{{ mention.date ? mention.date|date('d/m/Y') }}</span></span>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {% set areas = meta.shadow_areas ?? [] %}
        <section class="block" aria-labelledby="shadow-title">
            <div class="block__head"><h2 id="shadow-title">Zones d'ombre</h2><span class="block__count">{{ areas|length }}</span></div>
            {% if meta.shadow_checked_at is not defined %}
                <p class="block__empty">Jamais analysée : ce que la règle laisse deviner au développeur (hypothèses, termes ambigus, cas limites...).</p>
            {% elseif areas is empty %}
                <p class="block__empty">Aucune zone d'ombre trouvée.</p>
            {% else %}
                <ul class="shadow-areas">
                    {% for area in areas %}
                        <li class="shadow-area shadow-area--{{ area.severity }}">
                            <div class="shadow-area__head">
                                <span class="code-chip">{{ categories[area.category] ?? area.category }}</span>
                                <span class="shadow-area__severity">{{ {blocker: 'Bloquant', major: 'Majeur', minor: 'Mineur'}[area.severity] ?? area.severity }}</span>
                            </div>
                            <p class="shadow-area__gap">{{ area.gap }}</p>
                            {% if area.question %}<p class="shadow-area__question">{{ area.question }}</p>{% endif %}
                            <form method="post" action="{{ path('rule_shadow_resolve', {slug: project.slug, code: rule.externalId, index: loop.index0}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('rule-shadow-' ~ rule.id) }}">
                                <button class="button" type="submit">Résolue</button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
            <form class="inline-form" method="post" action="{{ path('rule_shadow', {slug: project.slug, code: rule.externalId}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('rule-shadow-' ~ rule.id) }}">
                <button class="button" type="submit">{{ meta.shadow_checked_at is defined ? 'Réanalyser' : 'Analyser' }}</button>
                {% if meta.shadow_checked_at is defined %}<span class="row__sub">Dernière analyse le {{ meta.shadow_checked_at|date('d/m/Y H:i') }} ; réanalyser remplace la liste.</span>{% endif %}
            </form>
        </section>

        {{ include('memory/_about.html.twig', {memories: memories}) }}
    </article>
{% endblock %}
