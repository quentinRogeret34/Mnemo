{% extends 'base.html.twig' %}

{% block title %}Règles métier · {{ project.name }}{% endblock %}

{% block crumbs %}
    <a href="{{ path('project_show', {slug: project.slug}) }}">{{ project.name }}</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__current">Règles métier</span>
{% endblock %}

{% block body %}
    <div class="view-head">
        <h1><twig:ux:icon name="lucide:clipboard-check" />Règles métier</h1>
        <span class="view-head__meta">{{ rules.total }}</span>
    </div>

    <nav class="tabs" aria-label="Filtrer par statut">
        <a href="{{ path('rule_index', {slug: project.slug}) }}" {% if status is null %}aria-current="page"{% endif %}>Toutes</a>
        <a href="{{ path('rule_index', {slug: project.slug, status: 'to_review'}) }}" {% if status == 'to_review' %}aria-current="page"{% endif %}>À valider</a>
        <a href="{{ path('rule_index', {slug: project.slug, status: 'validated'}) }}" {% if status == 'validated' %}aria-current="page"{% endif %}>Validées</a>
    </nav>

    {% if rules.items is empty %}
        {% if status %}
            <p class="block__empty">Aucune règle dans ce statut.</p>
        {% else %}
            <twig:EmptyState title="Aucune règle métier" text="Les règles viennent de l'extraction des documents métier du projet.">
                <twig:block name="icon"><twig:ux:icon name="lucide:clipboard-check" /></twig:block>
                <twig:block name="actions"><a class="button" href="{{ path('project_show', {slug: project.slug}) }}"><twig:ux:icon name="lucide:upload" />Déposer des documents</a></twig:block>
            </twig:EmptyState>
        {% endif %}
    {% else %}
        <ul class="list">
            {% for rule in rules.items %}
                <li>
                    <a class="row" href="{{ path('rule_show', {slug: project.slug, code: rule.code}) }}">
                        <span class="code-chip">{{ rule.code }}</span>
                        <span class="row__title">
                            <span>{{ rule.title }}</span>
                            {% if rule.demo %}<span class="tag tag--demo">Démo</span>{% endif %}
                        </span>
                        <span class="row__meta">
                            <span class="status status--{{ rule.status }}">{{ rule.status == 'validated' ? 'Validée' : 'À valider' }}</span>
                            {% if rule.shadow_areas > 0 %}<span title="Zones d'ombre à lever avec le métier">{{ rule.shadow_areas }} zones d'ombre</span>{% endif %}
                            <span title="Documents sources">{{ rule.documents }} doc.</span>
                            <span title="Fichiers liés, dont vérifiés">{{ rule.files }} fichiers · {{ rule.verified_files }} vérifiés</span>
                        </span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    {{ include('_pager.html.twig', {page: rules}) }}
{% endblock %}
