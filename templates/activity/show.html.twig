{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.activity'|trans }}{{ project ? ' · ' ~ project.name }}{% endblock %}

{% block crumbs %}
    {% if project %}
        <a href="{{ path('project_show', {slug: project.slug}) }}">{{ project.name }}</a>
        <span class="crumbs__sep" aria-hidden="true">/</span>
    {% endif %}
    <span class="crumbs__current">{{ 'nav.activity'|trans }}</span>
{% endblock %}

{% block body %}
    {% set scope = project ? {project: project.slug} : {} %}
    {% set period_labels = {'1d': 'period.24h', '7d': 'period.7d', '30d': 'period.30d'} %}
    {% set type_labels = {commit: 'activity.type.commit', ticket: 'activity.type.ticket', document: 'nav.documents', memory: 'nav.memories', business_rule: 'nav.rules'} %}
    <div class="view-head" data-tone="teal">
        <h1><twig:ux:icon name="lucide:activity" />{{ 'nav.activity'|trans }}</h1>
        <span class="view-head__meta">{{ project ? project.name : 'nav.all_projects'|trans }}</span>
    </div>

    <div class="filter-bar">
        <nav class="tabs" aria-label="{{ 'period.label'|trans }}">
            {% for item in periods %}
                <a href="{{ path('activity', scope|merge({period: item})) }}" {% if item == period %}aria-current="page"{% endif %}>{{ period_labels[item]|trans }}</a>
            {% endfor %}
        </nav>
    </div>

    {% set type_icons = {commit: 'lucide:git-commit-horizontal', ticket: 'lucide:git-pull-request', document: 'lucide:file-text', memory: 'lucide:lightbulb', business_rule: 'lucide:scale'} %}
    {% if counts is not empty %}
        <section class="kpis" aria-label="{{ 'activity.by_type'|trans }}">
            {% for count in counts %}
                <div class="kpi">
                    <span class="kpi__label">{{ ux_icon(type_icons[count.label] ?? 'lucide:circle') }}{{ (type_labels[count.label] ?? count.label)|trans }}</span>
                    <span class="kpi__value">{{ count.value|format_number }}</span>
                </div>
            {% endfor %}
        </section>
    {% endif %}

    {% set scoped = app.user and not is_granted('ROLE_SUPER_ADMIN') %}
    <section class="activity-block" aria-labelledby="runs-title">
        <div class="activity-block__head">
            <h2 id="runs-title">{{ 'activity.runs'|trans }}</h2>
            {% if not scoped %}<a class="button" href="{{ path('connector_index') }}">{{ 'project.settings.connectors'|trans }}</a>{% endif %}
        </div>
        {% if runs.items is empty %}
            <p class="block__empty">{{ 'activity.no_run'|trans({worker: '<span class="mono">worker</span>'})|raw }}</p>
        {% else %}
            <ul class="runs">
                {% for run in runs.items %}
                    {% set failed = run.report.error ?? null %}
                    <li class="run{{ failed ? ' run--failed' }}">
                        <div class="run__main">
                            <p class="run__title">
                                <strong>{{ run.connector }}</strong>
                                {% if failed %}<span class="pill pill--danger" title="{{ failed }}">{{ 'common.failed'|trans }}</span>{% else %}<span class="pill pill--success">{{ 'dashboard.ok'|trans }}</span>{% endif %}
                            </p>
                            <p class="run__meta">
                                <span class="run__trigger">{{ ({schedule: 'activity.trigger_schedule', webhook: 'activity.trigger_webhook'}[run.trigger] ?? 'activity.trigger_manual')|trans }}</span>
                                <span>{{ 'activity.run_counts'|trans({created: run.report.created ?? 0, updated: run.report.updated ?? 0}) }}</span>
                                <span class="num">{{ run.started_at|format_datetime('medium', 'short') }}</span>
                            </p>
                            {% if failed %}<p class="run__error">{{ failed }}</p>{% endif %}
                        </div>
                        {% if not scoped %}<a class="button" href="{{ path('connector_show', {id: run.connector_id}) }}">{{ 'activity.details'|trans }}{{ ux_icon('lucide:chevron-right') }}</a>{% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        {{ include('_pager.html.twig', {page: runs, name: 'runs'}) }}
    </section>

    <section class="activity-block" aria-labelledby="feed-title">
        <div class="activity-block__head"><h2 id="feed-title">{{ 'activity.feed'|trans }}</h2></div>
        {% if feed.days is empty %}
            <twig:EmptyState :title="'activity.empty'|trans" :text="'activity.empty_text'|trans">
                <twig:block name="icon"><twig:ux:icon name="lucide:activity" /></twig:block>
            </twig:EmptyState>
        {% else %}
            {{ include('activity/_feed.html.twig', {days: feed.days}) }}
            {% if feed.total > 10 %}
                <div class="pager"><a class="button" href="{{ path('activity_feed', scope|merge({period: period})) }}">{{ 'activity.see_more'|trans({count: feed.total}) }}</a></div>
            {% endif %}
        {% endif %}
    </section>
{% endblock %}
