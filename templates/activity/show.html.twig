{% extends 'base.html.twig' %}

{% block title %}Activité{{ project ? ' · ' ~ project.name }}{% endblock %}

{% block crumbs %}
    {% if project %}
        <a href="{{ path('project_show', {slug: project.slug}) }}">{{ project.name }}</a>
        <span class="crumbs__sep" aria-hidden="true">/</span>
    {% endif %}
    <span class="crumbs__current">Activité</span>
{% endblock %}

{% block body %}
    {% set scope = project ? {project: project.slug} : {} %}
    {% set period_labels = {'1d': '24 h', '7d': '7 j', '30d': '30 j'} %}
    {% set type_labels = {commit: 'Commits', ticket: 'PR, MR et issues', document: 'Documents', memory: 'Mémoires', business_rule: 'Règles métier'} %}
    {% set kinds = {commit: 'commit', document: 'document', memory: 'mémoire', business_rule: 'règle'} %}
    <div class="view-head">
        <h1>Activité</h1>
        <span class="view-head__meta">{{ project ? project.name : 'Tous les projets' }}</span>
    </div>
    <p class="page__lede">Ce qui est entré dans le graphe : le travail récupéré par les connecteurs, les documents déposés et les mémoires ajoutées.</p>

    <div class="filter-bar">
        <nav class="tabs" aria-label="Période">
            {% for item in periods %}
                <a href="{{ path('activity', scope|merge({period: item})) }}" {% if item == period %}aria-current="page"{% endif %}>{{ period_labels[item] }}</a>
            {% endfor %}
        </nav>
    </div>

    {% if counts is not empty %}
        <section class="tiles" aria-label="Entrées par type">
            {% for count in counts %}
                <div class="tile"><span class="tile__label">{{ type_labels[count.label] ?? count.label }}</span><span class="tile__value">{{ count.value|number_format(0, ',', ' ') }}</span></div>
            {% endfor %}
        </section>
    {% endif %}

    <div class="panels">
        <section class="panel" aria-labelledby="feed-title">
            <div class="panel__head"><h2 id="feed-title">Fil</h2></div>
            {% for day, items in days %}
                <h3 class="block__sub">{{ day|date('d/m/Y') }} <span class="block__count">{{ items|length }}</span></h3>
                <ul class="list">
                    {% for item in items %}
                        {% set href = item.type == 'memory' ? path('memory_show', {id: item.id})
                            : (item.type == 'document' ? path('document_show', {id: item.id})
                            : (item.type == 'business_rule' and item.project_slug ? path('rule_show', {slug: item.project_slug, code: item.ref}) : item.url)) %}
                        <li class="row row--commit">
                            <span class="code-chip">{{ item.type == 'ticket' ? item.ref : (item.type == 'commit' ? item.ref|slice(0, 7) : kinds[item.type]) }}</span>
                            <span class="row__title">{% if href %}<a href="{{ href }}" {% if item.type in ['commit', 'ticket'] %}rel="noopener noreferrer" target="_blank"{% endif %}><span class="memory-text">{{ item.label }}</span></a>{% else %}<span class="memory-text">{{ item.label }}</span>{% endif %}</span>
                            <span class="row__meta"><span>{{ item.author }}</span><span class="num">{{ item.created_at|date('H:i') }}</span></span>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="block__empty">Rien n'est entré dans le graphe sur la période.</p>
            {% endfor %}
        </section>

        <section class="panel" aria-labelledby="runs-title">
            <div class="panel__head"><h2 id="runs-title">Synchronisations</h2><a class="button" href="{{ path('connector_index') }}">Connecteurs</a></div>
            {% if runs is empty %}
                <p class="block__empty">Aucune synchronisation. Un connecteur se lance à la main, ou seul s'il est planifié et que le service <span class="mono">worker</span> tourne.</p>
            {% else %}
                <div class="table-wrap">
                    <table class="data-table">
                        <thead><tr><th>Quand</th><th>Connecteur</th><th>Déclencheur</th><th class="num">Créés</th><th class="num">Modifiés</th><th>État</th></tr></thead>
                        <tbody>
                            {% for run in runs %}
                                <tr>
                                    <td class="num">{{ run.started_at|date('d/m H:i') }}</td>
                                    <td><a href="{{ path('connector_show', {id: run.connector_id}) }}">{{ run.connector }}</a></td>
                                    <td>{{ run.trigger == 'schedule' ? 'planifié' : 'manuel' }}</td>
                                    <td class="num">{{ run.report.created ?? 0 }}</td>
                                    <td class="num">{{ run.report.updated ?? 0 }}</td>
                                    <td>{% if run.report.error ?? null %}<span class="verdict verdict--refuted" title="{{ run.report.error }}">échec</span>{% else %}<span class="verdict verdict--verified">ok</span>{% endif %}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}
