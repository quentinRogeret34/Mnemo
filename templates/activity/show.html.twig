{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.activity'|trans }}{{ project ? ' · ' ~ project.name }}{% endblock %}

{% block crumbs %}
    {% if project %}
        <a href="{{ path('project_show', {slug: project.slug}) }}">{{ project.name }}</a>
        <span class="crumbs__sep" aria-hidden="true">/</span>
    {% endif %}
    <span class="crumbs__current">{{ 'nav.activity'|trans }}</span>
{% endblock %}

{% block body %}
    {% set scope = project ? {project: project.slug} : {} %}
    {% set period_labels = {'1d': 'period.24h', '7d': 'period.7d', '30d': 'period.30d'} %}
    {% set type_labels = {commit: 'activity.type.commit', ticket: 'activity.type.ticket', document: 'nav.documents', memory: 'nav.memories', business_rule: 'nav.rules'} %}
    <div class="view-head">
        <h1><twig:ux:icon name="lucide:activity" />{{ 'nav.activity'|trans }}</h1>
        <span class="view-head__meta">{{ project ? project.name : 'nav.all_projects'|trans }}</span>
    </div>
    <p class="page__lede">{{ 'activity.lede'|trans }}</p>

    <div class="filter-bar">
        <nav class="tabs" aria-label="{{ 'period.label'|trans }}">
            {% for item in periods %}
                <a href="{{ path('activity', scope|merge({period: item})) }}" {% if item == period %}aria-current="page"{% endif %}>{{ period_labels[item]|trans }}</a>
            {% endfor %}
        </nav>
    </div>

    {% if counts is not empty %}
        <section class="tiles" aria-label="{{ 'activity.by_type'|trans }}">
            {% for count in counts %}
                <div class="tile"><span class="tile__label">{{ (type_labels[count.label] ?? count.label)|trans }}</span><span class="tile__value">{{ count.value|format_number }}</span></div>
            {% endfor %}
        </section>
    {% endif %}

    <div class="panels">
        <section class="panel" aria-labelledby="feed-title">
            <div class="panel__head"><h2 id="feed-title">{{ 'activity.feed'|trans }}</h2></div>
            {% if feed.days is empty %}
                <twig:EmptyState :title="'activity.empty'|trans" :text="'activity.empty_text'|trans">
                    <twig:block name="icon"><twig:ux:icon name="lucide:activity" /></twig:block>
                </twig:EmptyState>
            {% else %}
                {{ include('activity/_feed.html.twig', {days: feed.days}) }}
                {% if feed.total > 10 %}
                    <div class="pager"><a class="button" href="{{ path('activity_feed', scope|merge({period: period})) }}">{{ 'activity.see_more'|trans({count: feed.total}) }}</a></div>
                {% endif %}
            {% endif %}
        </section>

        <section class="panel" aria-labelledby="runs-title">
            <div class="panel__head"><h2 id="runs-title">{{ 'activity.runs'|trans }}</h2><a class="button" href="{{ path('connector_index') }}">{{ 'project.settings.connectors'|trans }}</a></div>
            {% if runs.items is empty %}
                <p class="block__empty">{{ 'activity.no_run'|trans({worker: '<span class="mono">worker</span>'})|raw }}</p>
            {% else %}
                <div class="table-wrap">
                    <table class="data-table">
                        <thead><tr><th>{{ 'activity.when'|trans }}</th><th>{{ 'activity.connector'|trans }}</th><th>{{ 'activity.trigger'|trans }}</th><th class="num">{{ 'activity.created'|trans }}</th><th class="num">{{ 'activity.updated'|trans }}</th><th>{{ 'activity.state'|trans }}</th></tr></thead>
                        <tbody>
                            {% for run in runs.items %}
                                <tr>
                                    <td class="num">{{ run.started_at|format_datetime('short', 'short') }}</td>
                                    <td><a href="{{ path('connector_show', {id: run.connector_id}) }}">{{ run.connector }}</a></td>
                                    <td>{{ ({schedule: 'activity.trigger_schedule', webhook: 'activity.trigger_webhook'}[run.trigger] ?? 'activity.trigger_manual')|trans }}</td>
                                    <td class="num">{{ run.report.created ?? 0 }}</td>
                                    <td class="num">{{ run.report.updated ?? 0 }}</td>
                                    <td>{% if run.report.error ?? null %}<span class="verdict verdict--refuted" title="{{ run.report.error }}">{{ 'common.failed'|trans }}</span>{% else %}<span class="verdict verdict--verified">ok</span>{% endif %}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
            {{ include('_pager.html.twig', {page: runs, name: 'runs'}) }}
        </section>
    </div>
{% endblock %}
