{# days: entries grouped by day, from ActivityReader::feed() #}
{% set icons = {commit: 'lucide:git-commit-horizontal', ticket: 'lucide:git-pull-request', document: 'lucide:file-text', memory: 'lucide:lightbulb', business_rule: 'lucide:scale'} %}
<ol class="events">
    {% for items in days %}
        {% for item in items %}
            {% set href = item.type == 'memory' ? path('memory_show', {id: item.id})
                : (item.type == 'document' ? path('document_show', {id: item.id})
                : (item.type == 'business_rule' and item.project_slug ? path('rule_show', {slug: item.project_slug, code: item.ref}) : item.url)) %}
            {% set external = item.type in ['commit', 'ticket'] %}
            <li class="event">
                <span class="event__icon event__icon--{{ item.type }}" aria-hidden="true">{{ ux_icon(icons[item.type] ?? 'lucide:circle-plus') }}</span>
                <div class="event__main">
                    <p class="event__head">
                        <strong>{{ ('activity.action.' ~ (item.type == 'ticket' ? (item.kind == 'change_request' ? 'change_request' : 'issue') : item.type))|trans }}</strong>
                        {% if item.type == 'commit' %}<span class="code-chip">{{ item.ref|slice(0, 7) }}</span>{% elseif item.type in ['ticket', 'business_rule'] %}<span class="code-chip">{{ item.ref }}</span>{% endif %}
                        {% if item.author %}<span class="event__by">{{ 'activity.by'|trans }} <strong>{{ item.author }}</strong></span>{% endif %}
                    </p>
                    <p class="event__text">
                        {% if href %}<a href="{{ href }}" {% if external %}rel="noopener noreferrer" target="_blank"{% endif %}>{{ item.label }}</a>{% else %}{{ item.label }}{% endif %}
                    </p>
                </div>
                <time class="event__time num" datetime="{{ item.created_at|date('c') }}">{{ item.created_at|format_datetime('medium', 'short') }}</time>
            </li>
        {% endfor %}
    {% endfor %}
</ol>
