{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.to_review'|trans }}{{ project ? ' · ' ~ project.name }}{% endblock %}

{% block crumbs %}
    {% if project %}
        <a href="{{ path('project_show', {slug: project.slug}) }}">{{ project.name }}</a>
        <span class="crumbs__sep" aria-hidden="true">/</span>
    {% endif %}
    <span class="crumbs__current">{{ 'nav.to_review'|trans }}</span>
{% endblock %}

{% block body %}
    {% set scoped = app.user and not is_granted('ROLE_SUPER_ADMIN') %}
    {% set filters = {project: project ? project.slug : null} %}
    {% set reconciliations = {new: 'memory.new', updates: 'proposal.updates', supersedes: 'memory.show.replaces', retracts: 'proposal.retracts'} %}
    {% set tones = {new: 'success', updates: 'warning', supersedes: 'warning', retracts: 'danger'} %}
    {% set sources = {conversation: 'proposal.source.conversation', file: 'proposal.source.file', diff: 'proposal.source.diff', review: 'proposal.source.review'} %}
    <div class="view-head">
        <h1><twig:ux:icon name="lucide:check" />{{ 'nav.to_review'|trans }}</h1>
        <span class="view-head__meta">{{ project ? 'proposal.pending_project'|trans({count: proposals.total, name: project.name}) : 'proposal.pending'|trans({count: proposals.total}) }}</span>
    </div>
    <p class="page__lede">{{ 'proposal.lede'|trans }}</p>

    <div class="filter-bar">
        <nav class="tabs" aria-label="{{ 'proposal.filter_kind'|trans }}">
            <a href="{{ path('proposal_index', filters|filter(v => v is not null)) }}" {% if kind is null %}aria-current="page"{% endif %}>{{ 'common.all'|trans }}{% if all_count > 0 %} <span class="tab__count num">{{ all_count }}</span>{% endif %}</a>
            {% for item in kinds %}
                {% set c = kind_counts[item.value] ?? 0 %}
                <a href="{{ path('proposal_index', (filters|merge({kind: item.value}))|filter(v => v is not null)) }}" {% if kind == item %}aria-current="page"{% endif %}>{{ item|trans }}{% if c > 0 %} <span class="tab__count num">{{ c }}</span>{% endif %}</a>
            {% endfor %}
        </nav>
        {% if projects is not empty %}
            <form method="get" action="{{ path('proposal_index') }}" data-controller="autosubmit">
                {% if kind %}<input type="hidden" name="kind" value="{{ kind.value }}">{% endif %}
                <select class="select" name="project" aria-label="{{ 'memory.index.project'|trans }}" data-action="autosubmit#submit">
                    {% if not scoped %}<option value="">{{ 'nav.all_projects'|trans }}</option>{% endif %}
                    {% for item in projects %}<option value="{{ item.slug }}" {{ project and project.id == item.id ? 'selected' }}>{{ item.name }}</option>{% endfor %}
                </select>
            </form>
        {% endif %}
    </div>

    {% if proposals.items is empty %}
        <p class="block__empty">{{ 'proposal.empty'|trans({command: '<span class="mono">app:learn</span>', tool: '<span class="mono">learn</span>'})|raw }}</p>
    {% else %}
        <ul class="proposals">
            {% for proposal in proposals.items %}
                {% set p = proposal.payload %}
                {% set query = {project: project ? project.slug : null, kind: kind ? kind.value : null}|filter(v => v is not null) %}
                {% set learning = proposal.kind.value == 'learning' %}
                {% set tone = learning ? (tones[p.reconciliation] ?? 'neutral') : (proposal.kind.value == 'duplicate' ? 'warning' : 'danger') %}
                <li class="proposal" id="proposal-{{ proposal.id }}">
                    <div class="proposal__head">
                        <span class="proposal__dot proposal__dot--{{ learning ? p.type : proposal.kind.value }}" aria-hidden="true"></span>
                        <div class="proposal__title">
                            <strong>{{ proposal.kind|trans }}</strong>
                            <span class="row__sub">{{ proposal.project ? proposal.project.name : 'nav.all_projects'|trans }}{% if learning %} · {{ (sources[p.source.kind] ?? p.source.kind)|trans }}{% endif %}</span>
                        </div>
                        <span class="pill pill--{{ tone }}">{{ learning ? (reconciliations[p.reconciliation] ?? p.reconciliation)|trans : proposal.kind|trans }}</span>
                    </div>

                    <form method="post" action="{{ path('proposal_apply', {id: proposal.id}|merge(query)) }}" class="proposal__body">
                        <input type="hidden" name="_token" value="{{ csrf_token('proposal-' ~ proposal.id) }}">

                        {% if learning %}
                            {% if p.reconciliation == 'retracts' %}
                                <p class="proposal__text">{{ 'proposal.retract'|trans }} <a href="{{ path('memory_show', {id: p.target_id}) }}">{{ p.target_text }}</a></p>
                            {% else %}
                                <label class="visually-hidden" for="lesson-{{ proposal.id }}">{{ 'proposal.lesson'|trans }}</label>
                                <textarea id="lesson-{{ proposal.id }}" name="lesson" class="proposal__lesson" rows="3" maxlength="1000">{{ p.lesson }}</textarea>
                                {% if p.target_id %}
                                    <p class="row__sub">{{ (p.reconciliation == 'updates' ? 'proposal.replaces_text' : 'proposal.archives')|trans }} <a href="{{ path('memory_show', {id: p.target_id}) }}">{{ p.target_text }}</a></p>
                                {% endif %}
                            {% endif %}
                            <dl class="kv">
                                <div class="kv__group">
                                    <div class="kv__row"><dt>{{ 'proposal.type'|trans }}</dt><dd>{{ include('memory/_type.html.twig', {type: p.type}) }}</dd></div>
                                    <div class="kv__row"><dt>{{ 'memory.index.source'|trans }}</dt><dd>{{ p.source.label }}</dd></div>
                                </div>
                                <div class="kv__group">
                                    <div class="kv__row" title="{{ 'proposal.axes'|trans({durability: p.axes.durability, reuse: p.axes.reuse, fit: p.axes.project_fit, risk: p.axes.risk}) }}"><dt>{{ 'proposal.score_label'|trans }}</dt><dd class="num">{{ p.score }}/10</dd></div>
                                </div>
                                <div class="kv__group">
                                    <div class="kv__row"><dt>{{ 'proposal.proposed'|trans }}</dt><dd class="num">{{ proposal.createdAt|format_datetime('short', 'short') }}</dd></div>
                                </div>
                            </dl>
                            <details class="proposal__more">
                                <summary>{{ 'proposal.evidence_source'|trans }}</summary>
                                <dl class="props props--flat">
                                    <dt>{{ 'proposal.evidence'|trans }}</dt><dd><q>{{ p.evidence }}</q></dd>
                                    {% if p.reason %}<dt>{{ 'proposal.why'|trans }}</dt><dd>{{ p.reason }}</dd>{% endif %}
                                    {% if p.files is not empty or p.rules is not empty %}
                                        <dt>{{ 'proposal.links'|trans }}</dt>
                                        <dd>{% for file in p.files %}<span class="tag mono">{{ file }}</span>{% endfor %}{% for rule in p.rules %}<span class="tag mono">{{ rule }}</span>{% endfor %}</dd>
                                    {% endif %}
                                    {% if p.adr is not empty %}
                                        <dt>{{ 'enum.memory_type.decision'|trans }}</dt><dd>{{ p.adr.decision ?? '' }}</dd>
                                    {% endif %}
                                </dl>
                            </details>
                        {% elseif proposal.kind.value in ['duplicate', 'contradiction'] %}
                            <fieldset class="proposal__pair">
                                <legend class="row__sub">{{ (proposal.kind.value == 'duplicate' ? 'proposal.keep_merge' : 'proposal.keep')|trans }}</legend>
                                {% for side in ['a', 'b'] %}
                                    <div class="proposal__choice">
                                        <label class="proposal__choice-label">
                                            <input type="radio" name="keep" value="{{ attribute(p, side ~ '_id') }}" {% if side == 'a' %}checked{% endif %}>
                                            <span>{{ attribute(p, side ~ '_text') }}</span>
                                        </label>
                                        <a class="link proposal__choice-link" href="{{ path('memory_show', {id: attribute(p, side ~ '_id')}) }}">{{ 'proposal.page'|trans }}</a>
                                    </div>
                                {% endfor %}
                            </fieldset>
                            <dl class="kv">
                                <div class="kv__group">
                                    <div class="kv__row kv__row--stack"><dt>{{ 'proposal.why'|trans }}</dt><dd>{{ p.reason }}</dd></div>
                                </div>
                                <div class="kv__group">
                                    <div class="kv__row"><dt>{{ 'proposal.proposed'|trans }}</dt><dd class="num">{{ proposal.createdAt|format_datetime('short', 'short') }}</dd></div>
                                </div>
                            </dl>
                        {% else %}
                            <p class="proposal__text"><a href="{{ path('memory_show', {id: p.memory_id}) }}">{{ p.memory_text }}</a></p>
                            <dl class="kv">
                                <div class="kv__group">
                                    <div class="kv__row"><dt>{{ 'proposal.verdict_label'|trans }}</dt><dd>{{ p.verdict in ['verified', 'refuted', 'conflict', 'unverified'] ? ('verdict.' ~ p.verdict)|trans : p.verdict }}</dd></div>
                                    <div class="kv__row kv__row--stack"><dt>{{ 'proposal.why'|trans }}</dt><dd>{{ p.reason }}</dd></div>
                                </div>
                                {% if p.sources is not empty %}
                                    <div class="kv__group">
                                        <div class="kv__row kv__row--stack"><dt>{{ 'memory.show.sources'|trans }}</dt><dd>{% for source in p.sources %}{{ source.label }}{{ not loop.last ? ', ' }}{% endfor %}</dd></div>
                                    </div>
                                {% endif %}
                                <div class="kv__group">
                                    <div class="kv__row"><dt>{{ 'proposal.proposed'|trans }}</dt><dd class="num">{{ proposal.createdAt|format_datetime('short', 'short') }}</dd></div>
                                </div>
                            </dl>
                        {% endif %}

                        <div class="proposal__actions">
                            <button class="button button--primary" type="submit">{{ (proposal.kind.value == 'refuted' ? 'proposal.retract_memory' : 'proposal.apply')|trans }}</button>
                            <button class="button" type="submit" formaction="{{ path('proposal_reject', {id: proposal.id}|merge(query)) }}" data-confirm="{{ 'proposal.reject_confirm'|trans }}" data-confirm-label="{{ 'proposal.reject'|trans }}">{{ 'proposal.reject'|trans }}</button>
                        </div>
                    </form>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    {{ include('_pager.html.twig', {page: proposals}) }}
{% endblock %}
