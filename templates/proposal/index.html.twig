{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.to_review'|trans }}{{ project ? ' · ' ~ project.name }}{% endblock %}

{% block crumbs %}
    {% if project %}
        <a href="{{ path('project_show', {slug: project.slug}) }}">{{ project.name }}</a>
        <span class="crumbs__sep" aria-hidden="true">/</span>
    {% endif %}
    <span class="crumbs__current">{{ 'nav.to_review'|trans }}</span>
{% endblock %}

{% block body %}
    {% set scoped = app.user and not is_granted('ROLE_SUPER_ADMIN') %}
    {% set filters = {project: project ? project.slug : null} %}
    {% set reconciliations = {new: 'memory.new', updates: 'proposal.updates', supersedes: 'memory.show.replaces', retracts: 'proposal.retracts'} %}
    {% set tones = {new: 'success', updates: 'warning', supersedes: 'warning', retracts: 'danger'} %}
    {% set sources = {conversation: 'proposal.source.conversation', file: 'proposal.source.file', diff: 'proposal.source.diff', review: 'proposal.source.review'} %}
    {% set memory_icons = {decision: 'lucide:gavel', convention: 'lucide:ruler', task_learning: 'lucide:graduation-cap', preference: 'lucide:sliders-horizontal', fact: 'lucide:lightbulb'} %}
    {% set kind_icons = {rule_draft: 'lucide:clipboard-check', skill_update: 'lucide:graduation-cap', duplicate: 'lucide:copy', contradiction: 'lucide:triangle-alert', refuted: 'lucide:shield-alert'} %}

    <div class="view-head">
        <h1><twig:ux:icon name="lucide:check" />{{ 'nav.to_review'|trans }}</h1>
        <span class="view-head__meta">{{ project ? 'proposal.pending_project'|trans({count: proposals.total, name: project.name}) : 'proposal.pending'|trans({count: proposals.total}) }}</span>
    </div>

    <div class="filter-bar">
        <nav class="tabs" aria-label="{{ 'proposal.filter_kind'|trans }}">
            <a href="{{ path('proposal_index', filters|filter(v => v is not null)) }}" {% if kind is null %}aria-current="page"{% endif %}>{{ 'common.all'|trans }}{% if all_count > 0 %} <span class="tab__count num">{{ all_count }}</span>{% endif %}</a>
            {% for item in kinds %}
                {% set c = kind_counts[item.value] ?? 0 %}
                <a href="{{ path('proposal_index', (filters|merge({kind: item.value}))|filter(v => v is not null)) }}" {% if kind == item %}aria-current="page"{% endif %}>{{ item|trans }}{% if c > 0 %} <span class="tab__count num">{{ c }}</span>{% endif %}</a>
            {% endfor %}
        </nav>
        {% if projects is not empty %}
            <form method="get" action="{{ path('proposal_index') }}" data-controller="autosubmit">
                {% if kind %}<input type="hidden" name="kind" value="{{ kind.value }}">{% endif %}
                <select class="select" name="project" aria-label="{{ 'memory.index.project'|trans }}" data-action="autosubmit#submit">
                    {% if not scoped %}<option value="">{{ 'nav.all_projects'|trans }}</option>{% endif %}
                    {% for item in projects %}<option value="{{ item.slug }}" {{ project and project.id == item.id ? 'selected' }}>{{ item.name }}</option>{% endfor %}
                </select>
            </form>
        {% endif %}
    </div>

    {% if proposals.items is empty %}
        <p class="block__empty">{{ 'proposal.empty'|trans({command: '<span class="mono">app:learn</span>', tool: '<span class="mono">learn</span>'})|raw }}</p>
    {% else %}
        {% set query = {project: project ? project.slug : null, kind: kind ? kind.value : null}|filter(v => v is not null) %}
        <div class="table-wrap table-wrap--framed proposal-table">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">{{ 'proposal.col.proposal'|trans }}</th>
                        <th scope="col">{{ 'nav.projects'|trans }}</th>
                        <th scope="col">{{ 'proposal.col.signal'|trans }}</th>
                        <th scope="col" class="num">{{ 'proposal.proposed'|trans }}</th>
                        <th scope="col" class="proposal-table__actions-head">{{ 'proposal.col.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for proposal in proposals.items %}
                        {% set p = proposal.payload %}
                        {% set kind_value = proposal.kind.value %}
                        {% set learning = kind_value == 'learning' %}
                        {% set rule_draft = kind_value == 'rule_draft' %}
                        {% set skill_update = kind_value == 'skill_update' %}
                        {% set pair = kind_value in ['duplicate', 'contradiction'] %}
                        {% set variant = learning ? (p.type ?? 'fact') : kind_value %}
                        {% set icon_name = learning ? (memory_icons[p.type ?? 'fact'] ?? 'lucide:lightbulb') : (kind_icons[kind_value] ?? 'lucide:info') %}
                        {% set tone = learning ? (tones[p.reconciliation] ?? 'neutral') : (rule_draft ? 'success' : (skill_update ? 'accent' : (kind_value == 'duplicate' ? 'warning' : 'danger'))) %}
                        {% set badge_label = learning ? (reconciliations[p.reconciliation] ?? p.reconciliation)|trans : (skill_update ? ((p.action ?? 'create') == 'update' ? 'proposal.skill.action_update' : 'proposal.skill.action_create')|trans : proposal.kind|trans) %}
                        {% set drawer_id = 'proposal-drawer-' ~ proposal.id %}
                        <tr class="proposal-row" id="proposal-{{ proposal.id }}">
                            <td>
                                <div class="proposal-cell">
                                    <span class="proposal-cell__icon proposal-cell__icon--{{ variant }}" aria-hidden="true">{{ ux_icon(icon_name) }}</span>
                                    <div class="proposal-cell__main">
                                        <button class="proposal-cell__trigger" type="button" commandfor="{{ drawer_id }}" command="show-modal">
                                            {% if learning %}
                                                {% if p.reconciliation == 'retracts' %}
                                                    <span class="proposal-cell__summary">{{ 'proposal.retract'|trans }} {{ p.target_text }}</span>
                                                {% else %}
                                                    <span class="proposal-cell__summary">{{ p.lesson }}</span>
                                                {% endif %}
                                            {% elseif rule_draft %}
                                                <span class="proposal-cell__summary"><strong>{{ p.title }}</strong>{% if p.statement ?? null %} — {{ p.statement }}{% endif %}</span>
                                            {% elseif skill_update %}
                                                <span class="proposal-cell__summary"><code class="mono">{{ p.name }}</code>{% if p.description ?? null %} — {{ p.description }}{% endif %}</span>
                                            {% elseif pair %}
                                                <span class="proposal-cell__summary">{{ p.a_text }} <span class="proposal-cell__vs" aria-hidden="true">↔</span> {{ p.b_text }}</span>
                                            {% else %}
                                                <span class="proposal-cell__summary">{{ p.memory_text }}</span>
                                            {% endif %}
                                        </button>
                                        <div class="proposal-cell__meta">
                                            <span class="pill pill--{{ tone }}">{{ badge_label }}</span>
                                            {% if learning %}
                                                <span>{{ ('enum.memory_type.' ~ (p.type ?? 'fact'))|trans }}</span>
                                                {% if p.source.kind ?? null %}<span>{{ (sources[p.source.kind] ?? p.source.kind)|trans }}</span>{% endif %}
                                            {% elseif rule_draft and (p.document_title ?? null) %}
                                                <span>{{ p.document_title }}</span>
                                            {% elseif skill_update %}
                                                <span>{{ ('enum.agent_asset_kind.' ~ (p.kind ?? 'skill'))|trans }}</span>
                                            {% elseif p.reason ?? null %}
                                                <span class="proposal-cell__reason">{{ p.reason }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td data-label="{{ 'nav.projects'|trans }}">
                                <span class="proposal-project">
                                    <span class="project-dot"{% if proposal.project %} data-hue="{{ proposal.project.id % 8 }}"{% endif %} aria-hidden="true"></span>
                                    <span>{{ proposal.project ? proposal.project.name : 'nav.all_projects'|trans }}</span>
                                </span>
                            </td>
                            <td data-label="{{ 'proposal.col.signal'|trans }}">
                                {% if learning and (p.score ?? null) is not null %}
                                    {% set score_tone = p.score >= 8 ? 'high' : (p.score >= 6 ? 'mid' : 'low') %}
                                    <span class="score-badge score-badge--{{ score_tone }} num" title="{{ 'proposal.axes'|trans({durability: p.axes.durability, reuse: p.axes.reuse, fit: p.axes.project_fit, risk: p.axes.risk}) }}">{{ p.score }}</span>
                                {% elseif rule_draft and (p.document_format ?? null) %}
                                    <span class="format format--{{ p.document_format }}">{{ p.document_format }}</span>
                                {% elseif kind_value == 'refuted' %}
                                    <span class="pill pill--danger">{{ p.verdict in ['verified', 'refuted', 'conflict', 'unverified'] ? ('verdict.' ~ p.verdict)|trans : p.verdict }}</span>
                                {% elseif pair %}
                                    <span class="pill pill--{{ kind_value == 'duplicate' ? 'warning' : 'danger' }}">{{ 'proposal.choose_pair'|trans }}</span>
                                {% else %}
                                    <span class="row__sub">—</span>
                                {% endif %}
                            </td>
                            <td class="num row__sub data-table__nowrap" data-label="{{ 'proposal.proposed'|trans }}">
                                {{ proposal.createdAt|format_datetime('short', 'short') }}
                            </td>
                            <td class="proposal-table__actions" data-label="{{ 'proposal.col.actions'|trans }}">
                                <div class="proposal-acts">
                                    {% if pair %}
                                        <button class="proposal-act proposal-act--approve" type="button" commandfor="{{ drawer_id }}" command="show-modal" title="{{ 'proposal.choose_apply'|trans }}">
                                            {{ ux_icon('lucide:check') }}
                                            <span class="visually-hidden">{{ 'proposal.choose_apply'|trans }}</span>
                                        </button>
                                    {% else %}
                                        <form method="post" action="{{ path('proposal_apply', {id: proposal.id}|merge(query)) }}" class="proposal-act-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('proposal-' ~ proposal.id) }}">
                                            <button class="proposal-act proposal-act--approve" type="submit" title="{{ 'proposal.quick_apply'|trans }}">
                                                {{ ux_icon('lucide:check') }}
                                                <span class="visually-hidden">{{ 'proposal.quick_apply'|trans }}</span>
                                            </button>
                                        </form>
                                    {% endif %}

                                    <form method="post" action="{{ path('proposal_reject', {id: proposal.id}|merge(query)) }}" class="proposal-act-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('proposal-' ~ proposal.id) }}">
                                        <button class="proposal-act proposal-act--reject" type="submit" title="{{ 'proposal.reject'|trans }}">
                                            {{ ux_icon('lucide:x') }}
                                            <span class="visually-hidden">{{ 'proposal.reject'|trans }}</span>
                                        </button>
                                    </form>

                                    <button class="proposal-act proposal-act--edit" type="button" commandfor="{{ drawer_id }}" command="show-modal" title="{{ 'proposal.edit'|trans }}">
                                        {{ ux_icon('lucide:pencil') }}
                                        <span class="visually-hidden">{{ 'proposal.edit'|trans }}</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% for proposal in proposals.items %}
            {{ include('proposal/_drawer.html.twig', {
                proposal: proposal,
                query: query,
                reconciliations: reconciliations,
                tones: tones,
                sources: sources,
                memory_icons: memory_icons,
                kind_icons: kind_icons,
            }) }}
        {% endfor %}
    {% endif %}
    {{ include('_pager.html.twig', {page: proposals}) }}
{% endblock %}
