{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.to_review'|trans }}{{ project ? ' · ' ~ project.name }}{% endblock %}

{% block crumbs %}
    {% if project %}
        <a href="{{ path('project_show', {slug: project.slug}) }}">{{ project.name }}</a>
        <span class="crumbs__sep" aria-hidden="true">/</span>
    {% endif %}
    <span class="crumbs__current">{{ 'nav.to_review'|trans }}</span>
{% endblock %}

{% block body %}
    {% set filters = {project: project ? project.slug : null} %}
    {% set reconciliations = {new: 'memory.new', updates: 'proposal.updates', supersedes: 'memory.show.replaces', retracts: 'proposal.retracts'} %}
    {% set sources = {conversation: 'proposal.source.conversation', file: 'proposal.source.file', diff: 'proposal.source.diff', review: 'proposal.source.review'} %}
    <div class="view-head">
        <h1><twig:ux:icon name="lucide:check" />{{ 'nav.to_review'|trans }}</h1>
        <span class="view-head__meta">{{ project ? 'proposal.pending_project'|trans({count: proposals.total, name: project.name}) : 'proposal.pending'|trans({count: proposals.total}) }}</span>
    </div>
    <p class="page__lede">{{ 'proposal.lede'|trans }}</p>

    <div class="filter-bar">
        <nav class="tabs" aria-label="{{ 'proposal.filter_kind'|trans }}">
            <a href="{{ path('proposal_index', filters|filter(v => v is not null)) }}" {% if kind is null %}aria-current="page"{% endif %}>{{ 'common.all'|trans }}</a>
            {% for item in kinds %}
                <a href="{{ path('proposal_index', (filters|merge({kind: item.value}))|filter(v => v is not null)) }}" {% if kind == item %}aria-current="page"{% endif %}>{{ item|trans }}</a>
            {% endfor %}
        </nav>
    </div>

    {% if proposals.items is empty %}
        <p class="block__empty">{{ 'proposal.empty'|trans({command: '<span class="mono">app:learn</span>', tool: '<span class="mono">learn</span>'})|raw }}</p>
    {% else %}
        <ul class="proposals">
            {% for proposal in proposals.items %}
                {% set p = proposal.payload %}
                {% set query = {project: project ? project.slug : null, kind: kind ? kind.value : null}|filter(v => v is not null) %}
                <li class="proposal" id="proposal-{{ proposal.id }}">
                    <div class="proposal__head">
                        <span class="code-chip">{{ proposal.kind|trans }}</span>
                        {% if proposal.kind.value == 'learning' %}
                            <span class="tag">{{ (reconciliations[p.reconciliation] ?? p.reconciliation)|trans }}</span>
                            {{ include('memory/_type.html.twig', {type: p.type}) }}
                            <span class="row__sub num" title="{{ 'proposal.axes'|trans({durability: p.axes.durability, reuse: p.axes.reuse, fit: p.axes.project_fit, risk: p.axes.risk}) }}">{{ 'proposal.score'|trans({score: p.score}) }}</span>
                        {% endif %}
                        {% if proposal.project %}<span class="row__projects">{{ proposal.project.name }}</span>{% endif %}
                        <span class="row__sub num">{{ proposal.createdAt|format_datetime('short', 'short') }}</span>
                    </div>

                    <form method="post" action="{{ path('proposal_apply', {id: proposal.id}|merge(query)) }}" class="proposal__body">
                        <input type="hidden" name="_token" value="{{ csrf_token('proposal-' ~ proposal.id) }}">

                        {% if proposal.kind.value == 'learning' %}
                            {% if p.reconciliation == 'retracts' %}
                                <p class="proposal__text">{{ 'proposal.retract'|trans }} <a href="{{ path('memory_show', {id: p.target_id}) }}">{{ p.target_text }}</a></p>
                            {% else %}
                                <label class="visually-hidden" for="lesson-{{ proposal.id }}">{{ 'proposal.lesson'|trans }}</label>
                                <textarea id="lesson-{{ proposal.id }}" name="lesson" class="proposal__lesson" rows="2" maxlength="1000">{{ p.lesson }}</textarea>
                                {% if p.target_id %}
                                    <p class="row__sub">{{ (p.reconciliation == 'updates' ? 'proposal.replaces_text' : 'proposal.archives')|trans }} <a href="{{ path('memory_show', {id: p.target_id}) }}">{{ p.target_text }}</a></p>
                                {% endif %}
                            {% endif %}
                            <details class="proposal__more">
                                <summary>{{ 'proposal.evidence_source'|trans }}</summary>
                            <dl class="props props--flat">
                                <dt>{{ 'proposal.evidence'|trans }}</dt><dd><q>{{ p.evidence }}</q></dd>
                                <dt>{{ 'memory.index.source'|trans }}</dt><dd>{{ (sources[p.source.kind] ?? p.source.kind)|trans }} · {{ p.source.label }}</dd>
                                {% if p.reason %}<dt>{{ 'proposal.why'|trans }}</dt><dd>{{ p.reason }}</dd>{% endif %}
                                {% if p.files is not empty or p.rules is not empty %}
                                    <dt>{{ 'proposal.links'|trans }}</dt>
                                    <dd>{% for file in p.files %}<span class="tag mono">{{ file }}</span>{% endfor %}{% for rule in p.rules %}<span class="tag mono">{{ rule }}</span>{% endfor %}</dd>
                                {% endif %}
                                {% if p.adr is not empty %}
                                    <dt>{{ 'enum.memory_type.decision'|trans }}</dt><dd>{{ p.adr.decision ?? '' }}</dd>
                                {% endif %}
                            </dl>
                            </details>
                        {% elseif proposal.kind.value in ['duplicate', 'contradiction'] %}
                            <fieldset class="proposal__pair">
                                <legend class="row__sub">{{ (proposal.kind.value == 'duplicate' ? 'proposal.keep_merge' : 'proposal.keep')|trans }}</legend>
                                {% for side in ['a', 'b'] %}
                                    <label class="proposal__choice">
                                        <input type="radio" name="keep" value="{{ attribute(p, side ~ '_id') }}" {% if side == 'a' %}checked{% endif %}>
                                        <span>{{ attribute(p, side ~ '_text') }}</span>
                                        <a class="row__sub" href="{{ path('memory_show', {id: attribute(p, side ~ '_id')}) }}">{{ 'proposal.page'|trans }}</a>
                                    </label>
                                {% endfor %}
                            </fieldset>
                            <p class="row__sub">{{ p.reason }}</p>
                        {% else %}
                            <p class="proposal__text"><a href="{{ path('memory_show', {id: p.memory_id}) }}">{{ p.memory_text }}</a></p>
                            <p class="row__sub">{{ 'proposal.verdict'|trans({verdict: p.verdict, reason: p.reason}) }}</p>
                            {% if p.sources is not empty %}
                                <p class="row__sub">{{ 'memory.show.sources'|trans }} {% for source in p.sources %}{{ source.label }}{{ not loop.last ? ', ' }}{% endfor %}</p>
                            {% endif %}
                        {% endif %}

                        <div class="proposal__actions">
                            <button class="button button--primary" type="submit">{{ (proposal.kind.value == 'refuted' ? 'proposal.retract_memory' : 'proposal.apply')|trans }}</button>
                            <button class="button" type="submit" formaction="{{ path('proposal_reject', {id: proposal.id}|merge(query)) }}">{{ 'proposal.reject'|trans }}</button>
                        </div>
                    </form>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    {{ include('_pager.html.twig', {page: proposals}) }}
{% endblock %}
