{% set route = app.request.attributes.get('_route') %}
{% set scope = project ? {project: project.slug} : {} %}
<aside{{ attributes.defaults({class: 'sidebar', id: 'app-sidebar', 'aria-label': 'nav.sidebar'|trans}) }} data-sidebar-target="panel">
    <div class="sidebar__top">
        <a class="workspace" href="{{ path('dashboard') }}"><span class="workspace__mark" aria-hidden="true">M</span><span class="workspace__name">{{ 'app.name'|trans }}</span></a>
        <button class="sidebar__toggle" type="button" aria-expanded="true" aria-label="{{ 'nav.collapse'|trans }}" title="{{ 'nav.collapse'|trans }}" data-sidebar-target="toggle" data-action="sidebar#toggle">
            {{ ux_icon('lucide:panel-left-close', {class: 'icon sidebar__toggle-close'}) }}{{ ux_icon('lucide:panel-left-open', {class: 'icon sidebar__toggle-open'}) }}
        </button>
        <button class="sidebar__close" type="button" aria-label="{{ 'nav.collapse'|trans }}" title="{{ 'nav.collapse'|trans }}" data-action="sidebar#close">
            {{ ux_icon('lucide:x', {class: 'icon'}) }}
        </button>
    </div>

    {% set projects = this.projects %}
    <div class="menu menu--switcher" data-controller="menu">
        <button class="menu__trigger" type="button" aria-expanded="false" aria-controls="project-menu" commandfor="project-menu" command="toggle-popover" data-menu-target="trigger">
            <twig:ux:icon name="lucide:folder" class="icon nav-item__icon" />
            <span class="visually-hidden">{{ 'nav.switch_project'|trans }}: </span>
            <span class="nav-item__label">{{ project ? project.name : 'nav.all_projects'|trans }}</span>
            <twig:ux:icon name="lucide:chevron-down" class="icon menu__chevron" />
        </button>
        <div class="menu__panel" id="project-menu" popover data-menu-target="panel" data-action="beforetoggle->menu#place toggle->menu#sync">
            {% if projects|length > 6 %}
                <input class="input menu__filter" type="search" placeholder="{{ 'nav.filter_projects'|trans }}" aria-label="{{ 'nav.filter_projects'|trans }}" autocomplete="off" autofocus data-menu-target="filter" data-action="input->menu#filter">
            {% endif %}
            <a class="menu__item" href="{{ path('project_index') }}" {% if not project %}aria-current="true"{% endif %}>{{ 'nav.all_projects'|trans }}</a>
            {% for item in projects %}
                <a class="menu__item" href="{{ path('project_show', {slug: item.slug}) }}" {% if project and project.id == item.id %}aria-current="true"{% endif %} data-menu-target="item">
                    <span class="project-dot" aria-hidden="true"></span>{{ item.name }}
                </a>
            {% else %}
                <span class="menu__note">{{ 'nav.no_project'|trans }}</span>
            {% endfor %}
            <span class="menu__note" data-menu-target="empty" hidden>{{ 'nav.no_project_matches'|trans }}</span>
            {% if this.mayCreate or project %}<hr class="menu__rule">{% endif %}
            {% if this.mayCreate %}
                <button class="menu__item" type="button" commandfor="project-new" command="show-modal"><twig:ux:icon name="lucide:plus" />{{ 'project.new'|trans }}</button>
            {% endif %}
            {% if project %}
                <a class="menu__item" href="{{ path('project_settings', {slug: project.slug}) }}"><twig:ux:icon name="lucide:sliders-horizontal" />{{ 'nav.project_settings'|trans }}</a>
            {% endif %}
        </div>
    </div>

    {% if project %}
        {% set counts = this.counts %}
        {% set pending = this.pendingProposals %}
        <nav class="nav-group" aria-label="{{ 'nav.overview'|trans }}">
            <a class="nav-item" href="{{ path('dashboard', scope) }}" {% if route == 'dashboard' %}aria-current="page"{% endif %}>
                <twig:ux:icon name="lucide:layout-dashboard" class="icon nav-item__icon" />
                <span class="nav-item__label">{{ 'nav.dashboard'|trans }}</span>
            </a>
            <a class="nav-item" href="{{ path('activity', scope) }}" {% if route in ['activity', 'activity_feed'] %}aria-current="page"{% endif %}>
                <twig:ux:icon name="lucide:activity" class="icon nav-item__icon" />
                <span class="nav-item__label">{{ 'nav.activity'|trans }}</span>
            </a>
            <a class="nav-item" href="{{ path('proposal_index', scope) }}" {% if route == 'proposal_index' %}aria-current="page"{% endif %}>
                <twig:ux:icon name="lucide:check" class="icon nav-item__icon" />
                <span class="nav-item__label">{{ 'nav.to_review'|trans }}</span>
                {% if pending > 0 %}<span class="nav-item__count nav-item__count--alert">{{ pending }}</span>{% endif %}
            </a>
        </nav>

        <details class="nav-accordion" open data-controller="nav-group" data-nav-group-key-value="project-knowledge" data-action="toggle->nav-group#remember">
            <summary class="nav-accordion__trigger">
                <span class="nav-group__label">{{ 'nav.knowledge'|trans }}{% if project.archived %} <span class="tag tag--demo">{{ 'project.archived'|trans }}</span>{% endif %}</span>
                <twig:ux:icon name="lucide:chevron-down" class="icon nav-accordion__chevron" />
            </summary>
            <nav class="nav-group" aria-label="{{ project.name }}">
                <a class="nav-item" href="{{ path('project_show', {slug: project.slug}) }}" {% if route == 'project_show' %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:file-text" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.documents'|trans }}</span>
                    <span class="nav-item__count">{{ counts.documents }}</span>
                </a>
                <a class="nav-item" href="{{ path('rule_index', {slug: project.slug}) }}" {% if route in ['rule_index', 'rule_show'] %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:clipboard-check" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.rules'|trans }}</span>
                    {% if counts.rules_to_review > 0 %}
                        <span class="nav-item__count nav-item__count--alert" title="{{ 'nav.count_to_review'|trans({count: counts.rules_to_review}) }}">{{ 'nav.count_to_review'|trans({count: counts.rules_to_review}) }}</span>
                    {% else %}
                        <span class="nav-item__count">{{ counts.rules }}</span>
                    {% endif %}
                </a>
                <a class="nav-item" href="{{ path('project_questions', {slug: project.slug}) }}" {% if route == 'project_questions' %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:triangle-alert" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.questions'|trans }}</span>
                </a>
                <a class="nav-item" href="{{ path('project_alignment', {slug: project.slug}) }}" {% if route == 'project_alignment' %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:scale" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.alignment'|trans }}</span>
                </a>
                <a class="nav-item" href="{{ path('memory_index', {project: project.slug}) }}" {% if route in ['memory_index', 'memory_show'] %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:lightbulb" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.memories'|trans }}</span>
                    <span class="nav-item__count">{{ counts.memories }}</span>
                </a>
                <a class="nav-item" href="{{ path('memory_graph', scope) }}" {% if route == 'memory_graph' %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:network" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.memory_graph'|trans }}</span>
                </a>
                <a class="nav-item" href="{{ path('project_code', {slug: project.slug}) }}" {% if route in ['project_code', 'file_show'] %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:code" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.code'|trans }}</span>
                    <span class="nav-item__count">{{ counts.files }}</span>
                </a>
            </nav>
        </details>

        <details class="nav-accordion" open data-controller="nav-group" data-nav-group-key-value="project-studio" data-action="toggle->nav-group#remember">
            <summary class="nav-accordion__trigger">
                <span class="nav-group__label">{{ 'nav.studio_agents'|trans }}</span>
                <twig:ux:icon name="lucide:chevron-down" class="icon nav-accordion__chevron" />
            </summary>
            <nav class="nav-group" aria-label="{{ 'nav.tools'|trans }}">
                <a class="nav-item" href="{{ path('project_studio', {slug: project.slug}) }}" {% if route == 'project_studio' %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:file-code" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.studio'|trans }}</span>
                </a>
                <a class="nav-item" href="{{ path('project_chat', {slug: project.slug}) }}" {% if route == 'project_chat' %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:message-circle" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.assistant'|trans }}</span>
                </a>
                <a class="nav-item" href="{{ path('project_briefing', {slug: project.slug}) }}" {% if route == 'project_briefing' %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:library" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.briefing'|trans }}</span>
                </a>
                <a class="nav-item" href="{{ path('agent_asset_index', {slug: project.slug}) }}" {% if route starts with 'agent_asset_' %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:graduation-cap" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.agent_assets'|trans }}</span>
                </a>
                {% if this.factoryAvailable %}
                <a class="nav-item" href="{{ path('project_factory', {slug: project.slug}) }}" {% if route in ['project_factory', 'factory_session_show', 'factory_swarm_show'] %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:kanban" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.factory'|trans }}</span>
                </a>
                {% endif %}
                <a class="nav-item" href="{{ path('garden_show', {slug: project.slug}) }}" {% if route == 'garden_show' %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:sprout" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.garden'|trans }}</span>
                </a>
                <a class="nav-item" href="{{ path('project_settings', {slug: project.slug}) }}" {% if route == 'project_settings' %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:sliders-horizontal" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.project_settings'|trans }}</span>
                </a>
            </nav>
        </details>
    {% else %}
        {% set pending = this.scoped ? 0 : this.pendingProposals %}
        <nav class="nav-group" aria-label="{{ 'nav.workspace'|trans }}">
            <a class="nav-item" href="{{ path('dashboard') }}" {% if route == 'dashboard' %}aria-current="page"{% endif %}>
                <twig:ux:icon name="lucide:layout-dashboard" class="icon nav-item__icon" />
                <span class="nav-item__label">{{ 'nav.dashboard'|trans }}</span>
            </a>
            <a class="nav-item" href="{{ path('activity') }}" {% if route in ['activity', 'activity_feed'] %}aria-current="page"{% endif %}>
                <twig:ux:icon name="lucide:activity" class="icon nav-item__icon" />
                <span class="nav-item__label">{{ 'nav.activity'|trans }}</span>
            </a>
            <a class="nav-item" href="{{ path('project_index') }}" {% if route == 'project_index' %}aria-current="page"{% endif %}>
                <twig:ux:icon name="lucide:layout-grid" class="icon nav-item__icon" />
                <span class="nav-item__label">{{ 'nav.projects'|trans }}</span>
            </a>
            <a class="nav-item" href="{{ path('proposal_index') }}" {% if route == 'proposal_index' %}aria-current="page"{% endif %}>
                <twig:ux:icon name="lucide:check" class="icon nav-item__icon" />
                <span class="nav-item__label">{{ 'nav.to_review'|trans }}</span>
                {% if pending > 0 %}<span class="nav-item__count nav-item__count--alert">{{ pending }}</span>{% endif %}
            </a>
        </nav>

        <details class="nav-accordion" open data-controller="nav-group" data-nav-group-key-value="workspace-knowledge" data-action="toggle->nav-group#remember">
            <summary class="nav-accordion__trigger">
                <span class="nav-group__label">{{ 'nav.knowledge'|trans }}</span>
                <twig:ux:icon name="lucide:chevron-down" class="icon nav-accordion__chevron" />
            </summary>
            <nav class="nav-group" aria-label="{{ 'nav.knowledge'|trans }}">
                {% if not this.scoped %}
                <a class="nav-item" href="{{ path('document_index') }}" {% if route in ['document_index', 'document_show'] %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:file" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.all_documents'|trans }}</span>
                </a>
                {% endif %}
                <a class="nav-item" href="{{ path('memory_index') }}" {% if route in ['memory_index', 'memory_show'] %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:lightbulb" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ (this.scoped ? 'nav.memories' : 'nav.all_memories')|trans }}</span>
                    {% if not this.scoped %}<span class="nav-item__count">{{ this.memoryCount }}</span>{% endif %}
                </a>
                <a class="nav-item" href="{{ path('memory_graph') }}" {% if route == 'memory_graph' %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:network" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.memory_graph'|trans }}</span>
                </a>
                <a class="nav-item" href="{{ path('question_index') }}" {% if route == 'question_index' %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:triangle-alert" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.questions'|trans }}</span>
                </a>
                <a class="nav-item" href="{{ path('alignment_index') }}" {% if route == 'alignment_index' %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:scale" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.alignment'|trans }}</span>
                </a>
            </nav>
        </details>

        <details class="nav-accordion" open data-controller="nav-group" data-nav-group-key-value="workspace-tools" data-action="toggle->nav-group#remember">
            <summary class="nav-accordion__trigger">
                <span class="nav-group__label">{{ 'nav.studio_agents'|trans }}</span>
                <twig:ux:icon name="lucide:chevron-down" class="icon nav-accordion__chevron" />
            </summary>
            <nav class="nav-group" aria-label="{{ 'nav.studio_agents'|trans }}">
                <a class="nav-item" href="{{ path('chat') }}" {% if route == 'chat' %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:message-circle" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.assistant'|trans }}</span>
                </a>
                {% if this.factoryAvailable %}
                <a class="nav-item" href="{{ path('factory_index') }}" {% if route in ['factory_index', 'factory_session_show', 'factory_swarm_show'] %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:kanban" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.factory'|trans }}</span>
                </a>
                {% endif %}
                {% if not this.scoped %}
                <a class="nav-item" href="{{ path('connector_index') }}" {% if route starts with 'connector_' %}aria-current="page"{% endif %}>
                    <twig:ux:icon name="lucide:plug" class="icon nav-item__icon" />
                    <span class="nav-item__label">{{ 'nav.connectors'|trans }}</span>
                </a>
                {% endif %}
            </nav>
        </details>
    {% endif %}

    <nav class="nav-group nav-group--foot" aria-label="{{ 'layout.help'|trans }}">
        <a class="nav-item" href="{{ path('wiki') }}" {% if route == 'wiki' %}aria-current="page"{% endif %}>
            <twig:ux:icon name="lucide:book-open" class="icon nav-item__icon" />
            <span class="nav-item__label">{{ 'nav.wiki'|trans }}</span>
        </a>
        {% set settings_routes = ['api_key_index', 'llm_settings', 'appearance', 'admin_users'] %}
        <div class="menu" data-controller="menu">
            <button class="nav-item menu__nav{{ route in settings_routes ? ' is-current' }}" type="button" aria-expanded="false" aria-controls="settings-menu" commandfor="settings-menu" command="toggle-popover" data-menu-target="trigger">
                <twig:ux:icon name="lucide:settings" class="icon nav-item__icon" />
                <span class="nav-item__label">{{ 'nav.settings'|trans }}</span>
                <twig:ux:icon name="lucide:chevron-up" class="icon menu__chevron" />
            </button>
            <div class="menu__panel" id="settings-menu" popover data-menu-target="panel" data-action="beforetoggle->menu#place toggle->menu#sync">
                {% if project and not this.scoped %}
                    <a class="menu__item" href="{{ path('connector_index') }}"><twig:ux:icon name="lucide:plug" />{{ 'nav.connectors'|trans }}</a>
                {% endif %}
                <a class="menu__item" href="{{ path('api_key_index') }}" {% if route == 'api_key_index' %}aria-current="page"{% endif %}><twig:ux:icon name="lucide:key-round" />{{ 'nav.api_keys'|trans }}</a>
                {% if not app.user or is_granted('ROLE_SUPER_ADMIN') %}
                    <a class="menu__item" href="{{ path('llm_settings') }}" {% if route == 'llm_settings' %}aria-current="page"{% endif %}><twig:ux:icon name="lucide:brain" />{{ 'nav.llm'|trans }}</a>
                {% endif %}
                <a class="menu__item" href="{{ path('appearance') }}" {% if route == 'appearance' %}aria-current="page"{% endif %}><twig:ux:icon name="lucide:palette" />{{ 'nav.appearance'|trans }}</a>
                {% if is_granted('ROLE_SUPER_ADMIN') %}
                    <a class="menu__item" href="{{ path('admin_users') }}" {% if route == 'admin_users' %}aria-current="page"{% endif %}><twig:ux:icon name="lucide:users" />{{ 'nav.users'|trans }}</a>
                {% endif %}
                <hr class="menu__rule">
                <a class="menu__item" href="https://github.com/quentinRogeret34/Mnemo" target="_blank" rel="noopener"><twig:ux:icon name="simple-icons:github" />{{ 'nav.source'|trans }}<span class="visually-hidden"> {{ 'common.opens_new_tab'|trans }}</span></a>
                {% if is_granted('IS_AUTHENTICATED') %}
                    <a class="menu__item" href="{{ logout_path() }}"><twig:ux:icon name="lucide:log-out" />{{ 'nav.logout'|trans }}</a>
                {% endif %}
            </div>
        </div>
        <p class="sidebar__hint"><kbd class="kbd">⌘K</kbd> {{ 'nav.hint_commands'|trans }}{% if project %} · <kbd class="kbd">/</kbd> {{ 'nav.hint_code'|trans }}{% endif %}</p>
    </nav>
</aside>
