{% set origins = {human: 'document.props.human'|trans, llm: 'LLM', ast: 'AST', git: 'git', api: 'API'} %}
<div{{ attributes.defaults({class: 'props-editor'}) }} data-loading="addClass(is-loading)">
    <dl class="props">
        <dt>{{ 'nav.projects'|trans }}</dt>
        <dd>
            {% for project in this.projects %}
                {% set linked = document.projects.contains(project) %}
                <button type="button" class="toggle-chip" aria-pressed="{{ linked ? 'true' : 'false' }}"
                        data-action="live#action" data-live-action-param="toggleProject" data-live-project-id-param="{{ project.id }}"
                        title="{{ (linked ? 'document.props.detach' : 'document.props.attach')|trans({name: project.name}) }}">
                    <span class="project-dot" aria-hidden="true"></span>{{ project.name }}
                </button>
            {% else %}
                <span class="row__sub">{{ 'document.no_project'|trans }}</span>
            {% endfor %}
        </dd>

        <dt><label for="document-folder">{{ 'document.props.folder'|trans }}</label></dt>
        <dd>
            {% if this.mayMoveFolder %}
                <select id="document-folder" class="select" data-model="folderId">
                    <option value="" {% if folderId is null %}selected{% endif %}>{{ 'form.connector.folder_root'|trans }}</option>
                    {% for folder in this.folders %}
                        <option value="{{ folder.id }}" {% if folderId == folder.id %}selected{% endif %}>{% if folder.depth > 0 %}{% for i in 1..folder.depth %}&nbsp;&nbsp;&nbsp;{% endfor %}{% endif %}{{ folder.name }}</option>
                    {% endfor %}
                </select>
            {% else %}
                <span>{{ document.folder ? document.folder.name : 'form.connector.folder_root'|trans }}</span>
            {% endif %}
        </dd>

        <dt>{{ 'document.props.linked_code'|trans }}</dt>
        <dd class="props__stack">
            {% for link in this.codeLinks %}
                <span class="link-chip">
                    <a class="mono" href="{{ path('file_show', {slug: link.project_slug, path: link.path}) }}" title="{{ link.project_name }} · {{ origins[link.origin] ?? link.origin }} · {{ link.confidence }}">{{ link.path|split('/')|last }}</a>
                    <span class="row__sub">{{ link.project_name }}</span>
                    <button type="button" class="icon-button" aria-label="{{ 'document.props.unlink'|trans({path: link.path}) }}"
                            data-action="live#action" data-live-action-param="unlinkFile" data-live-edge-id-param="{{ link.edge_id }}">×</button>
                </span>
            {% endfor %}

            {% if document.projects is empty %}
                <span class="row__sub">{{ 'document.props.attach_first'|trans }}</span>
            {% else %}
                <span class="link-search">
                    <input class="input input--compact" type="search" data-model="debounce(150)|fileQuery" value="{{ fileQuery }}"
                           placeholder="{{ 'document.props.link_file'|trans }}" aria-label="{{ 'document.props.link_file_label'|trans }}" autocomplete="off" spellcheck="false">
                    {% if this.fileResults is not empty %}
                        <span class="link-search__results" role="list">
                            {% for file in this.fileResults %}
                                <button type="button" role="listitem" class="link-search__item"
                                        data-action="live#action" data-live-action-param="linkFile" data-live-file-id-param="{{ file.id }}">
                                    <span class="mono">{{ file.path }}</span>
                                    <span class="row__sub">{{ file.project_name }}</span>
                                </button>
                            {% endfor %}
                        </span>
                    {% elseif fileQuery|trim is not empty %}
                        <span class="row__sub">{{ 'document.props.no_file'|trans }}</span>
                    {% endif %}
                </span>
            {% endif %}
        </dd>

        <dt>{{ 'document.props.rules'|trans }}</dt>
        <dd>
            {% for rule in this.rules %}<a class="code-chip" href="{{ path('rule_show', {slug: rule.project_slug, code: rule.code}) }}">{{ rule.code }}</a>{% else %}<span class="row__sub">{{ 'document.props.none'|trans }}</span>{% endfor %}
        </dd>

    </dl>
</div>
