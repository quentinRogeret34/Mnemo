<div{{ attributes.defaults({class: 'chat'}) }} data-loading="addClass(is-loading)">
    {% set messages = this.messages %}
    {% if messages is empty %}
        <div class="chat__empty">
            <p>{{ 'chat.empty'|trans }}</p>
            <ul class="chat__examples">
                <li>{{ 'chat.example1'|trans }}</li>
                <li>{{ 'chat.example2'|trans }}</li>
                <li>{{ 'chat.example3'|trans }}</li>
            </ul>
        </div>
    {% else %}
        <ol class="chat__messages" aria-live="polite">
            {% for item in messages %}
                <li class="chat__message chat__message--{{ item.role }}">
                    <span class="chat__author">{{ (item.role == 'user' ? 'chat.you' : 'nav.assistant')|trans }}</span>
                    {% if item.role == 'user' %}
                        <p>{{ item.content }}</p>
                    {% else %}
                        <div class="prose">{{ item.content is empty ? 'chat.no_answer'|trans : item.content|markdown_to_html }}</div>
                        {% for action in item.actions ?? [] %}
                            <a class="tag" href="{{ action.url }}"><twig:ux:icon name="lucide:check" />{{ action.label|trans(action.parameters ?? {}) }}</a>
                        {% endfor %}
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    {% endif %}

    {% if error %}<p class="form-errors" role="alert">{{ 'chat.error'|trans({error: error}) }}</p>{% endif %}

    <form class="chat__form" data-action="live#action:prevent" data-live-action-param="send">
        <label class="visually-hidden" for="chat-message">{{ 'chat.message'|trans }}</label>
        <input class="input" id="chat-message" type="text" data-model="norender|message" value="{{ message }}" maxlength="4000" placeholder="{{ 'chat.placeholder'|trans({name: project.name}) }}" autocomplete="off" autofocus required>
        <button class="button button--primary" type="submit" data-loading="addAttribute(disabled)"><twig:ux:icon name="lucide:message-circle" /><span data-loading="hide">{{ 'chat.send'|trans }}</span><span data-loading="show">{{ 'chat.thinking'|trans }}</span></button>
        {% if messages is not empty %}
            <button class="button" type="button" data-action="live#action" data-live-action-param="reset" data-loading="addAttribute(disabled)">{{ 'chat.reset'|trans }}</button>
        {% endif %}
    </form>
</div>
