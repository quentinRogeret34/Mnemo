{% set report = connector.lastReport %}
{% if connector.lastRunAt is null %}
    <span class="status"><twig:ux:icon name="lucide:circle-dashed" />jamais synchronisé</span>
{% elseif report.error %}
    <span class="status status--error" title="{{ report.error }}"><twig:ux:icon name="lucide:circle-x" />échec le {{ connector.lastRunAt|date('d/m/Y H:i') }}</span>
{% else %}
    <span class="status status--validated"><twig:ux:icon name="lucide:circle-check" />{{ report.created }} créés · {{ report.updated }} mis à jour · {{ report.unchanged }} inchangés · {{ connector.lastRunAt|date('d/m/Y H:i') }}</span>
{% endif %}
