{% extends 'base.html.twig' %}

{% set token = csrf_token('connector-' ~ connector.id) %}

{% block title %}Pull requests · {{ connector.name }}{% endblock %}

{% block crumbs %}
    <a href="{{ path('connector_index') }}">Connexions</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <a href="{{ path('connector_show', {id: connector.id}) }}">{{ connector.name }}</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__current">Pull requests</span>
{% endblock %}

{% block body %}
    <div class="view-head">
        <h1><twig:ux:icon name="lucide:git-pull-request" />Pull requests ouvertes</h1>
        {% if error is null %}<span class="view-head__meta">{{ pull_requests|length }}</span>{% endif %}
    </div>
    <p class="page__lede">Le bot relit la pull request avec le graphe du projet, puis publie son commentaire et le check <span class="mono">graphe/rules</span> sur GitHub, comme à chaque push.</p>

    {% if error %}
        <p class="form-errors block" role="alert">Lecture des pull requests impossible : {{ error }}</p>
    {% else %}
        <ul class="list">
            {% for pull_request in pull_requests %}
                <li class="row">
                    <span class="code-chip">#{{ pull_request.number }}</span>
                    <span class="row__title">
                        <a href="{{ pull_request.url }}" rel="noopener">{{ pull_request.title }}</a>
                        <span class="row__sub">{{ pull_request.author }}{{ pull_request.draft ? ' · brouillon' }} · mise à jour {{ pull_request.updated_at|date('d/m/Y H:i') }}</span>
                    </span>
                    <form method="post" action="{{ path('connector_pull_request_review', {id: connector.id, number: pull_request.number}) }}"><input type="hidden" name="_token" value="{{ token }}"><button class="button" type="submit"><twig:ux:icon name="lucide:clipboard-check" />Lancer la revue</button></form>
                </li>
            {% else %}
                <li class="block__empty">Aucune pull request ouverte.</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
