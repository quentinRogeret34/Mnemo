{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.connectors'|trans }}{% endblock %}

{% block crumbs %}<span class="crumbs__current">{{ 'nav.connectors'|trans }}</span>{% endblock %}

{% block header_actions %}
    {% if github_oauth %}<a class="button" href="{{ path('github_repositories') }}"><twig:ux:icon name="simple-icons:github" />{{ 'connector.github.title'|trans }}</a>{% endif %}
    <a class="button" href="{{ path('connector_new') }}"><twig:ux:icon name="lucide:plus" />{{ 'connector.custom'|trans }}</a>
{% endblock %}

{% block body %}
    <div class="view-head">
        <h1><twig:ux:icon name="lucide:plug" />{{ 'project.settings.connectors'|trans }}</h1>
        <span class="view-head__meta">{{ connectors|length }}</span>
    </div>

    {% if connectors is empty %}
        <twig:EmptyState :title="'connector.empty'|trans" :text="'connector.empty_text'|trans">
            <twig:block name="icon"><twig:ux:icon name="lucide:plug" /></twig:block>
            <twig:block name="actions">
                {% if github_oauth %}<a class="button button--primary" href="{{ path('github_repositories') }}"><twig:ux:icon name="simple-icons:github" />{{ 'palette.github'|trans }}</a>{% endif %}
                <a class="button" href="{{ path('connector_new') }}"><twig:ux:icon name="lucide:plus" />{{ 'connector.custom'|trans }}</a>
            </twig:block>
        </twig:EmptyState>
    {% else %}
        <ul class="list">
            {% for connector in connectors %}
                <li>
                    <a class="row" href="{{ path('connector_show', {id: connector.id}) }}">
                        <span class="code-chip">{{ connector.mode.api ? connector.mode.value|upper : connector.transport.value|upper }}</span>
                        <span class="row__title"><span>{{ connector.name }}</span><span class="row__sub">{{ connector.mode|trans }}{{ connector.project ? ' · ' ~ connector.project.name }}</span></span>
                        <span class="row__meta">{{ include('connector/_status.html.twig') }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <section class="block" aria-labelledby="presets-title">
        <div class="block__head">
            <h2 id="presets-title">{{ 'connector.presets'|trans }}</h2>
            <span class="row__sub">{{ 'connector.presets_lede'|trans }}</span>
        </div>
        <ul class="presets">
            {% set preset_icons = {
                'github-api': 'simple-icons:github',
                atlassian: 'simple-icons:atlassian',
                linear: 'lucide:kanban',
                notion: 'simple-icons:notion',
            } %}
            {% for key, preset in presets %}
                <li class="preset">
                    <div class="preset__head">
                        {{ ux_icon(preset_icons[key] ?? 'lucide:plug') }}
                        <span class="preset__name">{{ ('connector.preset.' ~ key ~ '.label')|trans }}</span>
                        <span class="tag">{{ ('connector.preset.' ~ key ~ '.auth')|trans }}</span>
                    </div>
                    <p class="preset__text">{{ ('connector.preset.' ~ key ~ '.description')|trans }}</p>
                    <div class="preset__actions">
                        {% if preset.flow == 'github_oauth' %}
                            {% if github_oauth %}
                                <a class="button button--primary" href="{{ path('github_repositories') }}"><twig:ux:icon name="simple-icons:github" />{{ 'connector.quick_connect'|trans }}</a>
                            {% else %}
                                <a class="button" href="{{ path('connector_new', {preset: key}) }}"><twig:ux:icon name="lucide:settings" />{{ 'connector.configure'|trans }}</a>
                            {% endif %}
                        {% elseif preset.flow == 'mcp_oauth' %}
                            <form method="post" action="{{ path('connector_connect', {preset: key}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('connector-connect-' ~ key) }}">
                                <button class="button button--primary" type="submit"><twig:ux:icon name="lucide:key-round" />{{ 'connector.quick_connect'|trans }}</button>
                            </form>
                        {% elseif preset.flow == 'notion_token' %}
                            <button class="button button--primary" type="button" commandfor="notion-connect" command="show-modal"><twig:ux:icon name="lucide:plug" />{{ 'connector.quick_connect'|trans }}</button>
                        {% else %}
                            <a class="button" href="{{ path('connector_new', {preset: key}) }}"><twig:ux:icon name="lucide:settings" />{{ 'connector.configure'|trans }}</a>
                        {% endif %}
                        <a class="button button--ghost" href="{{ path('connector_new', {preset: key}) }}" title="{{ 'connector.advanced_config'|trans }}"><twig:ux:icon name="lucide:sliders-horizontal" /></a>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </section>

    <section class="block" aria-labelledby="llm-title">
        <div class="block__head"><h2 id="llm-title">{{ 'nav.llm'|trans }}</h2></div>
        <dl class="props props--flat">
            <dt>Chat</dt><dd><span class="mono">{{ llm.chatPlatform }} / {{ llm.chatModel }}</span></dd>
            <dt>Embeddings</dt><dd><span class="mono">{{ llm.embeddingPlatform }} / {{ llm.embeddingModel }}</span></dd>
            <dt>{{ 'form.llm.api_key'|trans }}</dt>
            <dd>{% if llm.isConfigured('openrouter') %}<span class="status status--validated">{{ 'connector.key_set'|trans }}</span>{% else %}<span class="status">{{ 'connector.key_missing'|trans }}</span>{% endif %}</dd>
        </dl>
        <p class="row__sub">{{ 'connector.llm_help'|trans({link: '<a class="link" href="' ~ path('llm_settings') ~ '">' ~ 'nav.llm'|trans|e ~ '</a>', env: '<code>OPENROUTER_API_KEY</code>, <code>LLM_MODEL</code>, <code>EMBEDDING_MODEL</code>', command: '<code>bin/console app:llm:check</code>'})|raw }}</p>
    </section>

    <dialog class="dialog" id="notion-connect" closedby="any" aria-labelledby="notion-connect-title">
        <h2 class="dialog__title" id="notion-connect-title">{{ 'connector.notion_dialog.title'|trans }}</h2>
        <p class="dialog__text">{{ 'connector.notion_dialog.text'|trans }}</p>
        <form class="form-stack" method="post" action="{{ path('connector_connect', {preset: 'notion'}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('connector-connect-notion') }}">
            <div>
                <label for="notion-name">{{ 'form.project.name'|trans }}</label>
                <input class="input" id="notion-name" type="text" name="name" value="Notion" maxlength="120" required>
            </div>
            <div>
                <label for="notion-token">{{ 'connector.notion_dialog.token'|trans }}</label>
                <input class="input mono" id="notion-token" type="password" name="token" placeholder="ntn_..." autocomplete="off" required autofocus>
                <p class="help-text">{{ 'connector.notion_dialog.token_help'|trans }}</p>
            </div>
            {% if projects is not empty %}
                <div>
                    <label for="notion-project">{{ 'memory.index.project'|trans }}</label>
                    <select class="select" id="notion-project" name="project">
                        <option value="0">{{ 'connector.show.none'|trans }}</option>
                        {% for item in projects %}<option value="{{ item.id }}">{{ item.name }}</option>{% endfor %}
                    </select>
                </div>
            {% endif %}
            {% if folders is not empty %}
                <div>
                    <label for="notion-folder">{{ 'document.props.folder'|trans }}</label>
                    <select class="select" id="notion-folder" name="folder">
                        <option value="0">{{ 'connector.show.root_folder'|trans }}</option>
                        {% for item in folders %}<option value="{{ item.id }}">{{ item.name }}</option>{% endfor %}
                    </select>
                </div>
            {% endif %}
            <div class="dialog__actions">
                <button class="button" type="button" commandfor="notion-connect" command="close">{{ 'common.cancel'|trans }}</button>
                <button class="button button--primary" type="submit"><twig:ux:icon name="lucide:plug" />{{ 'connector.quick_connect'|trans }}</button>
            </div>
        </form>
    </dialog>
{% endblock %}
