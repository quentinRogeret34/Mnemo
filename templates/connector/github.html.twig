{% extends 'base.html.twig' %}

{% set token = csrf_token('github-repositories') %}

{% block title %}{{ 'connector.github.title'|trans }} · {{ 'nav.connectors'|trans }}{% endblock %}

{% set back = selected ? {project: selected.slug} : {} %}

{% block crumbs %}
    {% if selected %}
        <a href="{{ path('project_settings', {slug: selected.slug}) }}">{{ selected.name }}</a>
        <span class="crumbs__sep" aria-hidden="true">/</span>
    {% elseif not scoped %}
        <a href="{{ path('connector_index') }}">{{ 'nav.connectors'|trans }}</a>
        <span class="crumbs__sep" aria-hidden="true">/</span>
    {% endif %}
    <span class="crumbs__current">{{ 'connector.github.title'|trans }}</span>
{% endblock %}

{% block body %}
    <div class="view-head">
        <h1><twig:ux:icon name="simple-icons:github" />{{ 'connector.github.title'|trans }}</h1>
        {% if repositories is not null %}<span class="view-head__meta">{{ repositories|length }}</span>{% endif %}
    </div>
    <p class="page__lede">{{ 'connector.github.lede'|trans }}</p>

    {% if repositories is null %}
        <form method="post" action="{{ path('github_repositories_oauth') }}">
            <input type="hidden" name="_token" value="{{ token }}">
            <input type="hidden" name="project" value="{{ selected ? selected.slug }}">
            <button class="button button--primary" type="submit"><twig:ux:icon name="simple-icons:github" />{{ 'connector.github.connect'|trans }}</button>
            <span class="row__sub">{{ 'connector.github.scope'|trans }}</span>
        </form>
    {% else %}
        <form class="key-form" method="post" action="{{ path('github_repositories_connect', back) }}">
            <input type="hidden" name="_token" value="{{ token }}">
            <label for="github-project">{{ 'memory.index.project'|trans }}</label>
            <select class="select" id="github-project" name="project" required>
                <option value="">{{ 'connector.github.choose_project'|trans }}</option>
                {% if may_create %}<option value="new" {{ not selected and projects is empty ? 'selected' }}>{{ 'connector.github.new_per_repository'|trans }}</option>{% endif %}
                {% if projects is not empty %}
                    <optgroup label="{{ 'connector.github.existing'|trans }}">
                        {% for project in projects %}<option value="{{ project.id }}" {{ selected and selected.id == project.id ? 'selected' }}>{{ project.name }}</option>{% endfor %}
                    </optgroup>
                {% endif %}
            </select>
            {% if may_create %}<p class="row__sub">{{ 'connector.github.new_per_repository_help'|trans }}</p>{% endif %}
            <ul class="list">
                {% for repository in repositories %}
                    {% set already = repository.full_name|lower in connected %}
                    <li class="row">
                        <label class="key-form__check">
                            <input type="checkbox" name="repositories[]" value="{{ repository.full_name }}" {{ already ? 'disabled' }}>
                            <span class="mono">{{ repository.full_name }}</span>
                        </label>
                        <span class="row__sub">{{ (repository.private ? 'connector.github.private' : 'connector.github.public')|trans }}{{ already ? ' · ' ~ 'connector.github.already'|trans }}{{ repository.description ? ' · ' ~ repository.description }}</span>
                    </li>
                {% else %}
                    <li class="block__empty">{{ 'connector.github.none'|trans }}</li>
                {% endfor %}
            </ul>
            <button class="button button--primary" type="submit"><twig:ux:icon name="lucide:plug" />{{ 'connector.github.submit'|trans }}</button>
        </form>
    {% endif %}
{% endblock %}
