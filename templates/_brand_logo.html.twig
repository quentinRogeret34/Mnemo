{# Colored brand SVG marks for external integrations & OAuth providers.
   Accepts:
     - brand: string ('github', 'github-api', 'gitlab', 'google', 'atlassian', 'jira', 'confluence', 'linear', 'notion', 'slack', 'discord', 'teams', 'generic')
     - connector: optional App\Entity\Connector (auto-detects brand when brand is omitted)
     - badge: bool (false by default; wraps the SVG in a soft-tinted .brand-badge chip)
     - size: 'sm' | 'md' | 'lg' (default 'sm')
     - class: extra CSS classes on the SVG
#}
{% set resolved = brand ?? '' %}
{% if resolved is empty and connector is defined and connector is not null %}
    {% set hay = (connector.mode.value ~ ' ' ~ connector.endpoint ~ ' ' ~ connector.name)|lower %}
    {% if connector.mode.value == 'github' or 'github' in hay %}
        {% set resolved = 'github' %}
    {% elseif connector.mode.value == 'gitlab' or 'gitlab' in hay %}
        {% set resolved = 'gitlab' %}
    {% elseif connector.mode.value == 'notion' or 'notion' in hay %}
        {% set resolved = 'notion' %}
    {% elseif 'confluence' in hay and 'jira' not in hay %}
        {% set resolved = 'confluence' %}
    {% elseif 'jira' in hay and 'confluence' not in hay %}
        {% set resolved = 'jira' %}
    {% elseif 'atlassian' in hay or 'jira' in hay %}
        {% set resolved = 'atlassian' %}
    {% elseif 'linear' in hay %}
        {% set resolved = 'linear' %}
    {% elseif 'slack' in hay %}
        {% set resolved = 'slack' %}
    {% elseif 'discord' in hay %}
        {% set resolved = 'discord' %}
    {% elseif 'teams' in hay or 'office.com' in hay or 'microsoft' in hay %}
        {% set resolved = 'teams' %}
    {% elseif 'google' in hay %}
        {% set resolved = 'google' %}
    {% else %}
        {% set resolved = 'generic' %}
    {% endif %}
{% endif %}
{% set resolved = resolved|lower %}
{% if resolved == 'github-api' %}{% set resolved = 'github' %}{% endif %}
{% if resolved == 'microsoft-teams' %}{% set resolved = 'teams' %}{% endif %}
{% if resolved is empty %}{% set resolved = 'generic' %}{% endif %}

{% set svg_class = ('icon brand-logo brand-logo--' ~ resolved ~ (class is defined and class ? ' ' ~ class : ''))|trim %}
{% set use_badge = badge ?? false %}
{% set badge_size = size ?? 'sm' %}

{% if use_badge %}<span class="brand-badge brand-badge--{{ resolved }} brand-badge--{{ badge_size }}" aria-hidden="true">{% endif %}
{% if resolved == 'github' %}
