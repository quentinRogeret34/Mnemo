{% extends 'base.html.twig' %}

{% block title %}{{ 'project.new'|trans }}{% endblock %}

{% block crumbs %}
    <a href="{{ path('project_index') }}">{{ 'nav.projects'|trans }}</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__current">{{ 'project.new'|trans }}</span>
{% endblock %}

{% block body %}
    <div class="view-head">
        <h1><twig:ux:icon name="lucide:plus" />{{ 'project.new'|trans }}</h1>
    </div>
    <p class="page__lede">{{ 'project.new_lede'|trans }}</p>
    <button class="button button--primary" type="button" commandfor="project-new" command="show-modal"><twig:ux:icon name="lucide:plus" />{{ 'project.open_form'|trans }}</button>
{% endblock %}
