{% extends 'base.html.twig' %}

{% block crumbs %}<span class="crumbs__current">{{ 'nav.projects'|trans }}</span>{% endblock %}

{% block header_actions %}
    {% if may_create %}<button class="button button--primary" type="button" commandfor="project-new" command="show-modal"><twig:ux:icon name="lucide:plus" />{{ 'project.new'|trans }}</button>{% endif %}
{% endblock %}

{% block body %}
    <div class="view-head">
        <h1><twig:ux:icon name="lucide:layout-grid" />{{ 'nav.projects'|trans }}</h1>
        <span class="view-head__meta">{{ projects|length }}</span>
    </div>

    {% if archived or archived_count > 0 %}
        <nav class="tabs" aria-label="{{ 'project.index.filter_state'|trans }}">
            <a href="{{ path('project_index') }}" {% if not archived %}aria-current="page"{% endif %}>{{ 'project.index.active'|trans }}</a>
            <a href="{{ path('project_index', {archived: 1}) }}" {% if archived %}aria-current="page"{% endif %}>{{ 'project.index.archived'|trans }}</a>
        </nav>
    {% endif %}

    {% if projects is empty and archived %}
        <twig:EmptyState :title="'project.index.empty_archived'|trans" :text="'project.index.empty_archived_text'|trans">
            <twig:block name="icon"><twig:ux:icon name="lucide:archive" /></twig:block>
            <twig:block name="actions"><a class="button" href="{{ path('project_index') }}">{{ 'project.index.see_active'|trans }}</a></twig:block>
        </twig:EmptyState>
    {% elseif projects is empty %}
        <twig:EmptyState :title="'nav.no_project'|trans" :text="'project.index.empty_text'|trans">
            <twig:block name="icon"><twig:ux:icon name="lucide:folder-plus" /></twig:block>
            <twig:block name="actions">
                {% if may_create %}<button class="button button--primary" type="button" commandfor="project-new" command="show-modal"><twig:ux:icon name="lucide:plus" />{{ 'project.new'|trans }}</button>{% endif %}
                {% if github_oauth %}<a class="button" href="{{ path('github_repositories') }}"><twig:ux:icon name="simple-icons:github" />{{ 'palette.github'|trans }}</a>{% endif %}
            </twig:block>
            <details class="empty-state__more">
                <summary>{{ 'common.command_line'|trans }}</summary>
                <p>{{ 'project.index.cli_lede'|trans }}</p>
                <pre><code>graphify extract &lt;{{ 'project.index.cli_repository'|trans }}&gt; --code-only --out var/graphify/&lt;slug&gt;
bin/console app:project:create &lt;slug&gt; "&lt;{{ 'project.index.cli_name'|trans }}&gt;" &lt;{{ 'project.index.cli_repository'|trans }}&gt;
bin/console app:ingest:code &lt;slug&gt; var/graphify/&lt;slug&gt;/graphify-out/graph.json --no-debug</code></pre>
            </details>
        </twig:EmptyState>
    {% else %}
        <ul class="project-list">
            {% for project in projects %}
                {% set k = project.knowledge %}
                <li class="project-card">
                    <details class="project-card__details">
                        <summary class="row project-card__summary">
                            <twig:ux:icon name="lucide:chevron-right" class="icon project-card__chevron" />
                            <span class="row__title"><span>{{ project.name }}</span><span class="row__sub">{{ project.slug }}</span></span>
                            <span class="row__meta">
                                <span class="num">{{ 'project.index.files'|trans({count: project.files}) }}</span>
                                <span class="num">{{ 'project.index.symbols'|trans({count: project.symbols}) }}</span>
                                <span class="num">{{ 'project.index.edges'|trans({count: project.edges}) }}</span>
                                <span class="mono">{{ project.ref ? project.ref|slice(0, 7) : '-' }}</span>
                            </span>
                        </summary>
                        <div class="project-card__body">
                            <p class="row__sub mono">{{ project.repository_path }}</p>
                            <div class="project-card__stats">
                                <a class="stat" href="{{ path('project_show', {slug: project.slug}) }}"><span class="stat__value">{{ k.documents }}</span><span class="stat__label">{{ 'nav.documents'|trans }}</span></a>
                                <a class="stat" href="{{ path('rule_index', {slug: project.slug}) }}"><span class="stat__value">{{ k.rules }}</span><span class="stat__label">{{ 'nav.rules'|trans }}{% if k.rules_to_review > 0 %} · {{ 'nav.count_to_review'|trans({count: k.rules_to_review}) }}{% endif %}</span></a>
                                <a class="stat" href="{{ path('memory_index', {project: project.slug}) }}"><span class="stat__value">{{ k.memories }}</span><span class="stat__label">{{ 'nav.memories'|trans }}</span></a>
                                <a class="stat" href="{{ path('project_code', {slug: project.slug}) }}"><span class="stat__value">{{ k.files|format_number }}</span><span class="stat__label">{{ 'project.index.code_files'|trans }}</span></a>
                                <a class="stat" href="{{ path('proposal_index', {project: project.slug}) }}"><span class="stat__value">{{ project.pending }}</span><span class="stat__label">{{ 'nav.to_review'|trans }}</span></a>
                            </div>
                        </div>
                    </details>
                    <a class="button project-card__open" href="{{ path('project_show', {slug: project.slug}) }}">{{ 'common.open'|trans }}</a>
                    <div class="menu menu--end" data-controller="menu">
                        <button class="button menu__kebab" type="button" aria-label="{{ 'project.index.actions_for'|trans({name: project.name}) }}" aria-expanded="false" commandfor="project-actions-{{ project.id }}" command="toggle-popover" data-menu-target="trigger">
                            <twig:ux:icon name="lucide:ellipsis" />
                        </button>
                        <div class="menu__panel" id="project-actions-{{ project.id }}" popover data-menu-target="panel" data-action="beforetoggle->menu#place toggle->menu#sync">
                            <a class="menu__item" href="{{ path('dashboard', {project: project.slug}) }}">{{ 'nav.dashboard'|trans }}</a>
                            <a class="menu__item" href="{{ path('project_show', {slug: project.slug}) }}">{{ 'nav.documents'|trans }}</a>
                            <a class="menu__item" href="{{ path('rule_index', {slug: project.slug}) }}">{{ 'nav.rules'|trans }}</a>
                            <a class="menu__item" href="{{ path('memory_index', {project: project.slug}) }}">{{ 'nav.memories'|trans }}</a>
                            <a class="menu__item" href="{{ path('memory_graph', {project: project.slug}) }}">{{ 'nav.memory_graph'|trans }}</a>
                            <a class="menu__item" href="{{ path('project_code', {slug: project.slug}) }}">{{ 'nav.code'|trans }}</a>
                            <a class="menu__item" href="{{ path('garden_show', {slug: project.slug}) }}">{{ 'nav.garden'|trans }}</a>
                            <a class="menu__item" href="{{ path('proposal_index', {project: project.slug}) }}">{{ 'nav.to_review'|trans }}{% if project.pending > 0 %} ({{ project.pending }}){% endif %}</a>
                            <hr class="menu__rule">
                            <a class="menu__item" href="{{ path('project_settings', {slug: project.slug}) }}"><twig:ux:icon name="lucide:settings" />{{ 'nav.settings'|trans }}</a>
                            <form method="post" action="{{ path(archived ? 'project_restore' : 'project_archive', {slug: project.slug}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('project-' ~ project.id) }}">
                                {% if archived %}
                                    <button class="menu__item" type="submit"><twig:ux:icon name="lucide:archive-restore" />{{ 'project.restore'|trans }}</button>
                                {% else %}
                                    <button class="menu__item" type="submit" data-confirm="{{ 'project.archive_confirm'|trans({name: project.name}) }}" data-confirm-label="{{ 'project.archive'|trans }}"><twig:ux:icon name="lucide:archive" />{{ 'project.archive'|trans }}</button>
                                {% endif %}
                            </form>
                            <a class="menu__item menu__item--danger" href="{{ path('project_settings', {slug: project.slug}) }}#danger"><twig:ux:icon name="lucide:trash-2" />{{ 'common.delete'|trans }}</a>
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
