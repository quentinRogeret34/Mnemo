{% if field|length > 0 %}
    <div role="group" aria-labelledby="{{ field.vars.id }}-label">
        <span class="form-stack__label" id="{{ field.vars.id }}-label">{{ field.vars.label|trans }}</span>
        <div class="choices">
            {% for choice in field %}
                <label class="key-form__check">{{ form_widget(choice) }}{{ choice.vars.label }}</label>
            {% endfor %}
        </div>
        <p class="help-text">{{ 'project.groups_help'|trans }}</p>
    </div>
{% else %}
    {% do field.setRendered() %}
{% endif %}
