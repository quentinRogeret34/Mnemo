{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.assistant'|trans }} · {{ project.name }}{% endblock %}

{% block crumbs %}
    <a href="{{ path('project_show', {slug: project.slug}) }}">{{ project.name }}</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__current">{{ 'nav.assistant'|trans }}</span>
{% endblock %}

{% block body %}
    <twig:ProjectChat :project="project" />
{% endblock %}
