{
  "mnemo": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./scripts/mnemo.py session-start",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "read_file|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/mnemo.py file-read",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./scripts/mnemo.py pre-invocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./scripts/mnemo.py capture",
        "timeout": 10
      }
    ]
  }
}
